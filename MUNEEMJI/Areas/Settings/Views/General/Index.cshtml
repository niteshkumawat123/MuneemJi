@{
    ViewData["Title"] = "General Settings";
    Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";
}

<style>
    .settings-container {
        padding: 20px;
        background-color: #fff;
        max-width: 1200px;
    }

    .settings-row {
        display: flex;
        gap: 30px;
        margin-bottom: 30px;
    }

    .settings-column {
        flex: 1;
    }

    .settings-section {
        margin-bottom: 30px;
    }

    .section-title {
        font-size: 16px;
        font-weight: 600;
        color: #333;
        margin-bottom: 15px;
        padding-bottom: 8px;
        border-bottom: 1px solid #e0e0e0;
    }

    .form-group {
        margin-bottom: 15px;
        display: flex;
        align-items: center;
    }

        .form-group label {
            font-size: 14px;
            color: #555;
            margin-right: 10px;
            min-width: 120px;
        }

    .form-control {
        padding: 8px 12px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
        width: 200px;
    }

        .form-control:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 0 2px rgba(0,123,255,.25);
        }

    .checkbox-group {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
    }

        .checkbox-group input[type="checkbox"] {
            margin-right: 8px;
            transform: scale(1.2);
        }

        .checkbox-group label {
            font-size: 14px;
            color: #555;
            margin: 0;
            cursor: pointer;
            min-width: auto;
        }

    .info-icon {
        margin-left: 5px;
        color: #999;
        cursor: help;
        font-size: 12px;
        background: #f0f0f0;
        border-radius: 50%;
        width: 16px;
        height: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .radio-group {
        display: flex;
        align-items: center;
        padding: 12px;
        border: 2px solid #007bff;
        border-radius: 6px;
        background-color: #f8f9ff;
        margin-bottom: 15px;
    }

        .radio-group input[type="radio"] {
            margin-right: 10px;
        }

        .radio-group label {
            font-size: 14px;
            color: #333;
            font-weight: 500;
            margin: 0;
        }

    .default-badge {
        background-color: #28a745;
        color: white;
        padding: 2px 8px;
        border-radius: 3px;
        font-size: 11px;
        margin-left: 10px;
    }

    .edit-icon {
        margin-left: 10px;
        color: #007bff;
        cursor: pointer;
        font-size: 14px;
    }

    .amount-group {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .amount-input {
        width: 60px;
        text-align: center;
    }

    .decimal-input {
        width: 100px;
    }

    .description-text {
        font-size: 12px;
        color: #666;
        margin-top: 8px;
        line-height: 1.4;
    }

    .zoom-slider {
        width: 300px;
        margin: 10px 0;
    }

    .zoom-labels {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        color: #666;
        margin-bottom: 10px;
    }

    .apply-btn {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 6px 16px;
        border-radius: 4px;
        font-size: 12px;
        cursor: pointer;
        margin-left: 10px;
    }

        .apply-btn:hover {
            background-color: #0056b3;
        }

    .close-btn {
        position: absolute;
        top: 20px;
        right: 20px;
        background: #666;
        color: white;
        border: none;
        border-radius: 50%;
        width: 24px;
        height: 24px;
        cursor: pointer;
        font-size: 14px;
    }

    .activate-windows {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background: rgba(0,0,0,0.8);
        color: white;
        padding: 10px 15px;
        border-radius: 6px;
        font-size: 12px;
        text-align: center;
    }

    .activate-title {
        font-weight: 600;
        margin-bottom: 4px;
    }

    .nested-checkbox {
        margin-left: 20px;
        margin-top: 8px;
    }

    .stock-transfer-description {
        font-size: 12px;
        color: #666;
        line-height: 1.4;
        margin-bottom: 15px;
    }

    .danger-icon {
        color: #dc3545;
        margin-left: 5px;
        font-size: 14px;
    }
</style>

<div class="settings-container">
    <button class="close-btn">×</button>

    <div class="settings-row">
        <!-- Left Column -->
        <div class="settings-column">
            <!-- Application Section -->
            <div class="settings-section">
                <h3 class="section-title">Application</h3>

                <div class="checkbox-group">
                    <input type="checkbox" id="enablePasscode">
                    <label for="enablePasscode">Enable Passcode</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="form-group">
                    <label>Business Currency</label>
                    <span class="info-icon">i</span>
                    <select class="form-control" style="width: 80px;">
                        <option value="INR">₹</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Amount</label>
                    <span class="info-icon">i</span>
                    <div class="amount-group">
                        <input type="number" class="form-control amount-input" value="2">
                        <span style="color: #007bff; cursor: pointer;">⚙</span>
                        <span style="margin: 0 10px;">e.g. 0.00</span>
                    </div>
                </div>
                <div style="font-size: 11px; color: #666; margin-left: 130px;">(upto Decimal Places)</div>

                <div class="checkbox-group" style="margin-top: 15px;">
                    <input type="checkbox" id="gstinNumber" checked>
                    <label for="gstinNumber">GSTIN Number</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="stopSale">
                    <label for="stopSale">Stop Sale on Negative Stock</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="blockNewItems">
                    <label for="blockNewItems">Block New Items from Txn Form</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="blockNewParties">
                    <label for="blockNewParties">Block New Parties from Txn Form</label>
                    <span class="info-icon">i</span>
                </div>
            </div>

            <!-- More Transactions Section -->
            <div class="settings-section">
                <h3 class="section-title">More Transactions</h3>

                <div class="checkbox-group">
                    <input type="checkbox" id="estimate" checked>
                    <label for="estimate">Estimate/Quotation</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="proforma" checked>
                    <label for="proforma">Proforma Invoice</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="saleOrder" checked>
                    <label for="saleOrder">Sale/Purchase Order</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="otherIncome">
                    <label for="otherIncome">Other Income</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="fixedAssets">
                    <label for="fixedAssets">Fixed Assets (FA)</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="deliveryChallan" checked>
                    <label for="deliveryChallan">Delivery Challan</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="nested-checkbox">
                    <div class="checkbox-group">
                        <input type="checkbox" id="goodsReturn" checked>
                        <label for="goodsReturn">Goods return on <strong>Delivery Challan</strong></label>
                        <span class="info-icon">i</span>
                    </div>

                    <div class="checkbox-group">
                        <input type="checkbox" id="printAmount" checked>
                        <label for="printAmount">Print amount in <strong>Delivery Challan</strong></label>
                        <span class="info-icon">i</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Middle Column -->
        <div class="settings-column">
            <!-- Multi Firm Section -->
            <div class="settings-section">
                <div class="form-group" style="margin-bottom: 20px;">
                    <input type="checkbox" id="multiFirm" style="margin-right: 8px;">
                    <label for="multiFirm" style="font-size: 16px; font-weight: 600; min-width: auto;">Multi Firm</label>
                </div>

                <div class="radio-group">
                    <input type="radio" id="orasoftUnique" name="firmType" checked>
                    <label for="orasoftUnique">ORASOFT UNIQUE PVT. LTD.</label>
                    <span class="default-badge">DEFAULT</span>
                    <span class="edit-icon">✏</span>
                </div>
            </div>

            <!-- Stock Transfer Section -->
            <div class="settings-section">
                <h3 class="section-title">Stock Transfer Between Godowns</h3>

                <div class="stock-transfer-description">
                    Manage all your stores/godowns and transfer stock seamlessly between them. Using this feature, you can transfer stock between stores/godowns and manage your inventory more efficiently.
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="godownManagement" checked>
                    <label for="godownManagement">Godown management & Stock transfer</label>
                    <span class="info-icon">i</span>
                    <span class="danger-icon">🔍</span>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="settings-column">
            <!-- Backup & History Section -->
            <div class="settings-section">
                <h3 class="section-title">Backup & History</h3>

                <div class="checkbox-group">
                    <input type="checkbox" id="autoBackup">
                    <label for="autoBackup">Auto Backup</label>
                    <span class="info-icon">i</span>
                </div>

                <div style="font-size: 14px; color: #555; margin: 15px 0;">
                    <strong>Last Backup</strong> 29/12/2024 | 01:12 AM
                    <span class="info-icon">i</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="auditTrail" checked>
                    <label for="auditTrail">Audit Trail</label>
                    <span class="info-icon">i</span>
                </div>
            </div>

            <!-- Customize Your View Section -->
            <div class="settings-section">
                <h3 class="section-title">Customize Your View</h3>

                <div style="font-size: 14px; color: #333; font-weight: 600; margin-bottom: 10px;">
                    Choose Your Screen Zoom/Scale
                </div>

                <div class="description-text" style="margin-bottom: 15px;">
                    You can use this setting to resize the Vyapar screen, making it larger or smaller to fit your preferences.
                </div>

                <div class="zoom-labels">
                    <span>70%</span>
                    <span>80%</span>
                    <span>90%</span>
                    <span>100%</span>
                    <span>110%</span>
                    <span>115%</span>
                    <span>120%</span>
                    <span>130%</span>
                </div>

                <input type="range" class="zoom-slider" min="70" max="130" value="100" step="5">
                <button class="apply-btn">Apply</button>
            </div>
        </div>
    </div>

    <!-- Activate Windows notification -->
    <div class="activate-windows">
        <div class="activate-title">Activate Windows</div>
        <div>Go to Settings to activate Windows.</div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Handle nested checkboxes for Delivery Challan
        const deliveryCheckbox = document.getElementById('deliveryChallan');
        const nestedCheckboxes = document.querySelectorAll('.nested-checkbox input[type="checkbox"]');

        deliveryCheckbox.addEventListener('change', function() {
            nestedCheckboxes.forEach(checkbox => {
                checkbox.disabled = !this.checked;
                if (!this.checked) {
                    checkbox.checked = false;
                }
            });
        });

        // Handle zoom slider
        const zoomSlider = document.querySelector('.zoom-slider');
        const applyBtn = document.querySelector('.apply-btn');

        applyBtn.addEventListener('click', function() {
            const zoomValue = zoomSlider.value;
            // Apply zoom logic here
            alert(`Applied zoom: ${zoomValue}%`);
        });

        // Close button functionality
        document.querySelector('.close-btn').addEventListener('click', function() {
            // Close modal or navigate back
            window.history.back();
        });
    });
</script>