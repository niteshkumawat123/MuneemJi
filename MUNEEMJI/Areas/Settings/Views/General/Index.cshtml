@{
    ViewData["Title"] = "General Settings";
    Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";
}

<style>
    .settings-container {
        padding: 20px;
        background-color: #fff;
        max-width: 1200px;
    }

    .settings-row {
        display: flex;
        gap: 30px;
        margin-bottom: 30px;
    }

    .settings-column {
        flex: 1;
    }

    .settings-section {
        margin-bottom: 30px;
    }

    .section-title {
        font-size: 16px;
        font-weight: 600;
        color: #333;
        margin-bottom: 15px;
        padding-bottom: 8px;
        border-bottom: 1px solid #e0e0e0;
    }

    .form-group {
        margin-bottom: 15px;
        display: flex;
        align-items: center;
    }

        .form-group label {
            font-size: 14px;
            color: #555;
            margin-right: 10px;
            min-width: 120px;
        }

    .form-control {
        padding: 8px 12px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
        width: 200px;
    }

        .form-control:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 0 2px rgba(0,123,255,.25);
        }

    .checkbox-group {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
    }

        .checkbox-group input[type="checkbox"] {
            margin-right: 8px;
            transform: scale(1.2);
        }

        .checkbox-group label {
            font-size: 14px;
            color: #555;
            margin: 0;
            cursor: pointer;
            min-width: auto;
        }

    .info-icon {
        margin-left: 5px;
        color: #999;
        cursor: help;
        font-size: 12px;
        background: #f0f0f0;
        border-radius: 50%;
        width: 16px;
        height: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .radio-group {
        display: flex;
        align-items: center;
        padding: 12px;
        border: 2px solid #007bff;
        border-radius: 6px;
        background-color: #f8f9ff;
        margin-bottom: 15px;
    }

        .radio-group input[type="radio"] {
            margin-right: 10px;
        }

        .radio-group label {
            font-size: 14px;
            color: #333;
            font-weight: 500;
            margin: 0;
        }

    .default-badge {
        background-color: #28a745;
        color: white;
        padding: 2px 8px;
        border-radius: 3px;
        font-size: 11px;
        margin-left: 10px;
    }

    .edit-icon {
        margin-left: 10px;
        color: #007bff;
        cursor: pointer;
        font-size: 14px;
    }

    .amount-group {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .amount-input {
        width: 60px;
        text-align: center;
    }

    .decimal-input {
        width: 100px;
    }

    .description-text {
        font-size: 12px;
        color: #666;
        margin-top: 8px;
        line-height: 1.4;
    }

    .zoom-slider {
        width: 374px;
        margin: 10px 0;
    }

    .zoom-labels {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        color: #666;
        margin-bottom: 10px;
    }

    .apply-btn {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 6px 16px;
        border-radius: 4px;
        font-size: 12px;
        cursor: pointer;
        margin-left: 10px;
    }

        .apply-btn:hover {
            background-color: #0056b3;
        }

    .close-btn {
        position: absolute;
        top: 20px;
        right: 20px;
        background: #666;
        color: white;
        border: none;
        border-radius: 50%;
        width: 24px;
        height: 24px;
        cursor: pointer;
        font-size: 14px;
    }

    .activate-windows {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background: rgba(0,0,0,0.8);
        color: white;
        padding: 10px 15px;
        border-radius: 6px;
        font-size: 12px;
        text-align: center;
    }

    .activate-title {
        font-weight: 600;
        margin-bottom: 4px;
    }

    .nested-checkbox {
        margin-left: 20px;
        margin-top: 8px;
    }

    .stock-transfer-description {
        font-size: 12px;
        color: #666;
        line-height: 1.4;
        margin-bottom: 15px;
    }

    .danger-icon {
        color: #dc3545;
        margin-left: 5px;
        font-size: 14px;
    }

    .btn-save {
        background-color: #28a745;
        border-color: #28a745;
        color: white;
        padding: 8px 20px;
        border-radius: 4px;
        font-size: 14px;
        border: none;
        cursor: pointer;
    }

        .btn-save:hover {
            background-color: #218838;
            border-color: #1e7e34;
        }
</style>

<div class="settings-container">
    <input type="hidden" id="settingsId" value="@Model.Id" />

    <div style="display: flex; justify-content: flex-end;">
        <button type="button" class="btn-close btn-close-custom"
                style="background-color:#007bff;border: 2px solid #2c7be5;border-radius: 15%;
               height:10px;padding-bottom: 13px;padding-top: 11px;padding-left: 6px;
               padding-right: 6px;"
                aria-label="Close"
                onclick="window.location.href = new URLSearchParams(window.location.search).get('returnUrl') || window.history.back();">
        </button>
    </div>

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
        <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="fas fa-check-circle me-2"></i>
                    General Settings saved successfully!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <div class="settings-row">
        <!-- Left Column -->
        <div class="settings-column">
            <!-- Application Section -->
            <div class="settings-section">
                <h3 class="section-title">Application</h3>

                <div class="form-group">
                    <label>Business Currency</label>
                    <span class="info-icon">i</span>
                    <select class="form-control" style="width: 80px;">
                        <option value="INR">₹</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Amount</label>
                    <span class="info-icon">i</span>
                    <div class="amount-group">
                        <input type="number" class="form-control amount-input" value="2">
                        <span style="color: #007bff; cursor: pointer;">⚙</span>
                        <span style="margin: 0 10px;">e.g. 0.00</span>
                    </div>
                </div>
                <div style="font-size: 11px; color: #666; margin-left: 130px;">(upto Decimal Places)</div>

                <div class="checkbox-group" style="margin-top: 15px;">
                    <input type="checkbox" id="gstinNumber" @(Model.GstinNumber ? "checked" : "")>
                    <label for="gstinNumber">GSTIN Number</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="stopSale" @(Model.StopSaleOnNegativeStock ? "checked" : "")>
                    <label for="stopSale">Stop Sale on Negative Stock</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="blockNewItems" @(Model.BlockNewItemsFromTxn ? "checked" : "")>
                    <label for="blockNewItems">Block New Items from Txn Form</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="blockNewParties" @(Model.BlockNewPartiesFromTxn ? "checked" : "")>
                    <label for="blockNewParties">Block New Parties from Txn Form</label>
                    <span class="info-icon">i</span>
                </div>
            </div>

            <!-- More Transactions Section -->
            <div class="settings-section">
                <h3 class="section-title">More Transactions</h3>

                <div class="checkbox-group">
                    <input type="checkbox" id="estimate" @(Model.EstimateQuotation ? "checked" : "")>
                    <label for="estimate">Estimate/Quotation</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="proforma" @(Model.ProformaInvoice ? "checked" : "")>
                    <label for="proforma">Proforma Invoice</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="saleOrder" @(Model.SalePurchaseOrder ? "checked" : "")>
                    <label for="saleOrder">Sale/Purchase Order</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="otherIncome" @(Model.OtherIncome ? "checked" : "")>
                    <label for="otherIncome">Other Income</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="fixedAssets" @(Model.FixedAssets ? "checked" : "")>
                    <label for="fixedAssets">Fixed Assets (FA)</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="deliveryChallan" @(Model.DeliveryChallan ? "checked" : "")>
                    <label for="deliveryChallan">Delivery Challan</label>
                    <span class="info-icon">i</span>
                </div>

                <div class="nested-checkbox">
                    <div class="checkbox-group">
                        <input type="checkbox" id="goodsReturn" @(Model.GoodsReturnOnDeliveryChallan ? "checked" : "")>
                        <label for="goodsReturn">Goods return on <strong>Delivery Challan</strong></label>
                        <span class="info-icon">i</span>
                    </div>

                    <div class="checkbox-group">
                        <input type="checkbox" id="printAmount" @(Model.PrintAmountInDeliveryChallan ? "checked" : "")>
                        <label for="printAmount">Print amount in <strong>Delivery Challan</strong></label>
                        <span class="info-icon">i</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Middle Column -->
        <div class="settings-column">
            <!-- Multi Firm Section -->
            <div class="settings-section">
                <div class="form-group" style="margin-bottom: 20px;">
                    <input type="checkbox" id="multiFirm" style="margin-right: 8px;" @(Model.MultiFirm ? "checked" : "")>
                    <label for="multiFirm" style="font-size: 16px; font-weight: 600; min-width: auto;">Multi Firm</label>
                </div>
                @{
                    var BusinessName = Context.Session.GetString("BusinessName");
                }

                <div class="radio-group">
                    <input type="radio" id="orasoftUnique" name="firmType" checked>
                    <label for="orasoftUnique">@BusinessName</label>
                    <span class="default-badge">DEFAULT</span>
                </div>
            </div>

            <!-- Stock Transfer Section -->
            <div class="settings-section">
                <h3 class="section-title">Stock Transfer Between Godowns</h3>

                <div class="stock-transfer-description">
                    Manage all your stores/godowns and transfer stock seamlessly between them. Using this feature, you can transfer stock between stores/godowns and manage your inventory more efficiently.
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="godownManagement" @(Model.GodownManagement ? "checked" : "")>
                    <label for="godownManagement">Godown management & Stock transfer</label>
                </div>
            </div>
        </div>
    </div>

    <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #e0e0e0;">
        <button type="submit" id="saveSettingsBtn" class="btn btn-save">Save Settings</button>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Delivery Challan nested checkboxes logic
        const deliveryCheckbox = document.getElementById('deliveryChallan');
        const nestedCheckboxes = document.querySelectorAll('.nested-checkbox input[type="checkbox"]');

        if (deliveryCheckbox) {
            // Initial state
            nestedCheckboxes.forEach(checkbox => {
                checkbox.disabled = !deliveryCheckbox.checked;
            });

            deliveryCheckbox.addEventListener('change', function() {
                nestedCheckboxes.forEach(checkbox => {
                    checkbox.disabled = !this.checked;
                    if (!this.checked) {
                        checkbox.checked = false;
                    }
                });
            });
        }

        // Save button click handler
        const saveBtn = document.getElementById('saveSettingsBtn');
        if (saveBtn) {
            saveBtn.addEventListener('click', function(e) {
                e.preventDefault();
                saveSettings();
            });
        }
    });

    function saveSettings() {
        // Get Id from hidden field
        const id = parseInt(document.getElementById('settingsId')?.value) || 0;

        // Collect all settings data
        const data = {
            Id: id,

            // Application Section
            StopSaleOnNegativeStock: document.getElementById('stopSale')?.checked || false,
            BlockNewItemsFromTxn: document.getElementById('blockNewItems')?.checked || false,
            BlockNewPartiesFromTxn: document.getElementById('blockNewParties')?.checked || false,
            GstinNumber: document.getElementById('gstinNumber')?.checked || false,

            // More Transactions Section
            EstimateQuotation: document.getElementById('estimate')?.checked || false,
            ProformaInvoice: document.getElementById('proforma')?.checked || false,
            SalePurchaseOrder: document.getElementById('saleOrder')?.checked || false,
            OtherIncome: document.getElementById('otherIncome')?.checked || false,
            FixedAssets: document.getElementById('fixedAssets')?.checked || false,
            DeliveryChallan: document.getElementById('deliveryChallan')?.checked || false,
            GoodsReturnOnDeliveryChallan: document.getElementById('goodsReturn')?.checked || false,
            PrintAmountInDeliveryChallan: document.getElementById('printAmount')?.checked || false,

            // Multi Firm Section
            MultiFirm: document.getElementById('multiFirm')?.checked || false,

            // Stock Transfer Section
            GodownManagement: document.getElementById('godownManagement')?.checked || false
        };

        // Get anti-forgery token
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';

        // Send JSON data to your controller
        fetch('/Web/Settings/General/SaveSettings', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(data)
        })
        .then(response => {
            if (response.ok) {
                var successToast = new bootstrap.Toast(document.getElementById('successToast'));
                successToast.show();
                return response.json();
            }
            throw new Error('Network response was not ok');
        })
        .then(result => {
            if (result.success) {
                showSuccessMessage(result.message || 'Settings saved successfully!');

                // Optional: redirect after save
                if (result.redirectUrl) {
                    setTimeout(() => {
                        window.location.href = '/Web/Settings/General/Index';
                    }, 1500);
                }
            } else {
                showErrorMessage(result.message || 'Failed to save settings');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showErrorMessage('An error occurred while saving settings');
        });
    }

    function showSuccessMessage(message) {
        const existingAlerts = document.querySelectorAll('.alert');
        existingAlerts.forEach(alert => alert.remove());

        const alertDiv = document.createElement('div');
        alertDiv.className = 'alert alert-success alert-dismissible fade show';
        alertDiv.style.marginTop = '20px';
        alertDiv.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;

        const container = document.querySelector('.settings-container');
        container.insertBefore(alertDiv, container.firstChild);

        setTimeout(() => {
            if (alertDiv.parentNode) {
                alertDiv.remove();
            }
        }, 3000);
    }

    function showErrorMessage(message) {
        const existingAlerts = document.querySelectorAll('.alert');
        existingAlerts.forEach(alert => alert.remove());

        const alertDiv = document.createElement('div');
        alertDiv.className = 'alert alert-danger alert-dismissible fade show';
        alertDiv.style.marginTop = '20px';
        alertDiv.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;

        const container = document.querySelector('.settings-container');
        container.insertBefore(alertDiv, container.firstChild);

        setTimeout(() => {
            if (alertDiv.parentNode) {
                alertDiv.remove();
            }
        }, 5000);
    }
</script>