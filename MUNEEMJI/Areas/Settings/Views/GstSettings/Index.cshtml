@model MUNEEMJI.Models.Setting.GstSettingsModel
@{
    ViewBag.Title = "TAXES & GST";
    Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";
    var taxRates = (List<MUNEEMJI.Models.Setting.TaxRateModel>)ViewBag.TaxRates;
    var taxGroups = (List<MUNEEMJI.Models.Setting.TaxGroupModel>)ViewBag.TaxGroups;
}

<style>
    .gst-page { font-size: 12px; padding: 0; }
    .gst-page h6 { font-size: 13px; font-weight: 600; margin-bottom: 6px; }
    .gst-page .form-check { margin-bottom: 4px; padding-left: 1.5em; }
    .gst-page .form-check-input { width: 14px; height: 14px; margin-top: 2px; }
    .gst-page .form-check-label { font-size: 11.5px; }
    .gst-page .section-divider { border-top: 1px solid #dee2e6; margin: 6px 0; }
    .gst-page .rate-item { display: flex; justify-content: space-between; align-items: center; padding: 3px 0; border-bottom: 1px solid #f0f0f0; font-size: 11.5px; }
    .gst-page .rate-item:last-child { border-bottom: none; }
    .gst-page .rate-name { color: #333; }
    .gst-page .rate-value { color: #555; min-width: 40px; text-align: right; }
    .gst-page .action-icon { cursor: pointer; font-size: 11px; color: #888; margin-left: 6px; }
    .gst-page .action-icon:hover { color: #333; }
    .gst-page .group-item { padding: 4px 0; border-bottom: 1px solid #f0f0f0; font-size: 11.5px; }
    .gst-page .group-item:last-child { border-bottom: none; }
    .gst-page .group-name { font-weight: 600; color: #333; }
    .gst-page .group-taxes { color: #777; font-size: 10.5px; }
    .gst-page .col-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
    .gst-page .add-btn { width: 22px; height: 22px; font-size: 13px; line-height: 20px; text-align: center; border-radius: 50%; border: 1px solid #aaa; background: transparent; color: #555; cursor: pointer; padding: 0; }
    .gst-page .add-btn:hover { background: #f0f0f0; }
    .gst-page .rate-list, .gst-page .group-list { max-height: 400px; overflow-y: auto; }
    .gst-page .composite-select { font-size: 11px; padding: 2px 6px; height: auto; width: auto; display: inline-block; margin-left: 6px; }

    #gstToast { position: fixed; bottom: 20px; right: 20px; min-width: 220px; padding: 10px 16px; border-radius: 6px; color: #fff; font-size: 12px; z-index: 9999; display: none; box-shadow: 0 2px 8px rgba(0,0,0,.15); }

    .modal-content { font-size: 12px; }
    .modal-header { padding: 10px 16px 6px; }
    .modal-body { padding: 8px 16px 12px; }
    .modal-title { font-size: 13px; font-weight: 600; }
    .modal .form-control, .modal .form-select { font-size: 11.5px; padding: 4px 8px; }
    .modal .btn { font-size: 11px; padding: 4px 12px; }
    .modal .list-group-item { font-size: 11px; padding: 4px 8px; }
</style>

<div class="gst-page">
    <div class="row g-3">
        <!-- GST Settings Column -->
        <div class="col-md-3">
            <h6>GST Settings</h6>
            <div class="section-divider"></div>
            <form id="gstSettingsForm">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="EnableGST" @(Model.EnableGST ? "checked" : "")>
                    <label class="form-check-label" for="EnableGST">Enable GST</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="EnableHSNSACCode" @(Model.EnableHSNSACCode ? "checked" : "")>
                    <label class="form-check-label" for="EnableHSNSACCode">Enable HSN/SAC Code</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="AdditionalCessOnItem" @(Model.AdditionalCessOnItem ? "checked" : "")>
                    <label class="form-check-label" for="AdditionalCessOnItem">Additional Cess On Item</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="ReverseCharge" @(Model.ReverseCharge ? "checked" : "")>
                    <label class="form-check-label" for="ReverseCharge">Reverse Charge</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="EnablePlaceOfSupply" @(Model.EnablePlaceOfSupply ? "checked" : "")>
                    <label class="form-check-label" for="EnablePlaceOfSupply">Enable Place of Supply</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="CompositeScheme" @(Model.CompositeScheme ? "checked" : "")>
                    <label class="form-check-label" for="CompositeScheme">Composite Scheme</label>
                    <select id="CompositeSchemeType" class="form-select composite-select" style="display: @(Model.CompositeScheme ? "inline-block" : "none") !important;">
                        <option value="Trader(Goods) 1.0%" @(Model.CompositeSchemeType == "Trader(Goods) 1.0%" ? "selected":"")>Trader(Goods) 1.0%</option>
                        <option value="Manufacturer 1.0%" @(Model.CompositeSchemeType == "Manufacturer 1.0%" ? "selected":"")>Manufacturer 1.0%</option>
                        <option value="Restaurant 5.0%" @(Model.CompositeSchemeType == "Restaurant 5.0%" ? "selected":"")>Restaurant 5.0%</option>
                        <option value="Service Provider 6.0%" @(Model.CompositeSchemeType == "Service Provider 6.0%" ? "selected":"")>Service Provider 6.0%</option>
                    </select>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="EnableTCS" @(Model.EnableTCS ? "checked" : "")>
                    <label class="form-check-label" for="EnableTCS">Enable TCS</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="EnableTDS" @(Model.EnableTDS ? "checked" : "")>
                    <label class="form-check-label" for="EnableTDS">Enable TDS</label>
                </div>
            </form>
        </div>

        <!-- Tax Rates Column -->
        <div class="col-md-5">
            <div class="col-header">
                <h6 class="mb-0">Tax Rates</h6>
                <button class="add-btn" data-bs-toggle="modal" data-bs-target="#taxRateModal" title="Add Tax Rate">+</button>
            </div>
            <div class="section-divider"></div>
            <div class="rate-list">
                @if (taxRates != null)
                {
                    foreach (var r in taxRates)
                    {
                        <div class="rate-item">
                            <span class="rate-name">@r.Name</span>
                            <span>
                                <span class="rate-value">@r.Rate.ToString("0.000")</span>
                                <i class="fas fa-pencil-alt action-icon" onclick="editTaxRate(@r.Id, '@r.Name', @r.Rate, '@r.TaxType')"></i>
                                <i class="fas fa-trash-alt action-icon" onclick="deleteTaxRate(@r.Id)"></i>
                            </span>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Tax Group Column -->
        <div class="col-md-4">
            <div class="col-header">
                <h6 class="mb-0">Tax Group</h6>
                <button class="add-btn" data-bs-toggle="modal" data-bs-target="#taxGroupModal" title="Add Tax Group">+</button>
            </div>
            <div class="section-divider"></div>
            <div class="group-list">
                @if (taxGroups != null)
                {
                    foreach (var g in taxGroups)
                    {
                        <div class="group-item">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="group-name">@g.GroupName</span>
                                <span>
                                    @{
                                        var arrStr = g.TaxRateIds != null ? string.Join(",", g.TaxRateIds) : "";
                                    }
                                    <i class="fas fa-pencil-alt action-icon" onclick="editTaxGroup(@g.Id, '@g.GroupName', [@arrStr])"></i>
                                    <i class="fas fa-trash-alt action-icon" onclick="deleteTaxGroup(@g.Id)"></i>
                                </span>
                            </div>
                            <div class="group-taxes">@g.MemberTaxes</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Toast -->
<div id="gstToast"></div>

<!-- Add/Edit Tax Rate Modal -->
<div class="modal fade" id="taxRateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title">Add Tax Rate</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" style="font-size:10px;"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="taxRateId" value="0" />
                <div class="mb-2">
                    <input type="text" class="form-control" id="taxRateName" placeholder="Tax Name">
                </div>
                <div class="d-flex mb-2 gap-2">
                    <input type="number" class="form-control" id="taxRateValue" placeholder="Rate" step="0.001">
                    <select class="form-select" id="taxRateType">
                        <option value="Other">Other</option>
                        <option value="SGST">SGST</option>
                        <option value="CGST">CGST</option>
                        <option value="IGST">IGST</option>
                        <option value="CESS">CESS</option>
                        <option value="Flood CESS">Flood CESS</option>
                    </select>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="saveTaxRate()">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Tax Group Modal -->
<div class="modal fade" id="taxGroupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title">Add Tax Group</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" style="font-size:10px;"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="taxGroupId" value="0" />
                <div class="mb-2">
                    <input type="text" class="form-control" id="taxGroupName" placeholder="Enter Group Name">
                </div>
                <label style="font-size:11px;font-weight:500;">Select Taxes</label>
                <div class="border rounded" style="max-height: 160px; overflow-y: auto;">
                    <ul class="list-group list-group-flush">
                        @if (taxRates != null)
                        {
                            foreach (var r in taxRates)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@r.Name</span>
                                    <span>@r.Rate% <input class="form-check-input ms-2 tax-group-cb" type="checkbox" value="@r.Id" style="width:13px;height:13px;"></span>
                                </li>
                            }
                        }
                    </ul>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="saveTaxGroup()">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function showGstToast(msg, success) {
        var t = document.getElementById('gstToast');
        t.textContent = msg;
        t.style.background = success ? '#28a745' : '#dc3545';
        t.style.display = 'block';
        setTimeout(function () { t.style.display = 'none'; }, 2500);
    }

    document.addEventListener('DOMContentLoaded', function () {
        var inputs = document.querySelectorAll('#gstSettingsForm input[type="checkbox"], #CompositeSchemeType');
        inputs.forEach(function (el) {
            el.addEventListener('change', function () {
                if (this.id === 'CompositeScheme') {
                    var cst = document.getElementById('CompositeSchemeType');
                    cst.style.setProperty('display', this.checked ? 'inline-block' : 'none', 'important');
                }

                var model = {
                    EnableGST: document.getElementById('EnableGST').checked,
                    EnableHSNSACCode: document.getElementById('EnableHSNSACCode').checked,
                    AdditionalCessOnItem: document.getElementById('AdditionalCessOnItem').checked,
                    ReverseCharge: document.getElementById('ReverseCharge').checked,
                    EnablePlaceOfSupply: document.getElementById('EnablePlaceOfSupply').checked,
                    CompositeScheme: document.getElementById('CompositeScheme').checked,
                    CompositeSchemeType: document.getElementById('CompositeSchemeType').value,
                    EnableTCS: document.getElementById('EnableTCS').checked,
                    EnableTDS: document.getElementById('EnableTDS').checked
                };

                fetch('/Web/Settings/GstSettings/SaveSettings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(model)
                })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    showGstToast(data.message, data.success);
                });
            });
        });
    });

    // Modal resets
    document.getElementById('taxRateModal').addEventListener('hidden.bs.modal', function () {
        document.getElementById('taxRateId').value = 0;
        document.getElementById('taxRateName').value = '';
        document.getElementById('taxRateValue').value = '';
        document.getElementById('taxRateType').value = 'Other';
        document.querySelector('#taxRateModal .modal-title').textContent = 'Add Tax Rate';
    });

    document.getElementById('taxGroupModal').addEventListener('hidden.bs.modal', function () {
        document.getElementById('taxGroupId').value = 0;
        document.getElementById('taxGroupName').value = '';
        document.querySelectorAll('.tax-group-cb').forEach(function (cb) { cb.checked = false; });
        document.querySelector('#taxGroupModal .modal-title').textContent = 'Add Tax Group';
    });

    // Tax Rate CRUD
    function saveTaxRate() {
        var name = document.getElementById('taxRateName').value;
        var rate = document.getElementById('taxRateValue').value;
        if (!name || !rate) { showGstToast('Please enter Name and Rate', false); return; }

        var model = {
            Id: parseInt(document.getElementById('taxRateId').value),
            Name: name,
            Rate: parseFloat(rate),
            TaxType: document.getElementById('taxRateType').value
        };

        fetch('/Web/Settings/GstSettings/SaveTaxRate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(model)
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            showGstToast(data.message, data.success);
            if (data.success) setTimeout(function () { window.location.reload(); }, 800);
        });
    }

    function editTaxRate(id, name, rate, type) {
        document.getElementById('taxRateId').value = id;
        document.getElementById('taxRateName').value = name;
        document.getElementById('taxRateValue').value = rate;
        document.getElementById('taxRateType').value = type;
        document.querySelector('#taxRateModal .modal-title').textContent = 'Edit Tax Rate';
        new bootstrap.Modal(document.getElementById('taxRateModal')).show();
    }

    function deleteTaxRate(id) {
        if (!confirm('Delete this tax rate?')) return;
        fetch('/Web/Settings/GstSettings/DeleteTaxRate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + id
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            showGstToast(data.message, data.success);
            if (data.success) setTimeout(function () { window.location.reload(); }, 800);
        });
    }

    // Tax Group CRUD
    function saveTaxGroup() {
        var name = document.getElementById('taxGroupName').value;
        if (!name) { showGstToast('Please enter Group Name', false); return; }

        var selectedTaxes = [];
        document.querySelectorAll('.tax-group-cb:checked').forEach(function (cb) {
            selectedTaxes.push(parseInt(cb.value));
        });

        var model = {
            Id: parseInt(document.getElementById('taxGroupId').value),
            GroupName: name,
            TaxRateIds: selectedTaxes
        };

        fetch('/Web/Settings/GstSettings/SaveTaxGroup', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(model)
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            showGstToast(data.message, data.success);
            if (data.success) setTimeout(function () { window.location.reload(); }, 800);
        });
    }

    function editTaxGroup(id, name, rateIds) {
        document.getElementById('taxGroupId').value = id;
        document.getElementById('taxGroupName').value = name;
        document.querySelectorAll('.tax-group-cb').forEach(function (cb) {
            cb.checked = rateIds.includes(parseInt(cb.value));
        });
        document.querySelector('#taxGroupModal .modal-title').textContent = 'Edit Tax Group';
        new bootstrap.Modal(document.getElementById('taxGroupModal')).show();
    }

    function deleteTaxGroup(id) {
        if (!confirm('Delete this tax group?')) return;
        fetch('/Web/Settings/GstSettings/DeleteTaxGroup', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + id
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            showGstToast(data.message, data.success);
            if (data.success) setTimeout(function () { window.location.reload(); }, 800);
        });
    }
</script>
