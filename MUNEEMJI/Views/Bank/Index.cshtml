<!-- Bank Adjustment Modal -->
<div class="bank-modal-overlay" id="adjustmentModal">
    <div class="bank-modal">
        <div class="bank-modal-header">
            <h5>Adjust Bank Balance</h5>
            <button class="bank-modal-close" onclick="closeBankModal('adjustmentModal')">&times;</button>
        </div>
        <div class="bank-modal-body">
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Account Name</label>
                    <select class="form-select" id="adjust_account"><option>@(selectedAccount?.BankName ?? selectedAccount?.AccountDisplayName ?? "")</option></select>
                </div>
                <div class="form-group">
                    <label class="form-label">Type</label>
                    <select class="form-select" id="adjust_type">
                        <option value="Increase">Increase balance</option>
                        <option value="Decrease">Decrease balance</option>
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Amount</label>
                    <input type="number" class="form-input" id="adjust_amount" placeholder="0.00" step="0.01">
                </div>
                <div class="form-group">
                    <label class="form-label">Date</label>
                    <input type="date" class="form-input" id="adjust_date" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>
            </div>
            <input type="text" class="form-input" id="adjust_desc" placeholder="Add Description (optional)" style="margin-bottom:14px;">
            <div class="clearfix" style="overflow:hidden;"><button class="btn-save" onclick="saveAdjustment()">Save</button></div>
        </div>
    </div>
</div>

<script>
    let currentDeleteId = null;

    // Deposit / Withdraw dropdown
    function toggleDepositDropdown() {
        const menu = document.getElementById('depositDropdownMenu');
        menu.classList.toggle('show');
    }

    // Bank modals
    function openBankModal(modalId) {
        document.getElementById('depositDropdownMenu').classList.remove('show');
        document.getElementById(modalId).classList.add('show');
    }

    function closeBankModal(modalId) {
        document.getElementById(modalId).classList.remove('show');
    }

    // Delete
    function confirmDelete(accountId, accountName) {
        currentDeleteId = accountId;
        document.getElementById('deleteAccountName').textContent = accountName;
        document.getElementById('deleteConfirmModal').classList.add('show');
    }

    function closeDeleteModal() {
        document.getElementById('deleteConfirmModal').classList.remove('show');
        currentDeleteId = null;
    }

    function deleteAccount() {
        if (currentDeleteId) {
            window.location.href = '/Web/Bank/DeleteConfirmed?id=' + currentDeleteId;
        }
    }

    // Search filter
    function filterBankAccounts(term) {
        term = term.toLowerCase();
        document.querySelectorAll('.bank-account-item').forEach(function(item) {
            var name = (item.getAttribute('data-name') || '').toLowerCase();
            var amount = (item.getAttribute('data-amount') || '').toLowerCase();
            item.style.display = (name.includes(term) || amount.includes(term) || term === '') ? '' : 'none';
        });
    }

    // Close dropdowns on outside click
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.deposit-dropdown-wrapper')) {
            var menu = document.getElementById('depositDropdownMenu');
            if (menu) menu.classList.remove('show');
        }
        // Close modals on backdrop click
        if (e.target.classList.contains('bank-modal-overlay')) {
            e.target.classList.remove('show');
        }
    });

    // Double-click on account item to edit
    document.querySelectorAll('.bank-account-item').forEach(function(item) {
        item.addEventListener('dblclick', function(e) {
            e.preventDefault();
            var href = this.getAttribute('href');
            if (href) {
                var idMatch = href.match(/id=(\d+)/);
                if (idMatch) {
                    window.location.href = '/Web/Bank/AddBankAccount?id=' + idMatch[1] + '&typeid=2';
                }
            }
        });
    });

    // Save: Bank to Cash Transfer
    function saveBankToCash() {
        var amount = parseFloat(document.getElementById('bankToCash_amount').value);
        var date = document.getElementById('bankToCash_date').value;
        var desc = document.getElementById('bankToCash_desc').value;
        var from = document.getElementById('bankToCash_from').value;
        var to = document.getElementById('bankToCash_to').value;

        if (!amount || amount <= 0) { showBankToast('Please enter a valid amount', 'error'); return; }
        if (!date) { showBankToast('Please select a date', 'error'); return; }

        var payload = {
            TransactionType: 'Bank to Cash',
            FromAccount: from,
            ToAccount: to,
            Amount: amount,
            TransactionDate: date,
            Description: desc
        };

        fetch('/Web/Bank/SaveBankTransfer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                closeBankModal('bankToCashModal');
                sessionStorage.setItem('bankToast', 'Bank to Cash transfer saved successfully!');
                location.reload();
            } else {
                showBankToast(data.message || 'Error saving transaction', 'error');
            }
        })
        .catch(function() { showBankToast('Error saving transaction', 'error'); });
    }

    // Save: Cash to Bank Transfer
    function saveCashToBank() {
        var amount = parseFloat(document.getElementById('cashToBank_amount').value);
        var date = document.getElementById('cashToBank_date').value;
        var desc = document.getElementById('cashToBank_desc').value;
        var from = document.getElementById('cashToBank_from').value;
        var to = document.getElementById('cashToBank_to').value;

        if (!amount || amount <= 0) { showBankToast('Please enter a valid amount', 'error'); return; }
        if (!date) { showBankToast('Please select a date', 'error'); return; }

        var payload = {
            TransactionType: 'Cash to Bank',
            FromAccount: from,
            ToAccount: to,
            Amount: amount,
            TransactionDate: date,
            Description: desc
        };

        fetch('/Web/Bank/SaveBankTransfer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                closeBankModal('cashToBankModal');
                sessionStorage.setItem('bankToast', 'Cash to Bank transfer saved successfully!');
                location.reload();
            } else {
                showBankToast(data.message || 'Error saving transaction', 'error');
            }
        })
        .catch(function() { showBankToast('Error saving transaction', 'error'); });
    }

    // Save: Bank to Bank Transfer
    function saveBankToBank() {
        var amount = parseFloat(document.getElementById('bankToBank_amount').value);
        var date = document.getElementById('bankToBank_date').value;
        var desc = document.getElementById('bankToBank_desc').value;
        var from = document.getElementById('bankToBank_from').value;
        var to = document.getElementById('bankToBank_to').value;

        if (!amount || amount <= 0) { showBankToast('Please enter a valid amount', 'error'); return; }
        if (!date) { showBankToast('Please select a date', 'error'); return; }

        var payload = {
            TransactionType: 'Bank to Bank',
            FromAccount: from,
            ToAccount: to,
            Amount: amount,
            TransactionDate: date,
            Description: desc
        };

        fetch('/Web/Bank/SaveBankTransfer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                closeBankModal('bankToBankModal');
                sessionStorage.setItem('bankToast', 'Bank to Bank transfer saved successfully!');
                location.reload();
            } else {
                showBankToast(data.message || 'Error saving transaction', 'error');
            }
        })
        .catch(function() { showBankToast('Error saving transaction', 'error'); });
    }

    // Save: Adjust Bank Balance
    function saveAdjustment() {
        var amount = parseFloat(document.getElementById('adjust_amount').value);
        var date = document.getElementById('adjust_date').value;
        var desc = document.getElementById('adjust_desc').value;
        var account = document.getElementById('adjust_account').value;
        var type = document.getElementById('adjust_type').value;

        if (!amount || amount <= 0) { showBankToast('Please enter a valid amount', 'error'); return; }
        if (!date) { showBankToast('Please select a date', 'error'); return; }

        var payload = {
            TransactionType: 'Adjustment - ' + type,
            FromAccount: account,
            ToAccount: account,
            Amount: amount,
            TransactionDate: date,
            Description: desc
        };

        fetch('/Web/Bank/SaveBankTransfer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                closeBankModal('adjustmentModal');
                sessionStorage.setItem('bankToast', 'Bank balance adjusted successfully!');
                location.reload();
            } else {
                showBankToast(data.message || 'Error saving transaction', 'error');
            }
        })
        .catch(function() { showBankToast('Error saving transaction', 'error'); });
    }

    // Toast notification
    function showBankToast(message, type) {
        var toast = document.getElementById('bankToast');
        toast.textContent = message;
        toast.style.background = (type === 'error') ? '#dc3545' : '#28a745';
        toast.style.display = 'block';
        toast.style.opacity = '1';
        setTimeout(function() {
            toast.style.opacity = '0';
            setTimeout(function() { toast.style.display = 'none'; }, 300);
        }, 3000);
    }

    // Show pending toast from sessionStorage after page reload
    document.addEventListener('DOMContentLoaded', function() {
        var pendingToast = sessionStorage.getItem('bankToast');
        if (pendingToast) {
            showBankToast(pendingToast);
            sessionStorage.removeItem('bankToast');
        }
    });
</script>