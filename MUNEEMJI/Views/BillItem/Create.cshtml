                                    <td><input type="number" name="RawMaterialPrice[]" class="form-input" step="0.01" value="@(Model.BillItem.Manufacturing != null && Model.BillItem.Manufacturing.Count > 1 ? Model.BillItem.Manufacturing[1].PurchasePricePerUnit.ToString("0.##") : "0")"></td>
                                    <td><input type="number" name="RawMaterialCost[]" class="form-input" step="0.01" value="@(Model.BillItem.Manufacturing != null && Model.BillItem.Manufacturing.Count > 1 ? Model.BillItem.Manufacturing[1].EstimatedCost.ToString("0.##") : "0")" readonly></td>
