@model BusinessProfileModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";   // no shared layout, standalone page:contentReference[oaicite:12]{index=12}
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Edit Profile</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css" />
</head>
<body>
    <div class="container mt-4">
        <h2>Edit Profile</h2>
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />
            <input type="hidden" id="deleteLogoFlag" name="DeleteLogo" value="false" />
            <input type="hidden" id="deleteSignatureFlag" name="DeleteSignature" value="false" />


            <div class="row">
                <!-- Column 1: Business Details -->
                <div class="col-md-4">
                    <h5>Business Details</h5>
                    <div class="form-group">
                        <label asp-for="BusinessName">Business Name</label>
                        <input asp-for="BusinessName" class="form-control" />
                        <span asp-validation-for="BusinessName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PhoneNumber">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Enter Phone Number" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Gstin">GSTIN</label>
                        <input asp-for="Gstin" class="form-control" placeholder="Enter GSTIN" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Email">Email ID</label>
                        <input asp-for="Email" class="form-control" placeholder="Enter Email ID" />
                    </div>

                    @*   <div class="form-group">
                        <label>Business Logo</label>
                        <input type="file" name="LogoFile" class="form-control-file" />
                    </div> *@


                    <div class="form-group">
                        <div class="floating-label-container upload-area-logo"
                             style="border: 2px solid lightgray; border-radius: 8px; padding: 20px; text-align: center; background: #f8f9fb; cursor: pointer; transition: all 0.3s ease; position: relative;"
                             onclick="document.querySelector('input[name=\'LogoFile\']').click()">

                            <span class="upload-label-logo"
                                  style="position: absolute; top: -10px; left: 20px; background: white; padding: 0 8px; color: #6c757d; font-size: 14px;">
                                Business Logo
                            </span>

                            <input type="file" name="LogoFile" class="floating-input" accept="image/*"
                                   onchange="previewLogo(this)" style="display: none;" />

                            <div class="upload-content-logo">
                                <i class="bi bi-cloud-upload" style="font-size: 24px; color: #007bff; margin-bottom: 8px;"></i>
                                <div style="color: #007bff; font-weight: 500;">Upload Logo</div>
                                <div style="color: #6c757d; font-size: 12px; margin-top: 4px;">Click to browse files</div>
                            </div>

                            <div class="image-preview-logo" style="display: none;">
                                <img id="preview-img-logo" src="" alt="Logo Preview"
                                     style="width: 85px; height: 85px; border: 1px solid #ddd; border-radius: 50%; object-fit: cover;" />
                                <div id="image-name-logo" style="margin-top: 8px; color: #6c757d; font-size: 12px; word-break: break-all;"></div>
                                <div style="margin-top: 8px;">
                                    <button type="button" onclick="removeLogo(event)"
                                            style="padding: 5px 15px; background: #007bff; color: white; border: none; border-radius: 3px; cursor: pointer;">
                                        Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>



                </div>
                <!-- Column 2: More Details -->
                <div class="col-md-4">
                    <h5>More Details</h5>
                    <div class="form-group">
                        <label>Business Type</label>
                        <select asp-for="BusinessTypeId" asp-items="ViewBag.Types" class="form-control">
                            <option value="">Select Business Type</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Business Category</label>
                        <select asp-for="BusinessCategoryId" asp-items="ViewBag.Categories" class="form-control">
                            <option value="">Select Business Category</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>State</label>
                        <select asp-for="StateId" asp-items="ViewBag.States" class="form-control">
                            <option value="">Select State</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Pincode</label>
                        <input asp-for="Pincode" class="form-control" placeholder="Enter Pincode" />
                    </div>
                </div>
                <!-- Column 3: Address & Signature -->
                <div class="col-md-4">
                    <h5>Business Address</h5>
                    <div class="form-group">
                        <textarea asp-for="Address" class="form-control" rows="4" placeholder="Enter Business Address"></textarea>
                    </div>

                    <div class="form-group">
                        <div class="floating-label-container upload-area-signature"
                             style="border: 2px solid lightgray; border-radius: 8px; padding: 20px; text-align: center; background: #f8f9fb; cursor: pointer; transition: all 0.3s ease; position: relative;"
                             onclick="document.querySelector('input[name=\'SignatureFile\']').click()">
                            <span class="upload-label-signature"
                                  style="position: absolute; top: -10px; left: 20px; background: white; padding: 0 8px; color: #6c757d; font-size: 14px;">
                                Add Signature
                            </span>
                            <input type="file" name="SignatureFile" class="floating-input" accept="image/*"
                                   onchange="previewSignature(this)" style="display: none;" />
                            <div class="upload-content-signature">
                                <i class="bi bi-cloud-upload" style="font-size: 24px; color: #007bff; margin-bottom: 8px;"></i>
                                <div style="color: #007bff; font-weight: 500;">Upload Signature</div>
                                <div style="color: #6c757d; font-size: 12px; margin-top: 4px;">Click to browse files</div>
                            </div>
                            <div class="image-preview-signature" style="display: none;">
                                <img id="preview-img-signature" src="" alt="Signature Preview"
                                     style="width: 85px; height: 85px; border: 1px solid #ddd; border-radius: 50%; object-fit: cover;" />
                                <div id="image-name-signature" style="margin-top: 8px; color: #6c757d; font-size: 12px; word-break: break-all;"></div>
                                <div style="margin-top: 8px;">
                                    <button type="button" onclick="removeSignature(event)"
                                            style="padding: 5px 15px; background: #007bff; color: white; border: none; border-radius: 3px; cursor: pointer;">
                                        Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Buttons -->
            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary ml-2">Cancel</a>
            </div>
        </form>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>

        function previewLogo(input) {
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.querySelector('.upload-content-logo').style.display = 'none';
                    document.querySelector('.image-preview-logo').style.display = 'block';
                    document.getElementById('preview-img-logo').src = e.target.result;
                    document.getElementById('image-name-logo').textContent = file.name;
                    document.querySelector('.upload-area-logo').style.borderColor = '#28a745';
                     document.getElementById('deleteLogoFlag').value = 'false';

                };
                reader.readAsDataURL(file);
            }
        }

        function removeLogo(event) {
            event.stopPropagation();
            document.querySelector('input[name="LogoFile"]').value = '';
            document.querySelector('.upload-content-logo').style.display = 'block';
            document.querySelector('.image-preview-logo').style.display = 'none';
            document.getElementById('preview-img-logo').src = '';
            document.getElementById('image-name-logo').textContent = '';
            document.querySelector('.upload-area-logo').style.borderColor = 'lightgray';
            document.getElementById('deleteLogoFlag').value = 'true';
        }

        // NEW FUNCTION: Set logo from data
        function setLogoFromData(imageUrl, imageName) {
            document.querySelector('.upload-content-logo').style.display = 'none';
            document.querySelector('.image-preview-logo').style.display = 'block';
            document.getElementById('preview-img-logo').src = imageUrl;
            document.getElementById('image-name-logo').textContent = imageName || 'Loaded Image';
            document.querySelector('.upload-area-logo').style.borderColor = '#28a745';
            document.getElementById('deleteLogoFlag').value = 'false';
        }

        function previewSignature(input) {
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.querySelector('.upload-content-signature').style.display = 'none';
                    document.querySelector('.image-preview-signature').style.display = 'block';
                    document.getElementById('preview-img-signature').src = e.target.result;
                    document.getElementById('image-name-signature').textContent = file.name;
                    document.querySelector('.upload-area-signature').style.borderColor = '#28a745';
                    document.getElementById('deleteSignatureFlag').value = 'false';
                };
                reader.readAsDataURL(file);
            }
        }

        function removeSignature(event) {
            event.stopPropagation();
            document.querySelector('input[name="SignatureFile"]').value = '';
            document.querySelector('.upload-content-signature').style.display = 'block';
            document.querySelector('.image-preview-signature').style.display = 'none';
            document.getElementById('preview-img-signature').src = '';
            document.getElementById('image-name-signature').textContent = '';
            document.querySelector('.upload-area-signature').style.borderColor = 'lightgray';
            document.getElementById('deleteSignatureFlag').value = 'true';
        }

        // NEW FUNCTION: Set signature from data
        function setSignatureFromData(imageUrl, imageName) {
            document.querySelector('.upload-content-signature').style.display = 'none';
            document.querySelector('.image-preview-signature').style.display = 'block';
            document.getElementById('preview-img-signature').src = imageUrl;
            document.getElementById('image-name-signature').textContent = imageName || 'Loaded Image';
            document.querySelector('.upload-area-signature').style.borderColor = '#28a745';
            document.getElementById('deleteSignatureFlag').value = 'false';
        }

            document.addEventListener('DOMContentLoaded', function() {
            var logoPath = '@Html.Raw(Model.LogoPath ?? "")';
            var signaturePath = '@Html.Raw(Model.SignaturePath ?? "")';

            // If logo exists, display it
            if (logoPath && logoPath !== '') {
                var logoUrl = logoPath.startsWith('/') ? logoPath : '/' + logoPath;
                var logoFileName = logoPath.split('/').pop();
                setLogoFromData(logoUrl, logoFileName);
            }

            // If signature exists, display it
            if (signaturePath && signaturePath !== '') {
                var signatureUrl = signaturePath.startsWith('/') ? signaturePath : '/' + signaturePath;
                var signatureFileName = signaturePath.split('/').pop();
                setSignatureFromData(signatureUrl, signatureFileName);
            }
        });
    </script>
</body>
</html>