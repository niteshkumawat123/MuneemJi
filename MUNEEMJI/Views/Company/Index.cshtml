@model CompanySharedModel

@{
    Layout = null;
    var currentBusinessId = Context.Session.GetString("BusinessId") ?? "0";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Company List - MuneemJi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
            background: #f0f2f5;
            min-height: 100vh;
        }

        /* ?? Top Nav ?? */
        .topnav {
            background: #fff;
            border-bottom: 1px solid #e4e6eb;
            padding: 0 24px;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 1px 3px rgba(0,0,0,.06);
        }
        .topnav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }
        .topnav-brand .brand-icon {
            width: 36px; height: 36px;
            background: linear-gradient(135deg, #e53e3e, #c53030);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-weight: 800; font-size: 16px;
        }
        .topnav-brand .brand-name {
            font-size: 18px; font-weight: 700; color: #1a202c;
        }
        .topnav-right {
            display: flex; align-items: center; gap: 16px; font-size: 13px; color: #718096;
        }
        .topnav-right a { color: #3182ce; text-decoration: none; font-weight: 500; }
        .topnav-right a:hover { text-decoration: underline; }

        /* ?? Hero Banner ?? */
        .hero {
            background: linear-gradient(135deg, #1a202c 0%, #2d3748 100%);
            padding: 32px 24px 0;
        }
        .hero-inner {
            max-width: 1100px; margin: 0 auto;
            display: flex; justify-content: space-between; align-items: flex-end;
        }
        .hero h1 { color: #fff; font-size: 26px; font-weight: 700; margin-bottom: 8px; }
        .hero p { color: #a0aec0; font-size: 14px; margin-bottom: 24px; }
        .hero-search {
            position: relative; width: 320px;
        }
        .hero-search input {
            width: 100%; padding: 10px 16px 10px 40px;
            border: none; border-radius: 8px;
            background: rgba(255,255,255,.12); color: #fff;
            font-size: 14px; outline: none;
            transition: background .2s;
        }
        .hero-search input::placeholder { color: #a0aec0; }
        .hero-search input:focus { background: rgba(255,255,255,.2); }
        .hero-search .search-ic {
            position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
            color: #a0aec0; font-size: 14px;
        }

        /* ?? Tabs ?? */
        .tabs-bar {
            max-width: 1100px; margin: 0 auto;
            display: flex; gap: 0;
        }
        .tab-btn {
            padding: 14px 24px; font-size: 14px; font-weight: 600;
            color: #a0aec0; cursor: pointer;
            border-bottom: 3px solid transparent;
            transition: all .2s;
            user-select: none;
        }
        .tab-btn:hover { color: #e2e8f0; }
        .tab-btn.active { color: #fff; border-bottom-color: #e53e3e; }

        /* ?? Content ?? */
        .content-wrap {
            max-width: 1100px; margin: 0 auto;
            padding: 24px 24px 60px;
        }
        .tab-pane { display: none; }
        .tab-pane.active { display: block; }

        .section-label {
            font-size: 12px; font-weight: 600; text-transform: uppercase;
            letter-spacing: .5px; color: #a0aec0; margin-bottom: 12px;
        }

        /* ?? Company Card ?? */
        .company-card {
            background: #fff;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            padding: 18px 20px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: box-shadow .2s, transform .15s;
        }
        .company-card:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,.07);
            transform: translateY(-1px);
        }
        .cc-left { display: flex; align-items: center; gap: 14px; }
        .cc-avatar {
            width: 44px; height: 44px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-radius: 12px; color: #fff;
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 18px;
        }
        .cc-name { font-size: 15px; font-weight: 600; color: #1a202c; margin-bottom: 2px; }
        .cc-email { font-size: 12px; color: #a0aec0; }
        .cc-badge {
            display: inline-block; background: #fef3c7; color: #92400e;
            font-size: 10px; font-weight: 700; padding: 2px 8px;
            border-radius: 4px; margin-left: 8px; vertical-align: middle;
            text-transform: uppercase; letter-spacing: .3px;
        }
        .cc-right { display: flex; align-items: center; gap: 10px; }
        .btn-open {
            padding: 8px 24px; font-size: 13px; font-weight: 600;
            border: 1.5px solid #3182ce; color: #3182ce;
            background: #fff; border-radius: 8px; cursor: pointer;
            transition: all .2s;
        }
        .btn-open:hover { background: #3182ce; color: #fff; }

        /* ?? More Menu ?? */
        .more-wrap { position: relative; }
        .more-trigger {
            width: 34px; height: 34px;
            border: 1px solid #e2e8f0; background: #fff;
            border-radius: 8px; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            color: #718096; font-size: 16px;
            transition: background .15s;
        }
        .more-trigger:hover { background: #f7fafc; }
        .more-menu {
            display: none; position: absolute; right: 0; top: 40px;
            background: #fff; border: 1px solid #e2e8f0;
            border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,.12);
            min-width: 170px; overflow: hidden; z-index: 50;
        }
        .more-menu.open { display: block; }
        .more-menu-item {
            padding: 10px 16px; font-size: 13px; color: #4a5568;
            cursor: pointer; display: flex; align-items: center; gap: 8px;
            transition: background .12s;
        }
        .more-menu-item:hover { background: #f7fafc; }
        .more-menu-item.danger { color: #e53e3e; }
        .more-menu-item.danger:hover { background: #fff5f5; }

        /* ?? Bottom Bar ?? */
        .bottom-bar {
            display: flex; justify-content: space-between; align-items: center;
            margin-top: 32px; padding-top: 24px;
            border-top: 1px solid #e2e8f0;
        }
        .btn-primary-action {
            padding: 10px 28px; font-size: 14px; font-weight: 600;
            background: linear-gradient(135deg, #e53e3e, #c53030);
            color: #fff; border: none; border-radius: 10px;
            cursor: pointer; transition: all .2s;
            box-shadow: 0 2px 8px rgba(229,62,62,.25);
        }
        .btn-primary-action:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(229,62,62,.35);
        }
        .btn-logout {
            padding: 10px 24px; font-size: 13px; font-weight: 600;
            background: #fff; color: #e53e3e;
            border: 1.5px solid #e53e3e; border-radius: 10px;
            cursor: pointer; transition: all .2s;
        }
        .btn-logout:hover { background: #fff5f5; }
        .logout-hint { font-size: 11px; color: #a0aec0; margin-top: 4px; text-align: right; }

        /* ?? Empty State ?? */
        .empty-state {
            text-align: center; padding: 60px 20px; color: #a0aec0;
        }
        .empty-state i { font-size: 48px; margin-bottom: 16px; display: block; }
        .empty-state p { font-size: 14px; }

        /* ?? Note bar ?? */
        .note-bar {
            font-size: 12px; color: #a0aec0;
            background: #f7fafc; border: 1px solid #e2e8f0;
            border-radius: 8px; padding: 10px 16px; margin-top: 16px;
        }

        /* ?? Confirmation Modal ?? */
        .modal-overlay {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,.45); z-index: 1000;
            align-items: center; justify-content: center;
        }
        .modal-overlay.show { display: flex; }
        .modal-box {
            background: #fff; border-radius: 16px;
            padding: 32px; max-width: 420px; width: 90%;
            box-shadow: 0 20px 60px rgba(0,0,0,.2);
            animation: modalIn .25s ease-out;
        }
        @@keyframes modalIn { from { opacity: 0; transform: scale(.95); } to { opacity: 1; transform: scale(1); } }
        .modal-icon {
            width: 56px; height: 56px; border-radius: 50%;
            background: #fff5f5; color: #e53e3e;
            display: flex; align-items: center; justify-content: center;
            font-size: 28px; margin-bottom: 16px;
        }
        .modal-title { font-size: 18px; font-weight: 700; color: #1a202c; margin-bottom: 8px; }
        .modal-desc { font-size: 14px; color: #718096; line-height: 1.6; margin-bottom: 24px; }
        .modal-actions { display: flex; gap: 10px; justify-content: flex-end; }
        .modal-actions button {
            padding: 10px 22px; border-radius: 8px; font-size: 13px;
            font-weight: 600; cursor: pointer; transition: all .15s;
        }
        .btn-modal-cancel { background: #f0f0f0; color: #4a5568; border: none; }
        .btn-modal-cancel:hover { background: #e2e8f0; }
        .btn-modal-delete { background: #e53e3e; color: #fff; border: none; }
        .btn-modal-delete:hover { background: #c53030; }

        /* ?? Toast ?? */
        .toast-msg {
            display: none; position: fixed; top: 20px; right: 20px;
            background: #38a169; color: #fff; padding: 14px 24px;
            border-radius: 10px; font-size: 14px; font-weight: 600;
            box-shadow: 0 6px 20px rgba(56,161,105,.3); z-index: 2000;
            align-items: center; gap: 10px;
        }
        .toast-msg.show { display: flex; }

        /* ?? Responsive ?? */
        @@media (max-width: 768px) {
            .hero-inner { flex-direction: column; align-items: flex-start; }
            .hero-search { width: 100%; margin-bottom: 16px; }
            .company-card { flex-direction: column; align-items: flex-start; gap: 12px; }
            .cc-right { width: 100%; justify-content: flex-end; }
            .bottom-bar { flex-direction: column; gap: 16px; align-items: stretch; }
        }
    </style>
</head>
<body>

    <!-- Top Nav -->
    <nav class="topnav">
        <a href="http://muneemjii.com/gst-billing-app.htm" class="topnav-brand">
            <div class="brand-icon">M</div>
            <span class="brand-name">MuneemJi</span>
        </a>
        <div class="topnav-right">
            <span>Customer Support:</span>
            <a href="tel:+916364444752"><i class="bi bi-telephone"></i> (+91) 636-444-752</a>
            <a href="http://muneemjii.com/gst-billing-app.htm">Online Support</a>
        </div>
    </nav>

    <!-- Hero -->
    <div class="hero">
        <div class="hero-inner">
            <div>
                <h1>Company List</h1>
                <p>Manage your businesses and shared companies</p>
            </div>
            <div class="hero-search">
                <i class="bi bi-search search-ic"></i>
                <input type="text" id="searchInput" placeholder="Search companies..." />
            </div>
        </div>
        <!-- Tabs -->
        <div class="tabs-bar">
            <div class="tab-btn active" data-tab="my">My Companies</div>
            <div class="tab-btn" data-tab="shared">Shared with Me</div>
        </div>
    </div>

    <!-- Content -->
    <div class="content-wrap">

        <!-- My Companies Pane -->
        <div class="tab-pane active" id="pane-my">
            <div class="section-label">Companies created by you</div>

            @if (Model.MyCompany != null && Model.MyCompany.Any())
            {
                @foreach (var item in Model.MyCompany)
                {
                    var isCurrent = item.Id.ToString() == currentBusinessId;
                    <div class="company-card" data-name="@item.BusinessName">
                        <div class="cc-left">
                            <div class="cc-avatar" style="@(isCurrent ? "background: linear-gradient(135deg, #e53e3e, #c53030);" : "")">@(string.IsNullOrEmpty(item.BusinessName) ? "?" : item.BusinessName[0].ToString().ToUpper())</div>
                            <div>
                                <div class="cc-name">
                                    @item.BusinessName
                                    @if (isCurrent)
                                    {
                                        <span class="cc-badge">Current</span>
                                    }
                                </div>
                                <div class="cc-email">@item.Email</div>
                            </div>
                        </div>
                        <div class="cc-right">
                            @if (isCurrent)
                            {
                                <button class="btn-open" onclick="window.location.href='/Web/Home/Index'">
                                    <i class="bi bi-box-arrow-in-right"></i> Open
                                </button>
                            }
                            else
                            {
                                <form method="post" action="/Web/Company/SwitchCompany" style="display:inline;">
                                    <input type="hidden" name="companyId" value="@item.Id" />
                                    <button type="submit" class="btn-open">
                                        <i class="bi bi-arrow-repeat"></i> Switch
                                    </button>
                                </form>
                            }
                            <div class="more-wrap">
                                <button class="more-trigger" onclick="toggleMenu(event, this)">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <div class="more-menu">
                                    <div class="more-menu-item" onclick="window.location.href='/Web/BusinessProfile/Edit'">
                                        <i class="bi bi-pencil"></i> Rename
                                    </div>
                                    <div class="more-menu-item" onclick="switchCompany(@item.Id)">
                                        <i class="bi bi-folder2-open"></i> Open
                                    </div>
                                    @if (!isCurrent)
                                    {
                                        <div class="more-menu-item danger" onclick="deleteCompany(@item.Id)">
                                            <i class="bi bi-trash3"></i> Delete
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-building"></i>
                    <p>No companies yet. Create your first company to get started!</p>
                </div>
            }

            <div class="bottom-bar">
                <button class="btn-primary-action" onclick="window.location.href='/Web/Company/CreateCompany'">
                    <i class="bi bi-plus-lg"></i> New Company
                </button>
                <div>
                    <button class="btn-logout" onclick="logout()">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                    <div class="logout-hint">Logging out will stop syncing data</div>
                </div>
            </div>
        </div>


        <!-- Shared Companies Pane -->
        <div class="tab-pane" id="pane-shared">
            <div class="section-label">Companies shared with you</div>

            @if (Model.CompanySharedWithMe != null && Model.CompanySharedWithMe.Any())
            {
                @foreach (var item in Model.CompanySharedWithMe)
                {
                    <div class="company-card" data-name="@item.BusinessName">
                        <div class="cc-left">
                            <div class="cc-avatar" style="background: linear-gradient(135deg, #38a169, #2f855a);">@(string.IsNullOrEmpty(item.BusinessName) ? "?" : item.BusinessName[0].ToString().ToUpper())</div>
                            <div>
                                <div class="cc-name">@item.BusinessName</div>
                                <div class="cc-email">@item.Email</div>
                            </div>
                        </div>
                        <div class="cc-right">
                            <form method="post" action="/Web/Company/SwitchCompany" style="display:inline;">
                                <input type="hidden" name="companyId" value="@item.Id" />
                                <button type="submit" class="btn-open">
                                    <i class="bi bi-arrow-repeat"></i> Switch
                                </button>
                            </form>
                            <div class="more-wrap">
                                <button class="more-trigger" onclick="toggleMenu(event, this)">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <div class="more-menu">
                                    <div class="more-menu-item" onclick="switchCompany(@item.Id)">
                                        <i class="bi bi-folder2-open"></i> Open
                                    </div>
                                    <div class="more-menu-item danger" onclick="deleteCompany(@item.Id)">
                                        <i class="bi bi-trash3"></i> Delete
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-people"></i>
                    <p>No companies have been shared with you yet.</p>
                </div>
            }

            <div class="note-bar">
                <i class="bi bi-info-circle"></i>
                These companies are not owned by you and are only available when you have an internet connection.
            </div>

            <div class="bottom-bar">
                <button class="btn-primary-action" onclick="window.location.href='/Web/Company/CreateCompany'">
                    <i class="bi bi-plus-lg"></i> New Company
                </button>
                <div>
                    <button class="btn-logout" onclick="logout()">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                    <div class="logout-hint">Logging out will stop syncing data</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal-overlay" id="deleteModal">
        <div class="modal-box">
            <div class="modal-icon"><i class="bi bi-exclamation-triangle"></i></div>
            <div class="modal-title">Delete Company</div>
            <div class="modal-desc">
                Are you sure you want to delete this company? All data associated with this company will be permanently removed. This action cannot be undone.
            </div>
            <div class="modal-actions">
                <button class="btn-modal-cancel" onclick="closeDeleteModal()">Cancel</button>
                <button class="btn-modal-delete" onclick="confirmDelete()">
                    <i class="bi bi-trash3"></i> Delete
                </button>
            </div>
        </div>
    </div>

    <!-- Success Toast -->
    <div class="toast-msg" id="successToast">
        <i class="bi bi-check-circle"></i>
        <span>Company deleted successfully!</span>
    </div>

    <script>
        // ?? Tabs ??
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
                btn.classList.add('active');
                document.getElementById('pane-' + btn.dataset.tab).classList.add('active');
            });
        });

        // ?? Search ??
        document.getElementById('searchInput').addEventListener('input', function () {
            const q = this.value.toLowerCase();
            document.querySelectorAll('.tab-pane.active .company-card').forEach(card => {
                const name = (card.dataset.name || '').toLowerCase();
                card.style.display = name.includes(q) ? '' : 'none';
            });
        });

        // ?? More Menu ??
        function toggleMenu(e, trigger) {
            e.stopPropagation();
            const menu = trigger.nextElementSibling;

        // ?? Switch Company (from menu item) ??
        function switchCompany(companyId) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Web/Company/SwitchCompany';
            const input = document.createElement('input');
            input.type = 'hidden'; input.name = 'companyId'; input.value = companyId;
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }
            document.querySelectorAll('.more-menu.open').forEach(m => { if (m !== menu) m.classList.remove('open'); });
            menu.classList.toggle('open');
        }
        document.addEventListener('click', () => {
            document.querySelectorAll('.more-menu.open').forEach(m => m.classList.remove('open'));
        });

        // ?? Delete ??
        let companyIdToDelete = null;

        function deleteCompany(id) {
            companyIdToDelete = id;
            document.getElementById('deleteModal').classList.add('show');
        }
        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('show');
            companyIdToDelete = null;
        }
        function confirmDelete() {
            if (!companyIdToDelete) return;
            closeDeleteModal();
            fetch('/Web/Company/DeleteCompany?id=' + companyIdToDelete, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            })
            .then(r => {
                if (r.ok) { showToast(); setTimeout(() => location.reload(), 2000); }
                else { alert('Failed to delete. Please try again.'); }
            })
            .catch(() => alert('An error occurred.'));
        }

        // ?? Toast ??
        function showToast() {
            const t = document.getElementById('successToast');
            t.classList.add('show');
            setTimeout(() => { t.classList.remove('show'); }, 3000);
        }

        // ?? Logout ??
        function logout() {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("Logout", "Account")';
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                const inp = document.createElement('input');
                inp.type = 'hidden'; inp.name = '__RequestVerificationToken'; inp.value = token.value;
                form.appendChild(inp);
            }
            document.body.appendChild(form);
            form.submit();
        }
    </script>
</body>
</html>
