                <td class="col-qty"><input name="Bill.BillItems[${itemIndex}].Quantity" type="number" step="0.01" class="form-control-sm qty-input" onchange="calculateItemAmount(${itemIndex})" /></td>`;

            if (transactionSettings.freeItemQuantity) {
