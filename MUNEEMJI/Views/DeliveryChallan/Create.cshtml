        function removeRow(index) {
            const row = document.querySelector(`tr[data-index="${index}"]`);
            if (row) {
                row.remove();
                updateGrandTotal();
            }
        }

        function calculateItemAmount(index) {

            const row = document.querySelector(`tr[data-index="${index}"]`);
            if (!row) return;

            const quantity = parseFloat(row.querySelector('.qty-input').value) || 0;
            const pricePerUnit = parseFloat(row.querySelector('.price-input').value) || 0;
            const discountPercentage = parseFloat(row.querySelector('.discount-input').value) || 0;
            const CessAmount = parseFloat(row.querySelector('.cess-input').value) || 0;
            const taxSelect = row.querySelector('.tax-select').value;

            const subtotal = quantity * pricePerUnit;
            const discountAmount = subtotal * (discountPercentage / 100);
            const afterDiscount = subtotal - discountAmount;

            let taxRate = 0;

                taxRate = parseFloat(taxSelect) || 0;


            const taxAmount = afterDiscount * (taxRate / 100);
            const finalAmount = afterDiscount + taxAmount + CessAmount;

            row.querySelector('.discount-amount').value = discountAmount.toFixed(2);
            row.querySelector('.tax-amount').value = taxAmount.toFixed(2);
            row.querySelector('.total-amount').value = finalAmount.toFixed(2);

            updateGrandTotal();
        }

        function updateGrandTotal() {


            let total = 0;
            document.querySelectorAll('.total-amount').forEach(input => {
                total += parseFloat(input.value) || 0;
            });

            document.getElementById('grandTotal').textContent = total.toFixed(2);



            const TotalDiscount = document.querySelector('.total-discount');
            const discountValueInput = document.querySelector('.total-discountvalue');

            const shipingValueInput = document.querySelector('.shipping-value');
            const packingValueInput = document.querySelector('.packing-value');
            const adjustValueInput = document.querySelector('.adjustment-value');

            const shipingShow = document.querySelector('.shipping-show');
            const packingShow = document.querySelector('.packing-show');
            const adjustShow = document.querySelector('.adjustment-show');

            const discountPercentage = parseFloat(TotalDiscount.value) || 0;

            const TotalDiscountvalue =  total * (discountPercentage/100);

            discountValueInput.value  =  TotalDiscountvalue.toFixed(2);
            total = total-TotalDiscountvalue.toFixed(2);

             const shippingvalue = parseFloat(shipingValueInput.value) || 0;
             shipingShow.textContent =  shippingvalue.toFixed(2);
             const packingvalue = parseFloat(packingValueInput.value) || 0;
             packingShow.textContent  = packingvalue.toFixed(2);
             const adjustvalue = parseFloat(adjustValueInput.value) || 0;
             adjustShow.textContent=  adjustvalue.toFixed(2);

                     total = total + shippingvalue + packingvalue + adjustvalue;
                     total = total.toFixed(2);



            const roundOff = document.querySelector('input[name="Bill.IsRoundOff"]').checked;
            let finalTotal = roundOff ? Math.round(total) : total;
            let roundOffAmount = finalTotal - total;

             const totalbalance = document.querySelector('.total-balance');
             totalbalance.value =  finalTotal.toFixed(2);

             const receivedElement = document.querySelector('.received-amount');
             const receivedamount = parseFloat(receivedElement.value) || 0;
             const finalamount =  finalTotal-receivedamount;
            document.getElementById('finalTotal').textContent = finalamount.toFixed(2);
            document.getElementById('finalTotalinput').value =  finalamount.toFixed(2);
        }

        // Initialize calculations on page load
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.item-row').forEach((row, index) => {
                calculateItemAmount(index);
            });
        });

        // Handle round off checkbox change
        document.querySelector('input[name="Bill.IsRoundOff"]').addEventListener('change', updateGrandTotal);
    </script>
