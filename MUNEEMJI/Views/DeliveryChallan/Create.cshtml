    <script>

        document.addEventListener('DOMContentLoaded', function() {
            initializePopover();
        });

        function initializePopover() {

            const columnToggleBtn = document.getElementById('columnToggleBtn');
            const columnSettingsContent = document.getElementById('columnSettingsContent');

            if (columnToggleBtn && columnSettingsContent) {
                // Create popover instance
                const popover = new bootstrap.Popover(columnToggleBtn, {
                    content: function() {
                        return columnSettingsContent.innerHTML;
                    },
                    html: true,
                    placement: 'bottom',
                    trigger: 'click',
                    title: 'Column Settings',
                    sanitize: false
                });

                // Handle checkbox changes in popover content
                columnToggleBtn.addEventListener('shown.bs.popover', function() {
                    const popoverElement = document.querySelector('.popover');
                    if (popoverElement) {
                        const checkboxes = popoverElement.querySelectorAll('input[type="checkbox"]');

                    }
                });

                // Handle clicks outside to close popover
                document.addEventListener('click', function(event) {
                    if (!columnToggleBtn.contains(event.target) && !event.target.closest('.popover')) {
                        popover.hide();
                    }
                });
            }
        }

                function saveColumnSettingsFromPopover() {

            const popoverElement = document.querySelector('.popover');
            if (!popoverElement) {
                console.error("Popover not found");
                return;
            }

            // Get checkboxes from the popover
            const categoryEl = popoverElement.querySelector('#col-category-popup');
            const itemCodeEl = popoverElement.querySelector('#col-item-code-popup');
            const hsnEl = popoverElement.querySelector('#col-hsn-popup');
            const descriptionEl = popoverElement.querySelector('#col-description-popup');
            const discountEl = popoverElement.querySelector('#col-discount-pct-popup');

            // Check if elements exist
            if (!categoryEl || !itemCodeEl || !hsnEl || !descriptionEl || !discountEl) {
                console.error("Some checkbox elements are missing from popover");
                return;
            }

            // Collect checkbox values
            const model = {
                ItemCategory: categoryEl.checked,
                ItemCode: itemCodeEl.checked,
                HsnSacCode: hsnEl.checked,
                Description: descriptionEl.checked,
                ItemWiseDiscount: discountEl.checked
            };

            console.log("Model being sent from popover:", model);

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch('/Settings/ItemSettings/SaveOrUpdateColumnSettings', {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": token
                },
                body: JSON.stringify(model)
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    if (data.redirectUrl) {
                        window.location.href = '/DeliveryChallan/Create';
                    } else {
                        alert('Settings saved successfully!');
                    }
                } else {
                    alert("Failed: " + data.message);
                }
            })
            .catch(error => {
                console.error("Error:", error);
                alert("An error occurred while saving settings: " + error.message);
            });
        }

               function saveColumnSettings() {

            // Get checkboxes from the column settings container (not from popover)
            const categoryEl = document.querySelector('#col-category-popup');
            const itemCodeEl = document.querySelector('#col-item-code-popup');
            const hsnEl = document.querySelector('#col-hsn-popup');
            const descriptionEl = document.querySelector('#col-description-popup');
            const discountEl = document.querySelector('#col-discount-pct-popup');

            // Check if elements exist
            if (!categoryEl || !itemCodeEl || !hsnEl || !descriptionEl || !discountEl) {
                console.error("Some checkbox elements are missing");
                return;
            }

            // Collect checkbox values
            const model = {
                ItemCategory: categoryEl.checked,
                ItemCode: itemCodeEl.checked,
                HsnSacCode: hsnEl.checked,
                Description: descriptionEl.checked,
                ItemWiseDiscount: discountEl.checked
            };

            console.log("Model being sent:", model);

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch('/Settings/ItemSettings/SaveOrUpdateColumnSettings', {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": token
                },
                body: JSON.stringify(model)
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    if (data.redirectUrl) {
                        window.location.href = '/DeliveryChallan/Create';
                    } else {
                        // Hide the settings container after successful save
                        document.getElementById('columnSettingsContainer').style.display = 'none';
                        alert('Settings saved successfully!');
                    }
                } else {
                    alert("Failed: " + data.message);
                }
            })
            .catch(error => {
                console.error("Error:", error);
                alert("An error occurred while saving settings: " + error.message);
            });
        }

    </script>
