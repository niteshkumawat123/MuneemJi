                function selectItemFromTablePopdorp(index, itemId, itemName) {
            // Update button text
            debugger;
            const button = document.getElementById(`itemBtnPopdorp-${index}`);
            if (button) {
                button.textContent = itemName;
            }

            // Update hidden select
            const hiddenSelect = document.getElementById(`hiddenSelectPopdorp-${index}`);
            if (hiddenSelect) {
                hiddenSelect.value = itemId;

                // Mark the selected option
                const options = hiddenSelect.querySelectorAll('option');
                options.forEach(option => {
                    if (option.value === itemId) {
                        option.selected = true;
                    } else {
                        option.selected = false;
                    }
                });
            }

            // Auto-fill item data
            autoFillItemData(index, itemId);

            // Remove dropdown
            const dropdown = document.getElementById('floatingDropdownPopdorp');
            if (dropdown) {
                dropdown.remove();
            }

            // Trigger change event
            if (hiddenSelect) {
                onItemChange(hiddenSelect, index);
            }
