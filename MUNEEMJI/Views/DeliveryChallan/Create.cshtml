    <script>
        let calculatorCurrentInput = '0';
        let calculatorOperator = '';
        let calculatorPreviousInput = '';
        let calculatorWaitingForOperand = false;

        function calculatorUpdateDisplay() {
            const display = document.getElementById('calculatorDisplay');
            display.value = calculatorCurrentInput;
        }

               function calculatorAppendNumber(number) {
            if (calculatorWaitingForOperand) {
                calculatorCurrentInput = calculatorCurrentInput + number;
                calculatorWaitingForOperand = false;
            } else {
                calculatorCurrentInput = calculatorCurrentInput === '0' ? number : calculatorCurrentInput + number;
            }
            calculatorUpdateDisplay();
        }

        function calculatorAppendDecimal() {
            if (calculatorWaitingForOperand) {
                calculatorCurrentInput = '0.';
                calculatorWaitingForOperand = false;
            } else if (calculatorCurrentInput.indexOf('.') === -1) {
                calculatorCurrentInput += '.';
            }
            calculatorUpdateDisplay();
        }

              function calculatorAppendOperator(nextOperator) {
            const inputValue = parseFloat(calculatorCurrentInput);

            if (calculatorPreviousInput === '') {
                calculatorPreviousInput = inputValue;
            } else if (calculatorOperator) {
                const result = calculatorPerformCalculation();

                if (result === null) {
                    return;
                }

                calculatorCurrentInput = String(result);
                calculatorPreviousInput = result;
            }

            // Show current number with operator
            calculatorCurrentInput = calculatorCurrentInput + nextOperator;
            calculatorWaitingForOperand = true;
            calculatorOperator = nextOperator;
            calculatorUpdateDisplay();
        }

        function calculatorCalculate() {
            if (calculatorPreviousInput === '' || calculatorOperator === '' || calculatorWaitingForOperand) {
                return;
            }

            const result = calculatorPerformCalculation();

            if (result === null) {
                return;
            }

            calculatorCurrentInput = String(result);
            calculatorPreviousInput = '';
            calculatorOperator = '';
            calculatorWaitingForOperand = true;
            calculatorUpdateDisplay();
        }

               function calculatorPerformCalculation() {
            let prev, current;

            // If we have the full expression in calculatorCurrentInput (like "77+3")
            if (calculatorCurrentInput.includes(calculatorOperator)) {
                const parts = calculatorCurrentInput.split(calculatorOperator);
                prev = parseFloat(parts[0]);
                current = parseFloat(parts[1]);
            } else {
                // Fallback to the old way
                prev = parseFloat(calculatorPreviousInput);
                current = parseFloat(calculatorCurrentInput);
            }

            let result;

            switch (calculatorOperator) {
                case '+':
                    result = prev + current;
                    break;
                case '-':
                    result = prev - current;
                    break;
                case '*':
                    result = prev * current;
                    break;
                case '/':
                    if (current === 0) {
                        alert('Cannot divide by zero!');
                        return null;
                    }
                    result = prev / current;
                    break;
                default:
                    return null;
            }

            return Math.round((result + Number.EPSILON) * 100000000) / 100000000;
        }

        function calculatorClearAll() {
            calculatorCurrentInput = '';
            calculatorPreviousInput = '';
            calculatorOperator = '';
            calculatorWaitingForOperand = false;
            calculatorUpdateDisplay();
        }

        function calculatorClearEntry() {
            calculatorCurrentInput = '';
            calculatorUpdateDisplay();
        }

        function calculatorDeleteLast() {
            if (calculatorCurrentInput.length > 1) {
                calculatorCurrentInput = calculatorCurrentInput.slice(0, -1);
            } else {
                calculatorCurrentInput = '0';
            }
            calculatorUpdateDisplay();
        }

        function calculatorOpen() {
                 // Reset calculator to initial state
        calculatorCurrentInput = '0';
        calculatorPreviousInput = '';
        calculatorOperator = '';
        calculatorWaitingForOperand = false;
        calculatorUpdateDisplay();
            document.getElementById('calculatorModal').style.display = 'flex';
            document.body.style.overflow = 'hidden'; // Prevent background scrolling
        }

        function calculatorClose() {
            document.getElementById('calculatorModal').style.display = 'none';
            document.body.style.overflow = ''; // Restore background scrolling
        }

        // Keyboard support for calculator
        document.addEventListener('keydown', function(event) {
            const modal = document.getElementById('calculatorModal');
            if (!modal || modal.style.display === 'none') return;

            const key = event.key;

            if (key >= '0' && key <= '9') {
                calculatorAppendNumber(key);
            } else if (key === '.') {
                calculatorAppendDecimal();
            } else if (key === '+' || key === '-') {
                calculatorAppendOperator(key);
            } else if (key === '*') {
                calculatorAppendOperator('*');
            } else if (key === '/') {
                event.preventDefault();
                calculatorAppendOperator('/');
            } else if (key === 'Enter' || key === '=') {
                calculatorCalculate();
            } else if (key === 'Escape') {
                calculatorClose();
            } else if (key === 'Backspace') {
                calculatorDeleteLast();
            } else if (key === 'Delete') {
                calculatorClearEntry();
            }
        });

