                function initializeSelectedItems() {
            document.querySelectorAll('.item-row').forEach((row, index) => {
                const hiddenSelect = row.querySelector(`select[id="hiddenSelectPopdorp-${index}"]`);
                const button = row.querySelector(`button[id="itemBtnPopdorp-${index}"]`);

                if (hiddenSelect && button) {
                    const selectedOption = hiddenSelect.querySelector('option:checked') || hiddenSelect.querySelector('option[selected]');
                    if (selectedOption && selectedOption.value) {
                        // Update button text with selected item name
                        button.textContent = selectedOption.textContent;

                        // Trigger auto-fill for the selected item
                        const selectedItemId = selectedOption.value;
                        if (selectedItemId) {
                            autoFillItemData(index, selectedItemId);
                        }
                    }
                }
            });
        }

