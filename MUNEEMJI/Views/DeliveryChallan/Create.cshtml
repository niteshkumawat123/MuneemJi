                              function autoFillItemData(rowIndex, itemId) {
            const selectedItem = itemOptions.find(item => item.id == itemId);
            if (!selectedItem) return;

            const row = document.querySelector(`tr[data-index="${rowIndex}"]`);
            if (!row) return;

            // Auto-fill the fields based on item data
            const itemCodeInput = row.querySelector('input[name*="ItemCode"]');
            if (itemCodeInput && selectedItem.itemCode) {
                itemCodeInput.value = selectedItem.itemCode;
            }

            const hsnCodeInput = row.querySelector('input[name*="HSNCode"]');
            if (hsnCodeInput && selectedItem.itemHsn) {
                hsnCodeInput.value = selectedItem.itemHsn;
            }

            const mrpInput = row.querySelector('input[name*="MRP"]');
            if (mrpInput && selectedItem.mrp) {
                mrpInput.value = selectedItem.mrp;
            }

            // Only auto-fill price if current value is empty or 0
            const priceInput = row.querySelector('input[name*="PricePerUnit"]');
            if (priceInput) {
                const currentPrice = parseFloat(priceInput.value) || 0;
                if (currentPrice === 0 && selectedItem.salePrice) {
                    priceInput.value = selectedItem.salePrice;
                }
                // If currentPrice is not 0, keep the existing value from database
            }

            // Only set quantity to 1 if it's empty or 0
            const qtyInput = row.querySelector('input[name*="Quantity"]');
            if (qtyInput && (!qtyInput.value || qtyInput.value == 0)) {
                qtyInput.value = 1;
            }

            calculateItemAmount(rowIndex);
        }




