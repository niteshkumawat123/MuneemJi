@model Godown

@{
    ViewData["Title"] = "Add New Godown";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .input-validation-error {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
    }
    .field-error-message {
        color: #dc3545;
        font-size: 12px;
        margin-top: 4px;
        display: none;
    }
    .input-validation-success {
        border-color: #28a745 !important;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-0">Add New Godown</h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Manage Godowns</a></li>
                            <li class="breadcrumb-item active">Add New Godown</li>
                        </ol>
                    </nav>
                </div>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-plus me-2"></i>
                        Add New Godown
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" id="godownForm">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="GodownType" class="form-label">Godown Type <span class="text-danger">*</span></label>
                                <select asp-for="GodownType" class="form-select" required>
                                    <option value="">Select</option>
                                    <option value="Retail Store">Retail Store</option>
                                    <option value="Warehouse">Warehouse</option>
                                    <option value="Distribution Center">Distribution Center</option>
                                    <option value="Manufacturing Unit">Manufacturing Unit</option>
                                    <option value="Cold Storage">Cold Storage</option>
                                    <option value="Others">Others</option>
                                </select>
                                <span asp-validation-for="GodownType" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="GodownName" class="form-label">Godown Name <span class="text-danger">*</span></label>
                                <input asp-for="GodownName" type="text" class="form-control" placeholder="Enter Godown Name" required>
                                <span asp-validation-for="GodownName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNo" class="form-label">Phone No <span class="text-danger">*</span></label>
                                <input asp-for="PhoneNo" type="tel" class="form-control" required maxlength="10" oninput="validatePhoneField(this)">
                                <span asp-validation-for="PhoneNo" class="text-danger"></span>
                                <div class="field-error-message" id="phoneError">Please enter a valid 10-digit phone number</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EmailId" class="form-label">Email ID</label>
                                <input asp-for="EmailId" type="email" class="form-control" oninput="validateEmailField(this)">
                                <span asp-validation-for="EmailId" class="text-danger"></span>
                                <div class="field-error-message" id="emailError">Please enter a valid email address</div>
                            </div>
                        </div>

                        <h6 class="mt-4 mb-3">More Information</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="GSTIN" class="form-label">GSTIN</label>
                                <input asp-for="GSTIN" type="text" class="form-control" maxlength="15" style="text-transform:uppercase;" oninput="validateGstinField(this)">
                                <span asp-validation-for="GSTIN" class="text-danger"></span>
                                <div class="field-error-message" id="gstinError">GSTIN must be exactly 15 characters (e.g., 22AAAAA0000A1Z5)</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="GodownPincode" class="form-label">Godown Pincode</label>
                                <input asp-for="GodownPincode" type="text" class="form-control">
                                <span asp-validation-for="GodownPincode" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="GodownAddress" class="form-label">Godown Address</label>
                            <textarea asp-for="GodownAddress" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="GodownAddress" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-save me-2"></i>
                                Save Godown
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function isValidEmail(email) {
            return /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email);
        }
        function isValidPhone(phone) {
            return /^[0-9]{10}$/.test(phone);
        }
        function isValidGstin(gstin) {
            return /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/.test(gstin);
        }
        function setFieldError(input, errorEl, show) {
            if (show) {
                input.classList.add('input-validation-error');
                input.classList.remove('input-validation-success');
                if (errorEl) errorEl.style.display = 'block';
            } else {
                input.classList.remove('input-validation-error');
                if (input.value.trim().length > 0) {
                    input.classList.add('input-validation-success');
                } else {
                    input.classList.remove('input-validation-success');
                }
                if (errorEl) errorEl.style.display = 'none';
            }
        }
        function validatePhoneField(input) {
            var val = input.value.replace(/[^0-9]/g, '');
            input.value = val;
            var errorEl = document.getElementById('phoneError');
            if (val.length === 0) { setFieldError(input, errorEl, false); }
            else if (!isValidPhone(val)) { setFieldError(input, errorEl, true); }
            else { setFieldError(input, errorEl, false); }
        }
        function validateEmailField(input) {
            var val = input.value.trim();
            var errorEl = document.getElementById('emailError');
            if (val.length === 0) { setFieldError(input, errorEl, false); }
            else if (!isValidEmail(val)) { setFieldError(input, errorEl, true); }
            else { setFieldError(input, errorEl, false); }
        }
        function validateGstinField(input) {
            input.value = input.value.toUpperCase();
            var val = input.value.trim();
            var errorEl = document.getElementById('gstinError');
            if (val.length === 0) { setFieldError(input, errorEl, false); }
            else if (val.length !== 15 || !isValidGstin(val)) { setFieldError(input, errorEl, true); }
            else { setFieldError(input, errorEl, false); }
        }
        document.getElementById('godownForm').addEventListener('submit', function(e) {
            var isValid = true;
            var phoneInput = document.getElementById('PhoneNo');
            var emailInput = document.getElementById('EmailId');
            var gstinInput = document.getElementById('GSTIN');
            if (phoneInput && phoneInput.value.trim().length > 0 && !isValidPhone(phoneInput.value.trim())) {
                setFieldError(phoneInput, document.getElementById('phoneError'), true);
                isValid = false;
            }
            if (emailInput && emailInput.value.trim().length > 0 && !isValidEmail(emailInput.value.trim())) {
                setFieldError(emailInput, document.getElementById('emailError'), true);
                isValid = false;
            }
            if (gstinInput && gstinInput.value.trim().length > 0 && (gstinInput.value.trim().length !== 15 || !isValidGstin(gstinInput.value.trim()))) {
                setFieldError(gstinInput, document.getElementById('gstinError'), true);
                isValid = false;
            }
            if (!isValid) { e.preventDefault(); }
        });
    </script>
}