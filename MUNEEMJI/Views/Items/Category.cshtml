@model ItemViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Category";
}

<header>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
</header>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: white;
        min-height: 100vh;
    }

    .cat-main-wrapper {
        margin: 0;
        background: white;
        display: flex;
        flex-direction: column;
        height: calc(100vh - 65px);
        overflow: hidden;
    }

    /* Navigation Tabs */
    .cat-header-navigation {
        background: #fff;
        border-bottom: 2px solid #e9ecef;
        display: flex;
        flex-shrink: 0;
        z-index: 10;
        width: 100%;
    }

    .cat-nav-tab {
        padding: 14px 0;
        cursor: pointer;
        border-bottom: 3px solid transparent;
        color: #6c757d;
        font-weight: 600;
        font-size: 13px;
        transition: all 0.3s ease;
        text-decoration: none;
        display: block;
        white-space: nowrap;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        flex: 1;
        text-align: center;
    }

    .cat-nav-tab.active {
        color: #007bff;
        border-bottom-color: #007bff;
        background: white;
    }

    .cat-nav-tab:hover {
        color: #495057;
        text-decoration: none;
    }

    /* Content Layout */
    .cat-content-wrapper {
        display: flex;
        flex: 1;
        overflow: hidden;
        min-height: 0;
        min-width: 0;
    }

    /* Left Sidebar */
    .cat-sidebar-panel {
        width: 280px;
        min-width: 220px;
        background: #fff;
        border-right: 1px solid #e9ecef;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        min-height: 0;
        z-index: 20;
    }

    /* Toolbar */
    .cat-toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        border-bottom: 1px solid #e9ecef;
    }

    .cat-search-btn {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1px solid #dee2e6;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        transition: border-color 0.2s;
    }

    .cat-search-btn:hover {
        border-color: #007bff;
    }

    .cat-search-btn i {
        font-size: 14px;
        color: #6c757d;
    }

    .cat-add-btn {
        flex: 1;
        background: linear-gradient(45deg, #ff9500, #ffb347);
        color: white;
        border: none;
        padding: 7px 14px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        white-space: nowrap;
        transition: opacity 0.2s;
    }

    .cat-add-btn:hover {
        opacity: 0.9;
    }

    /* Inline search */
    .cat-inline-search {
        display: none;
        padding: 8px 12px;
        border-bottom: 1px solid #e9ecef;
    }

    .cat-inline-search.active {
        display: block;
    }

    .cat-inline-search input {
        width: 100%;
        padding: 6px 10px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 13px;
        outline: none;
    }

    .cat-inline-search input:focus {
        border-color: #007bff;
        box-shadow: 0 0 0 2px rgba(0,123,255,0.1);
    }

    /* Category List */
    .cat-items-container {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        min-height: 0;
    }

    .cat-list-header {
        display: flex;
        padding: 8px 12px;
        font-weight: 600;
        color: #495057;
        font-size: 11px;
        text-transform: uppercase;
        border-bottom: 1px solid #e9ecef;
        position: sticky;
        top: 0;
        background: #fff;
        z-index: 2;
    }

    .cat-list-header-name {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
    }

    .cat-list-header-count {
        width: 50px;
        text-align: right;
        flex-shrink: 0;
        font-weight: 600;
    }

    .cat-list-header-dots {
        width: 24px;
        flex-shrink: 0;
    }

    .cat-entry {
        display: flex;
        padding: 10px 12px;
        align-items: center;
        border-bottom: 1px solid #f5f5f5;
        transition: background 0.2s;
        cursor: pointer;
        gap: 4px;
    }

    .cat-entry:hover {
        background: #f0f7ff;
    }

    .cat-entry.selected {
        background: #e3f2fd;
        border-left: 3px solid #2196f3;
        padding-left: 9px;
    }

    .cat-entry .cat-name {
        flex: 1;
        font-size: 13px;
        color: #333;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
    }

    .cat-entry .cat-count {
        width: 50px;
        text-align: right;
        font-size: 13px;
        font-weight: 600;
        color: #333;
        flex-shrink: 0;
    }

    .cat-entry .cat-dots {
        width: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: none;
        background: none;
        cursor: pointer;
        padding: 0;
        color: #6c757d;
    }

    .cat-entry .cat-dots:hover {
        color: #333;
    }

    /* Right Detail Section */
    .cat-detail-section {
        flex: 1;
        overflow: auto;
        display: flex;
        flex-direction: column;
        min-height: 0;
        min-width: 0;
        background: #f8f9fa;
    }

    .cat-detail-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 16px 24px;
        background: #fff;
        border-bottom: 1px solid #e9ecef;
        flex-shrink: 0;
        gap: 10px;
    }

    .cat-detail-title-block {
        min-width: 0;
    }

    .cat-detail-title {
        font-size: 16px;
        font-weight: 700;
        color: #2c3e50;
        text-transform: uppercase;
        margin: 0;
    }

    .cat-detail-count {
        font-size: 14px;
        color: #6c757d;
        margin: 2px 0 0 0;
    }

    .cat-move-btn {
        background: linear-gradient(45deg, #ff9500, #ffb347);
        color: #fff;
        border: none;
        padding: 8px 18px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        white-space: nowrap;
        flex-shrink: 0;
        transition: opacity 0.2s;
    }

    .cat-move-btn:hover {
        opacity: 0.9;
    }

    /* Items area */
    .cat-items-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 16px 24px;
        min-height: 0;
        overflow: hidden;
    }

    .cat-items-heading-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .cat-items-heading {
        font-size: 14px;
        font-weight: 700;
        color: #2c3e50;
        text-transform: uppercase;
        margin: 0;
    }

    .cat-items-search {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }

    .cat-items-search input {
        padding: 5px 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 13px;
        width: 160px;
        max-width: 100%;
        outline: none;
    }

    .cat-items-search input:focus {
        border-color: #007bff;
    }

    .cat-items-search .search-icon-sm {
        color: #999;
        font-size: 14px;
    }

    .cat-table-wrapper {
        flex: 1;
        overflow: auto;
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 4px;
    }

    .cat-table-wrapper table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .cat-table-wrapper th {
        background: #f8f9fa;
        color: #6c757d;
        padding: 10px 12px;
        text-align: left;
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        border-bottom: 1px solid #e9ecef;
        white-space: nowrap;
    }

    .cat-table-wrapper td {
        padding: 12px;
        border-bottom: 1px solid #f1f3f4;
        color: #333;
    }

    .cat-table-wrapper tr:hover {
        background: #f8f9ff;
    }

    .cat-no-data {
        text-align: center;
        padding: 40px 20px;
        color: #6c757d;
        font-size: 13px;
    }

    .cat-loading-state {
        display: flex;
        justify-content: center;
        align-items: center;
        flex: 1;
        color: #6c757d;
        text-align: center;
    }

    .qty-col {
        color: #ff9500;
        font-weight: 600;
    }

    .stock-col {
        text-align: right;
        color: #333;
    }

    /* Popover styles */
    .popover {
        border: 1px solid #ddd;
        border-radius: 6px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.12);
        min-width: 140px;
    }

    .popover-body {
        padding: 0;
    }

    .popover-action {
        display: block;
        padding: 10px 16px;
        text-decoration: none;
        color: #333;
        cursor: pointer;
        border-bottom: 1px solid #f0f0f0;
        font-size: 13px;
        transition: background-color 0.15s;
    }

    .popover-action:last-child {
        border-bottom: none;
    }

    .popover-action:hover {
        background-color: #f8f9fa;
        color: #333;
        text-decoration: none;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .cat-sidebar-panel {
            width: 220px;
            min-width: 180px;
        }

        .cat-items-area {
            padding: 10px 14px;
        }
    }

    @@media (max-width: 768px) {
        .cat-main-wrapper {
            height: auto;
            min-height: 100vh;
        }

        .cat-content-wrapper {
            flex-direction: column;
        }

        .cat-sidebar-panel {
            width: 100%;
            min-width: unset;
            max-height: 40vh;
            border-right: none;
            border-bottom: 1px solid #e9ecef;
        }

        .cat-detail-section {
            min-height: 60vh;
        }
    }

    @@media (max-width: 576px) {
        .cat-nav-tab {
            font-size: 11px;
            padding: 10px 0;
        }

        .cat-toolbar {
            padding: 8px 10px;
        }

        .cat-add-btn {
            font-size: 12px;
            padding: 6px 10px;
        }

        .cat-entry {
            padding: 8px 10px;
        }
    }
</style>

<div class="cat-main-wrapper">
    <!-- Navigation Tabs -->
    <div class="cat-header-navigation">
        <a href="/Web/Items/Products" class="cat-nav-tab">PRODUCTS</a>
        <a href="/Web/Services/Service" class="cat-nav-tab">SERVICES</a>
        <a href="/Web/Items/Category" class="cat-nav-tab active">CATEGORY</a>
        <a href="/Web/Units/Unit" class="cat-nav-tab">UNITS</a>
    </div>

    <!-- Content -->
    <div class="cat-content-wrapper">
        <!-- Left Sidebar -->
        <div class="cat-sidebar-panel">
            <!-- Toolbar -->
            <div class="cat-toolbar">
                <button class="cat-search-btn" id="catToggleSearchBtn" title="Search">
                    <i class="bi bi-search"></i>
                </button>
                <button class="cat-add-btn" onclick="openAddCategoryModal();">
                    <i class="bi bi-plus"></i> Add Category
                </button>
            </div>

            <!-- Inline search (hidden by default) -->
            <div class="cat-inline-search" id="catInlineSearchBox">
                <input type="text" id="cat-search" placeholder="Search categories..." autofocus>
            </div>

            <!-- Category List -->
            <div class="cat-items-container">
                <div class="cat-list-header">
                    <div class="cat-list-header-name">CATEGORY</div>
                    <div class="cat-list-header-count">ITEM</div>
                    <div class="cat-list-header-dots"></div>
                </div>

                <!-- Items not in any category -->
                <div class="cat-entry selected" data-cat-id="0" data-cat-name="Items not in any Category">
                    <span class="cat-name">Items not in any Category</span>
                    <span class="cat-count">@(Model.ItemView?.Count ?? 0)</span>
                    <button type="button" class="cat-dots"
                            data-bs-toggle="popover"
                            data-bs-placement="left"
                            data-bs-trigger="click"
                            data-bs-html="true"
                            data-bs-content=''>
                        <i class="bi bi-three-dots-vertical" style="font-size:14px;"></i>
                    </button>
                </div>

                @if (Model.Categories != null && Model.Categories.Any())
                {
                    @foreach (var category in Model.Categories)
                    {
                        <div class="cat-entry" data-cat-id="@category.Id" data-cat-name="@category.Name">
                            <span class="cat-name">@category.Name</span>
                            <span class="cat-count">@category.itemCount</span>
                            <button type="button" class="cat-dots"
                                    data-bs-toggle="popover"
                                    data-bs-placement="left"
                                    data-bs-trigger="click"
                                    data-bs-html="true"
                                    data-bs-content='<a href="#" class="popover-action" onclick="editCategory(@category.Id, &quot;@category.Name&quot;); return false;">Edit</a><a href="#" class="popover-action" onclick="deleteCategory(@category.Id); return false;">Delete</a>'>
                                <i class="bi bi-three-dots-vertical" style="font-size:14px;"></i>
                            </button>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Right Detail -->
        <div class="cat-detail-section" id="cat-detail-area">
            <div class="cat-detail-header">
                <div class="cat-detail-title-block">
                    <h2 class="cat-detail-title" id="cat-title">ITEMS NOT IN ANY CATEGORY</h2>
                    <p class="cat-detail-count" id="cat-subtitle">@(Model.ItemView?.Count ?? 0)</p>
                </div>
                <button class="cat-move-btn" id="moveToCategoryBtn">Move To This Category</button>
            </div>

            <div class="cat-items-area">
                <div class="cat-items-heading-row">
                    <h3 class="cat-items-heading">ITEMS</h3>
                    <div class="cat-items-search">
                        <i class="bi bi-search search-icon-sm"></i>
                        <input type="text" id="catItemSearch" placeholder="Search items...">
                    </div>
                </div>

                <div class="cat-table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>NAME <i class="bi bi-funnel" style="font-size:9px;"></i></th>
                                <th>QUANTITY <i class="bi bi-funnel" style="font-size:9px;"></i></th>
                                <th style="text-align:right;">STOCK VALUE <i class="bi bi-funnel" style="font-size:9px;"></i></th>
                            </tr>
                        </thead>
                        <tbody id="cat-items-tbody">
                            @if (Model.ItemView != null && Model.ItemView.Any())
                            {
                                @foreach (var item in Model.ItemView)
                                {
                                    <tr>
                                        <td>@item.ItemName</td>
                                        <td class="qty-col">@item.OpeningQuantity</td>
                                        <td class="stock-col">&#8377; @((item.OnlineStorePrice ?? 0).ToString("0.00"))</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="cat-no-data">No items to show</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 12px; border: none;">
            <div class="modal-header" style="border-bottom: none; padding: 20px 24px 10px;">
                <h5 class="modal-title" id="addCategoryModalLabel" style="font-weight: 600; color: #2c3e50;">Add Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 10px 24px 16px;">
                <div class="mb-3">
                    <label for="categoryNameInput" class="form-label" style="font-size: 12px; color: #6c757d; margin-bottom: 4px;">Enter Category Name</label>
                    <input type="hidden" id="categoryIdInput" value="0">
                    <input type="text"
                           class="form-control"
                           id="categoryNameInput"
                           placeholder="e.g., Grocery"
                           style="border-radius: 6px; padding: 8px 10px; border: 1px solid #dee2e6; font-size: 13px;"
                           maxlength="100">
                    <div class="invalid-feedback" id="categoryNameError" style="display: none;">
                        Please enter a category name
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top: none; padding: 8px 24px 16px;">
                <button type="button"
                        class="btn w-100"
                        id="saveCategoryBtn"
                        onclick="saveCategory();"
                        style="background-color: #dc3545; color: white; border: none; border-radius: 6px; padding: 8px; font-weight: 500; font-size: 13px;">
                    Create
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteCategoryModal" tabindex="-1" aria-labelledby="deleteCategoryModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 12px; border: none;">
            <div class="modal-header" style="border-bottom: none; padding: 20px 24px 10px;">
                <h5 class="modal-title" id="deleteCategoryModalLabel" style="font-weight: 600; color: #dc3545;">
                    <i class="bi bi-exclamation-triangle"></i> Delete Category
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 10px 24px 20px;">
                <p style="font-size: 14px; color: #6c757d; margin-bottom: 0;">
                    Are you sure you want to delete this category? This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer" style="border-top: none; padding: 8px 24px 16px; gap: 10px;">
                <button type="button"
                        class="btn"
                        data-bs-dismiss="modal"
                        style="background-color: #6c757d; color: white; border: none; border-radius: 6px; padding: 7px 16px; font-weight: 500; font-size: 13px; flex: 1;">
                    Cancel
                </button>
                <button type="button"
                        class="btn"
                        id="confirmDeleteBtn"
                        onclick="confirmDeleteCategory();"
                        style="background-color: #dc3545; color: white; border: none; border-radius: 6px; padding: 7px 16px; font-weight: 500; font-size: 13px; flex: 1;">
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Select Items Modal (Move to Category) -->
<div class="modal fade" id="selectItemsModal" tabindex="-1" aria-labelledby="selectItemsModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg" style="margin: auto; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); max-width: 600px; width: 90%;">
        <div class="modal-content" style="border-radius: 12px; border: none; max-height: 80vh; display: flex; flex-direction: column;">
            <div class="modal-header" style="border-bottom: 1px solid #e9ecef; padding: 16px 24px;">
                <h5 class="modal-title" id="selectItemsModalLabel" style="font-weight: 600; color: #2c3e50;">Select Items</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div style="padding: 12px 24px; border-bottom: 1px solid #e9ecef;">
                <div style="position: relative;">
                    <i class="bi bi-search" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #6c757d;"></i>
                    <input type="text" id="modalItemSearch" placeholder="Search items"
                           style="width: 100%; padding: 10px 10px 10px 36px; border: 2px solid #20c997; border-radius: 8px; font-size: 14px; outline: none;">
                </div>
            </div>
            <div class="modal-body" style="padding: 0; overflow-y: auto; flex: 1;">
                <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                    <thead style="position: sticky; top: 0; background: #fff; z-index: 2;">
                        <tr style="border-bottom: 1px solid #e9ecef;">
                            <th style="padding: 12px 16px; width: 40px;">
                                <input type="checkbox" id="selectAllItems" style="width: 16px; height: 16px; cursor: pointer;">
                            </th>
                            <th style="padding: 12px 8px; font-weight: 600; color: #495057; font-size: 13px;">
                                Item Name <i class="bi bi-chevron-expand" style="font-size: 10px; color: #adb5bd;"></i>
                            </th>
                            <th style="padding: 12px 16px; text-align: right; font-weight: 600; color: #495057; font-size: 13px;">
                                Quantity <i class="bi bi-chevron-expand" style="font-size: 10px; color: #adb5bd;"></i>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="modalItemsBody">
                        <tr><td colspan="3" style="text-align: center; padding: 40px; color: #6c757d;">Loading items...</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer" style="border-top: 1px solid #e9ecef; padding: 12px 24px; display: flex; align-items: center; justify-content: space-between;">
                <label style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: #6c757d; margin: 0; cursor: pointer;">
                    <input type="checkbox" id="removeFromExistingChk" style="width: 16px; height: 16px;">
                    Remove selected items from existing category
                </label>
                <div style="display: flex; gap: 10px;">
                    <button type="button" class="btn" data-bs-dismiss="modal"
                            style="background: #fff; border: 1px solid #dee2e6; color: #495057; border-radius: 8px; padding: 8px 20px; font-weight: 500;">
                        Cancel
                    </button>
                    <button type="button" class="btn" id="confirmMoveBtn" onclick="confirmMoveToCategory();"
                            style="background-color: #dc3545; color: white; border: none; border-radius: 8px; padding: 8px 20px; font-weight: 600;">
                        Move to this category
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Configure toastr
    toastr.options = {
        closeButton: true,
        progressBar: true,
        positionClass: 'toast-top-right',
        timeOut: 3000,
        showEasing: 'swing',
        hideEasing: 'linear',
        showMethod: 'fadeIn',
        hideMethod: 'fadeOut'
    };

    let categoryIdToDelete = null;
    let currentCategoryId = 'uncategorized';

    document.addEventListener('DOMContentLoaded', function () {
        initializePopovers();
        initCategoryHandlers();
        initCategorySearch();
        initToggleSearch();
        initItemSearch();
    });

    function initToggleSearch() {
        const toggleBtn = document.getElementById('catToggleSearchBtn');
        const searchBox = document.getElementById('catInlineSearchBox');
        if (toggleBtn && searchBox) {
            toggleBtn.addEventListener('click', function () {
                searchBox.classList.toggle('active');
                if (searchBox.classList.contains('active')) {
                    searchBox.querySelector('input').focus();
                }
            });
        }
    }

    function initializePopovers() {
        const popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
        popoverTriggerList.forEach(function (popoverTriggerEl) {
            new bootstrap.Popover(popoverTriggerEl, {
                sanitize: false,
                html: true,
                trigger: 'click'
            });
        });

        document.addEventListener('click', function (e) {
            if (!e.target.closest('[data-bs-toggle="popover"]') && !e.target.closest('.popover')) {
                const popovers = document.querySelectorAll('[data-bs-toggle="popover"]');
                popovers.forEach(popover => {
                    const bsPopover = bootstrap.Popover.getInstance(popover);
                    if (bsPopover) bsPopover.hide();
                });
            }
        });
    }

    function hideAllPopovers() {
        document.querySelectorAll('[data-bs-toggle="popover"]').forEach(el => {
            const p = bootstrap.Popover.getInstance(el);
            if (p) p.hide();
        });
    }

    function initCategoryHandlers() {
        const catEntries = document.querySelectorAll('.cat-entry');
        catEntries.forEach(entry => {
            entry.addEventListener('click', function (e) {
                if (e.target.closest('.cat-dots') || e.target.closest('[data-bs-toggle="popover"]') || e.target.closest('.popover')) return;
                const catId = this.getAttribute('data-cat-id');
                const catName = this.getAttribute('data-cat-name');
                catEntries.forEach(el => el.classList.remove('selected'));
                this.classList.add('selected');
                selectCategory(catId, catName);
            });
            entry.addEventListener('dblclick', function (e) {
                if (e.target.closest('.cat-dots') || e.target.closest('[data-bs-toggle="popover"]') || e.target.closest('.popover')) return;
                const catId = this.getAttribute('data-cat-id');
                const catName = this.getAttribute('data-cat-name');
                if (catId && catId !== '0') {
                    editCategory(parseInt(catId), catName);
                }
            });
        });
    }

    function initCategorySearch() {
        const searchInput = document.getElementById('cat-search');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const term = this.value.toLowerCase();
                document.querySelectorAll('.cat-entry').forEach(row => {
                    const name = row.querySelector('.cat-name')?.textContent.toLowerCase() || '';
                    row.style.display = name.includes(term) || term === '' ? '' : 'none';
                });
            });
        }
    }

    function initItemSearch() {
        const searchInput = document.getElementById('catItemSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const term = this.value.toLowerCase();
                document.querySelectorAll('#cat-items-tbody tr').forEach(row => {
                    const name = row.querySelector('td')?.textContent.toLowerCase() || '';
                    row.style.display = name.includes(term) || term === '' ? '' : 'none';
                });
            });
        }
    }

    function selectCategory(catId, catName) {
        currentCategoryId = catId;
        const titleEl = document.getElementById('cat-title');
        const subtitleEl = document.getElementById('cat-subtitle');
        const tbody = document.getElementById('cat-items-tbody');

        if (catId === '0' || catId === 'uncategorized') {
            titleEl.textContent = 'ITEMS NOT IN ANY CATEGORY';
        } else {
            titleEl.textContent = (catName || '').toUpperCase();
        }

        subtitleEl.textContent = 'Loading...';
        tbody.innerHTML = '<tr><td colspan="3" class="cat-no-data">Loading items...</td></tr>';

        fetch(`/Web/Items/GetItemsByCategory?categoryId=${catId}`, {
            method: 'GET',
            headers: { 'Accept': 'application/json' }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success && data.items) {
                subtitleEl.textContent = data.items.length;
                // Update sidebar count for this category
                const catEntry = document.querySelector(`.cat-entry[data-cat-id="${catId}"]`);
                if (catEntry) {
                    const countEl = catEntry.querySelector('.cat-count');
                    if (countEl) countEl.textContent = data.items.length;
                }
                if (data.items.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="3" class="cat-no-data">No items in this category</td></tr>';
                } else {
                    tbody.innerHTML = data.items.map(item => `
                        <tr>
                            <td>${item.itemName || ''}</td>
                            <td class="qty-col">${item.openingQuantity || 0}</td>
                            <td class="stock-col">&#8377; ${(item.onlineStorePrice || 0).toFixed(2)}</td>
                        </tr>
                    `).join('');
                }
            } else {
                subtitleEl.textContent = '0';
                tbody.innerHTML = '<tr><td colspan="3" class="cat-no-data">No items to show</td></tr>';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            subtitleEl.textContent = '0';
            tbody.innerHTML = '<tr><td colspan="3" class="cat-no-data">Error loading items</td></tr>';
        });
    }

    // Open Add Category Modal
    function openAddCategoryModal() {
        const modal = new bootstrap.Modal(document.getElementById('addCategoryModal'));
        document.getElementById('categoryIdInput').value = '0';
        document.getElementById('categoryNameInput').value = '';
        document.getElementById('categoryNameError').style.display = 'none';
        document.getElementById('categoryNameInput').classList.remove('is-invalid');
        document.getElementById('addCategoryModalLabel').textContent = 'Add Category';
        document.getElementById('saveCategoryBtn').textContent = 'Create';
        modal.show();
    }

    // Edit Category
    function editCategory(id, categoryName) {
        hideAllPopovers();
        const modal = new bootstrap.Modal(document.getElementById('addCategoryModal'));
        document.getElementById('categoryIdInput').value = id;
        document.getElementById('categoryNameInput').value = categoryName;
        document.getElementById('categoryNameError').style.display = 'none';
        document.getElementById('categoryNameInput').classList.remove('is-invalid');
        document.getElementById('addCategoryModalLabel').textContent = 'Edit Category';
        document.getElementById('saveCategoryBtn').textContent = 'Update';
        modal.show();
    }

    // Save Category
    function saveCategory() {
        const categoryId = document.getElementById('categoryIdInput').value;
        const categoryName = document.getElementById('categoryNameInput').value.trim();
        const errorDiv = document.getElementById('categoryNameError');
        const inputField = document.getElementById('categoryNameInput');
        const saveBtn = document.getElementById('saveCategoryBtn');
        const isUpdate = categoryId !== '0';

        if (!categoryName) {
            inputField.classList.add('is-invalid');
            errorDiv.style.display = 'block';
            errorDiv.textContent = 'Please enter a category name';
            return;
        }

        saveBtn.disabled = true;
        saveBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status"></span>${isUpdate ? 'Updating...' : 'Creating...'}`;

        fetch('/Web/Items/CategoryCreate', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({ Id: parseInt(categoryId), Name: categoryName })
        })
        .then(response => {
            if (!response.ok) throw new Error('Failed');
            return response.json();
        })
        .then(data => {
            if (data.success) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('addCategoryModal'));
                modal.hide();
                toastr.success(isUpdate ? 'Category updated successfully!' : 'Category created successfully!');
                setTimeout(() => location.reload(), 1500);
            } else {
                inputField.classList.add('is-invalid');
                errorDiv.style.display = 'block';
                errorDiv.textContent = data.message || 'Failed to save category.';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            toastr.error('Failed to save category. Please try again.');
        })
        .finally(() => {
            saveBtn.disabled = false;
            saveBtn.textContent = isUpdate ? 'Update' : 'Create';
        });
    }

    // Delete Category
    function deleteCategory(id) {
        hideAllPopovers();
        categoryIdToDelete = id;
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteCategoryModal'));
        deleteModal.show();
    }

    function confirmDeleteCategory() {
        if (!categoryIdToDelete) return;

        const deleteBtn = document.getElementById('confirmDeleteBtn');
        deleteBtn.disabled = true;
        deleteBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Deleting...';

        fetch(`/Web/Category/DeleteCategory?id=${categoryIdToDelete}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            }
        })
        .then(response => {
            if (!response.ok) throw new Error('Failed');
            return response.json();
        })
        .then(data => {
            const deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteCategoryModal'));
            deleteModal.hide();

            if (data.success) {
                toastr.success(data.message || 'Category deleted successfully!');
                setTimeout(() => location.reload(), 1500);
            } else {
                toastr.error(data.message || 'Failed to delete category.');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            const deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteCategoryModal'));
            deleteModal.hide();
            toastr.error('Failed to delete category. Please try again.');
        })
        .finally(() => {
            deleteBtn.disabled = false;
            deleteBtn.innerHTML = 'Delete';
            categoryIdToDelete = null;
        });
    }

    // Enter key to submit
    document.addEventListener('DOMContentLoaded', function () {
        const categoryInput = document.getElementById('categoryNameInput');
        if (categoryInput) {
            categoryInput.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') saveCategory();
            });
        }

        // Move to category button
        const moveBtn = document.getElementById('moveToCategoryBtn');
        if (moveBtn) {
            moveBtn.addEventListener('click', function () {
                openSelectItemsModal();
            });
        }

        // Select All checkbox
        const selectAll = document.getElementById('selectAllItems');
        if (selectAll) {
            selectAll.addEventListener('change', function () {
                const checkboxes = document.querySelectorAll('#modalItemsBody input[type="checkbox"]');
                checkboxes.forEach(cb => {
                    if (cb.closest('tr').style.display !== 'none') {
                        cb.checked = selectAll.checked;
                    }
                });
            });
        }

        // Modal search
        const modalSearch = document.getElementById('modalItemSearch');
        if (modalSearch) {
            modalSearch.addEventListener('input', function () {
                const term = this.value.toLowerCase();
                document.querySelectorAll('#modalItemsBody tr').forEach(row => {
                    const name = row.querySelector('.modal-item-name')?.textContent.toLowerCase() || '';
                    row.style.display = name.includes(term) || term === '' ? '' : 'none';
                });
            });
        }
    });

    // Open Select Items Modal
    function openSelectItemsModal() {
        if (currentCategoryId === '0' || currentCategoryId === 'uncategorized') {
            toastr.warning('Please select a category first to move items into it.');
            return;
        }

        const modal = new bootstrap.Modal(document.getElementById('selectItemsModal'));
        const tbody = document.getElementById('modalItemsBody');
        const searchInput = document.getElementById('modalItemSearch');
        const selectAll = document.getElementById('selectAllItems');
        const removeChk = document.getElementById('removeFromExistingChk');

        // Reset
        if (searchInput) searchInput.value = '';
        if (selectAll) selectAll.checked = false;
        if (removeChk) removeChk.checked = false;
        tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; padding: 40px; color: #6c757d;">Loading items...</td></tr>';

        modal.show();

        // Load items not in this category
        fetch(`/Web/Items/GetItemsForCategoryModal?categoryId=${currentCategoryId}`, {
            method: 'GET',
            headers: { 'Accept': 'application/json' }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success && data.items && data.items.length > 0) {
                tbody.innerHTML = data.items.map((item, idx) => `
                    <tr style="border-bottom: 1px solid #f1f3f4;${idx % 2 === 1 ? ' background: #f8f9fa;' : ''}">
                        <td style="padding: 12px 16px; width: 40px;">
                            <input type="checkbox" class="modal-item-chk" value="${item.id}" style="width: 16px; height: 16px; cursor: pointer;">
                        </td>
                        <td style="padding: 12px 8px;" class="modal-item-name">${item.itemName || ''}</td>
                        <td style="padding: 12px 16px; text-align: right; color: #28a745; font-weight: 600;">${item.openingQuantity || 0}</td>
                    </tr>
                `).join('');
            } else {
                tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; padding: 40px; color: #6c757d;">No items available to move</td></tr>';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; padding: 40px; color: #dc3545;">Error loading items</td></tr>';
        });
    }

    // Confirm Move to Category
    function confirmMoveToCategory() {
        const selectedItems = [];
        document.querySelectorAll('#modalItemsBody .modal-item-chk:checked').forEach(cb => {
            selectedItems.push(parseInt(cb.value));
        });

        if (selectedItems.length === 0) {
            toastr.warning('Please select at least one item to move.');
            return;
        }

        const removeFromExisting = document.getElementById('removeFromExistingChk')?.checked || false;
        const confirmBtn = document.getElementById('confirmMoveBtn');
        confirmBtn.disabled = true;
        confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Moving...';

        fetch('/Web/Items/MoveItemsToCategory', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({
                CategoryId: currentCategoryId,
                ItemIds: selectedItems,
                RemoveFromExisting: removeFromExisting
            })
        })
        .then(response => response.json())
        .then(data => {
            const modal = bootstrap.Modal.getInstance(document.getElementById('selectItemsModal'));
            modal.hide();

            if (data.success) {
                toastr.success(data.message || 'Items moved successfully!');
                setTimeout(() => location.reload(), 1500);
            } else {
                toastr.error(data.message || 'Failed to move items.');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            toastr.error('Failed to move items. Please try again.');
        })
        .finally(() => {
            confirmBtn.disabled = false;
            confirmBtn.innerHTML = 'Move to this category';
        });
    }
</script>