    // ITEM CODE — Duplicate Check & Assign Code Logic
    // ══════════════════════════════════════════════════
    (function () {
        const currentItemId = parseInt(document.querySelector('input[name="Id"]')?.value) || 0;
        let productCodeTimer = null;
        let serviceCodeTimer = null;
        let productCodeValid = true;
        let serviceCodeValid = true;

        // Get references
        const productInput = document.getElementById('productItemCode');
        const serviceInput = document.getElementById('serviceItemCode');

        function getInputAndMsg(type) {
            if (type === 'product') return { input: productInput, msgEl: document.getElementById('productCodeMessage') };
            return { input: serviceInput, msgEl: document.getElementById('serviceCodeMessage') };
        }

        function showCodeMessage(type, message, isValid) {
            const { input, msgEl } = getInputAndMsg(type);
            if (!msgEl) return;
            msgEl.style.display = message ? 'block' : 'none';
            if (message) {
                var icon = isValid ? '&#10003; ' : '&#9888; ';
                msgEl.innerHTML = icon + message;
            } else {
                msgEl.innerHTML = '';
            }
            msgEl.style.color = isValid ? '#28a745' : '#dc3545';
            if (input) {
                input.style.borderColor = message ? (isValid ? '#28a745' : '#dc3545') : '';
            }
            if (type === 'product') productCodeValid = isValid;
            else serviceCodeValid = isValid;
            updateSaveButton();
        }

        function updateSaveButton() {
            // Find which form is visible
            const productForm = document.getElementById('productForm');
            const serviceForm = document.getElementById('serviceForm');
            const saveButtons = document.querySelectorAll('button.btn-primary');
            const isProductVisible = productForm && productForm.style.display !== 'none';
            const valid = isProductVisible ? productCodeValid : serviceCodeValid;
            saveButtons.forEach(btn => {
                if (btn.textContent.trim() === 'Save' || btn.textContent.trim() === 'Update') {
                    btn.disabled = !valid;
                    btn.style.opacity = valid ? '1' : '0.5';
                }
            });
        }

        function verifyItemCode(code, type) {
            const { input, msgEl } = getInputAndMsg(type);
            if (!code || code.trim().length < 3) {
                showCodeMessage(type, '', true);
                return;
            }
            const url = '/Web/Items/CheckItemCode?code=' + encodeURIComponent(code.trim()) + '&excludeId=' + currentItemId;
            fetch(url)
                .then(r => r.json())
                .then(data => {
                    showCodeMessage(type, data.message, data.isAvailable);
                })
                .catch(() => showCodeMessage(type, '', true));
        }

        // Debounced input listeners
        if (productInput) {
            productInput.addEventListener('input', function () {
                clearTimeout(productCodeTimer);
                const val = this.value;
                if (!val || val.trim().length < 3) { showCodeMessage('product', '', true); return; }
                productCodeTimer = setTimeout(() => verifyItemCode(val, 'product'), 600);
            });
        }
        if (serviceInput) {
            serviceInput.addEventListener('input', function () {
                clearTimeout(serviceCodeTimer);
                const val = this.value;
                if (!val || val.trim().length < 3) { showCodeMessage('service', '', true); return; }
                serviceCodeTimer = setTimeout(() => verifyItemCode(val, 'service'), 600);
            });
        }

        // Assign Code (generate unique code from server)
        window.assignItemCode = function (type) {
            const { input } = getInputAndMsg(type);
            const btn = type === 'product' ? document.getElementById('assignProductCode') : document.getElementById('assignServiceCode');
            if (btn) { btn.disabled = true; btn.textContent = 'Generating...'; }

            fetch('/Web/Items/GenerateItemCode')
                .then(r => r.json())
                .then(data => {
                    if (data.success && input) {
                        input.value = data.code;
                        verifyItemCode(data.code, type);
                    } else {
                        showCodeMessage(type, data.message || 'Failed to generate code.', false);
                    }
                })
                .catch(() => showCodeMessage(type, 'Error generating code. Please try again.', false))
                .finally(() => {
                    if (btn) { btn.disabled = false; btn.textContent = 'Assign Code'; }
                });
        };
    })();

    // Set unit dropdown values on page load
    (function() {
        var unitVal = document.getElementById('currentUnitValue');
        if (unitVal && unitVal.value) {
            var productSelect = document.getElementById('productUnitSelect');
            var serviceSelect = document.getElementById('serviceUnitSelect');
            if (productSelect) productSelect.value = unitVal.value;
            if (serviceSelect) serviceSelect.value = unitVal.value;
        }
    })();

    </script>
</body>
</html>