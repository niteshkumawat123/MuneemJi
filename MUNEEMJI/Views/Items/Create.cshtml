        <div style="text-align:center;">
            <div style="width:48px; height:48px; border:4px solid #e9ecef; border-top:4px solid #007bff; border-radius:50%; animation:spin 0.8s linear infinite; margin:0 auto 15px;"></div>
            <p style="color:#333; font-size:15px; font-weight:500;">Saving, please wait...</p>
        </div>
    </div>
    <style>
        @@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>

    <!-- Success/Error Message Modal -->
    <div class="modal fade" id="messageModal" tabindex="-1" style="display: none;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 8px; overflow: hidden;">
                <div class="modal-header" id="messageModalHeader" style="border: none; padding: 20px 25px;">
                    <h5 class="modal-title" id="messageModalTitle" style="font-weight: 600;">Message</h5>
                    <button type="button" class="btn-close" onclick="closeMessageModal()" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="messageModalBody" style="padding: 20px 25px; font-size: 15px;">
                </div>
                <div class="modal-footer" style="border: none; padding: 15px 25px;">
                    <button type="button" class="btn-primary" onclick="closeMessageModal()">OK</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" id="messageModalBackdrop" style="display: none;"></div>

    <script>

                let messageModalAction = null;

        function showMessageModal(isSuccess, message, redirectUrl = null) {
            const modal = document.getElementById('messageModal');
            const backdrop = document.getElementById('messageModalBackdrop');
            const messageModalHeader = document.getElementById('messageModalHeader');
            const messageModalTitle = document.getElementById('messageModalTitle');
            const messageModalBody = document.getElementById('messageModalBody');

            messageModalTitle.textContent = isSuccess ? 'Success' : 'Error';
            messageModalBody.textContent = message;

            if (isSuccess) {
                messageModalHeader.style.backgroundColor = '#28a745';
                messageModalHeader.style.color = 'white';
            } else {
                messageModalHeader.style.backgroundColor = '#dc3545';
                messageModalHeader.style.color = 'white';
            }

            messageModalAction = redirectUrl;

            modal.style.display = 'block';
            backdrop.style.display = 'block';

            setTimeout(() => {
                modal.classList.add('show');
                backdrop.classList.add('show');
            }, 10);
        }

        function closeMessageModal() {
            const modal = document.getElementById('messageModal');
            const backdrop = document.getElementById('messageModalBackdrop');

            modal.classList.remove('show');
            backdrop.classList.remove('show');

            setTimeout(() => {
                modal.style.display = 'none';
                backdrop.style.display = 'none';

                if (messageModalAction) {
                    window.location.href = messageModalAction;
                }
            }, 300);
        }
               // Add this updated JavaScript section to replace the existing script in your HTML

                       function clearTracking() {
            // Uncheck both radio buttons
            document.getElementById('batchTracking').checked = false;
            document.getElementById('serialTracking').checked = false;

            // Also clear the value if you're storing it somewhere
            const trackingInputs = document.querySelectorAll('input[name="tracking"]');
            trackingInputs.forEach(input => {
                input.checked = false;
            });
        }

        async   function serializeFormToJSON() {
            const form = document.getElementById('itemForm');
            const formData = new FormData(form);
            const itemType = document.getElementById('itemTypeInput').value;

            // Base JSON structure matching your C# model
            const jsonData = {
                ItemType: itemType
            };

            // Handle Product data
            if (itemType === 'product') {
                // Basic product information
                jsonData.Id  =  formData.get('Id') || 0;
                jsonData.ItemName = formData.get('ItemName') || '';
                jsonData.ItemHsn = formData.get('ItemHSN') || '';
                jsonData.Category = formData.get('Category') || '';
                jsonData.ItemCode = formData.get('ItemCode') || '';
                jsonData.Unit = formData.get('Unit') || '';

                // Handle product image
                const productImageFile = document.querySelector('input[name="ProductImageUrl"]').files[0];
                if (productImageFile) {
                    jsonData.ImageBase64 = await getFileAsBase64(productImageFile);
                    jsonData.ImageFileName = productImageFile.name;
                } else {
                    jsonData.ImageUrl = document.getElementById('existingImageUrl').value || null;
                }

                // Pricing information
                jsonData.SalePrice = parseFloat(formData.get('SalePrice')) || null;
                jsonData.SalePriceTaxType = formData.get('SalePriceTax') || 'Without Tax';
                jsonData.DiscountOnSalePrice = parseFloat(formData.get('SaleDiscount')) || null;
                jsonData.DiscountType = formData.get('SaleDiscountType') || 'Percentage';
                jsonData.PurchasePrice = parseFloat(formData.get('PurchasePrice')) || null;
                jsonData.PurchasePriceTaxType = formData.get('PurchasePriceTax') || 'Without Tax';
                jsonData.TaxRate = formData.get('TaxRate') || 'None';
                jsonData.WholesalePrice = parseFloat(formData.get('WholesalePrice')) || null;
                jsonData.WholesalePriceTaxType = formData.get('WholesalePriceTax') || 'Without Tax';
                jsonData.MinWholesaleQty = parseInt(formData.get('MinWholesaleQty')) || 0;
                jsonData.DiscOnMrpWholesale = parseFloat(formData.get('DiscOnMRPWholesale')) || null;
                jsonData.AdditionalCess = parseFloat(formData.get('AdditionalCess')) || null;

                // Stock information
                jsonData.OpeningQuantity = parseInt(formData.get('OpeningQuantity')) || 0;
                jsonData.AtPrice = parseFloat(formData.get('AtPrice')) || null;
                jsonData.AsOfDate = formData.get('AsOfDate') || null;
                jsonData.MinStockToMaintain = parseInt(formData.get('MinStock')) || 0;
                jsonData.Location = formData.get('Location') || '';

                // Online store information
                jsonData.OnlineStorePrice = parseFloat(formData.get('OnlineStorePrice')) || null;
                jsonData.Description = formData.get('Description') || '';

                // Additional fields
                jsonData.Colour = formData.get('Colour') || '';
                jsonData.Material = formData.get('Material') || '';
                jsonData.MfgDate = formData.get('MfgDate') || null;
                jsonData.ExpDate = formData.get('ExpDate') || null;
                jsonData.Size = formData.get('Size') || '';
                jsonData.Brand = formData.get('Brand') || '';

                // Manufacturing/Raw Materials Array
                jsonData.Manufacturing = [];

                // Get all raw material data
                const rawMaterialNames = formData.getAll('RawMaterial[]');
                const rawMaterialQtys = formData.getAll('RawMaterialQty[]');
                const rawMaterialUnits = formData.getAll('RawMaterialUnit[]');
                const rawMaterialPrices = formData.getAll('RawMaterialPrice[]');
                const rawMaterialCosts = formData.getAll('RawMaterialCost[]');

                // Process each raw material row
                for (let i = 0; i < rawMaterialNames.length; i++) {
                    // Only add row if at least the name is provided
                    if (rawMaterialNames[i] && rawMaterialNames[i].trim() !== '') {
                        jsonData.Manufacturing.push({
                            Name: rawMaterialNames[i].trim(),
                            Quantity: parseInt(rawMaterialQtys[i]) || 0,
                            Unit: rawMaterialUnits[i] || 'None',
                            PurchasePricePerUnit: parseFloat(rawMaterialPrices[i]) || 0,
                            EstimatedCost: parseFloat(rawMaterialCosts[i]) || 0
                        });
                    }
                }
            }
            // Handle Service data
            else if (itemType === 'service') {
                jsonData.Id  =  formData.get('Id') || 0;
                jsonData.ItemName = formData.get('ServiceName') || '';
                jsonData.ItemHsn = formData.get('ServiceHSN') || '';
                jsonData.Category = formData.get('ServiceCategory') || '';
                jsonData.ItemCode = formData.get('ServiceCode') || '';
                // jsonData.ItemImageUrl = formData.get('ServiceItemImageUrl') || '';
                jsonData.Unit = formData.get('ServiceUnit') || '';

             const serviceImageFile = document.querySelector('input[name="ServiceItemImageUrl"]').files[0];
            if (serviceImageFile) {
                jsonData.ImageBase64 = await getFileAsBase64(serviceImageFile);
                jsonData.ImageFileName = serviceImageFile.name;
            } else {
                jsonData.ImageUrl = document.getElementById('existingImageUrl').value || null;
            }

                // Pricing information
                jsonData.SalePrice = parseFloat(formData.get('ServiceSalePrice')) || null;
                jsonData.SalePriceTaxType = formData.get('ServiceSalePriceTax') || 'Without Tax';
                jsonData.DiscountOnSalePrice = parseFloat(formData.get('ServiceSaleDiscount')) || null;
                jsonData.DiscountType = formData.get('ServiceSaleDiscountType') || 'Percentage';
                jsonData.PurchasePrice = parseFloat(formData.get('ServicePurchasePrice')) || null;
                jsonData.PurchasePriceTaxType = formData.get('ServicePurchasePriceTax') || 'Without Tax';
                jsonData.TaxRate = formData.get('ServiceTaxRate') || 'None';
                jsonData.WholesalePrice = parseFloat(formData.get('ServiceWholesalePrice')) || null;
                jsonData.WholesalePriceTaxType = formData.get('ServiceWholesalePriceTax') || 'Without Tax';
                jsonData.MinWholesaleQty = parseInt(formData.get('ServiceMinWholesaleQty')) || 0;
                jsonData.DiscOnMrpWholesale = parseFloat(formData.get('ServiceDiscOnMRPWholesale')) || null;
                jsonData.AdditionalCess = parseFloat(formData.get('ServiceAdditionalCess')) || null;

                 jsonData.OnlineStorePrice = parseFloat(formData.get('ServiceOnlineStorePrice')) || null;
                jsonData.Description = formData.get('ServiceDescription') || '';

                // Additional fields
                jsonData.Colour = formData.get('ServiceColour') || '';
                jsonData.Material = formData.get('ServiceMaterial') || '';
                jsonData.MfgDate = formData.get('ServiceMfgDate') || null;
                jsonData.ExpDate = formData.get('ServiceExpDate') || null;
                jsonData.Size = formData.get('ServiceSize') || '';
                jsonData.Brand = formData.get('ServiceBrand') || '';

                jsonData.ItemType='service';
                jsonData.Manufacturing = [];
            }

            return jsonData;
        }

        // Function to submit form as JSON
        async  function submitFormAsJSON() {
            const loader = document.getElementById('loadingOverlay');
            try {
                loader.style.display = 'flex';
                const jsonData = await serializeFormToJSON();

                const response = await fetch('/Web/items/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(jsonData)
                });

                loader.style.display = 'none';

                if (response.ok) {
                    const result = await response.json();
                    const isUpdate = jsonData.Id > 0;
                    const message = isUpdate
                        ? 'Item updated successfully!'
                        : 'Item has been saved successfully!';
                    showMessageModal(true, message, '/Web/Items/Products');
                } else {
                    const error = await response.text();
                    showMessageModal(false, 'Error submitting form: ' + error);
                }
            } catch (error) {
                loader.style.display = 'none';
                showMessageModal(false, 'Network error: ' + error.message);
            }
        }

        // Prevent default form submission and use JSON instead
        document.getElementById('itemForm').addEventListener('submit', function(e) {
            e.preventDefault();
            submitFormAsJSON();
        });

        function switchType(type) {
            // Update toggle buttons
            document.querySelectorAll('.toggle-option').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');

            // Show/hide forms
            if (type === 'product') {
                document.getElementById('productForm').style.display = 'block';
                document.getElementById('serviceForm').style.display = 'none';
            } else {
                document.getElementById('productForm').style.display = 'none';
                document.getElementById('serviceForm').style.display = 'block';
            }

            // Update hidden input
            document.getElementById('itemTypeInput').value = type;
        }

        function showTab(tabName) {
            // Update tab buttons
            document.querySelectorAll('#productForm .tab').forEach(tab => tab.classList.remove('active'));
            event.target.classList.add('active');

            // Show/hide tab content
            document.querySelectorAll('#productForm .tab-content').forEach(content => {
                content.classList.remove('active');
            });
            document.getElementById(tabName).classList.add('active');
        }

                 function showServiceTab(tabName) {
            // Update tab buttons
            document.querySelectorAll('#serviceForm .tab').forEach(tab => tab.classList.remove('active'));
            event.target.classList.add('active');

            // Show/hide tab content
            document.querySelectorAll('#serviceForm .tab-content').forEach(content => {
                content.classList.remove('active');
            });
            document.getElementById('service-' + tabName).classList.add('active');
        }

        function addRawMaterialRow() {
            const table = document.getElementById('rawMaterialTable');
            const rowCount = table.rows.length + 1;
            const newRow = table.insertRow();

            newRow.innerHTML = `
                <td>${rowCount}</td>
                <td><input type="text" name="RawMaterial[]" class="form-input"></td>
                <td><input type="number" name="RawMaterialQty[]" class="form-input"></td>
                <td>
                    <select name="RawMaterialUnit[]" class="form-select">
                        <option>None</option>
                        <option>Kg</option>
                        <option>Pieces</option>
                        <option>Liters</option>
                    </select>
                </td>
                <td><input type="number" name="RawMaterialPrice[]" class="form-input" step="0.01" value="0"></td>
                <td><input type="number" name="RawMaterialCost[]" class="form-input" step="0.01" value="0" readonly></td>
                <td><button type="button" class="delete-row-btn" onclick="deleteRawMaterialRow(this)">🗑️</button></td>
            `;
        }

        function deleteRawMaterialRow(button) {
            const row = button.closest('tr');
            const table = document.getElementById('rawMaterialTable');

            if (table.rows.length > 1) {
                row.remove();
                updateRowNumbers();
                updateTotal();
            }
        }

        function updateRowNumbers() {
            const table = document.getElementById('rawMaterialTable');
            Array.from(table.rows).forEach((row, index) => {
                row.cells[0].textContent = index + 1;
            });
        }

        // Calculate estimated cost for raw materials
        document.addEventListener('input', function(e) {
            if (e.target.name === 'RawMaterialQty[]' || e.target.name === 'RawMaterialPrice[]') {
                const row = e.target.closest('tr');
                const qty = row.querySelector('input[name="RawMaterialQty[]"]').value || 0;
                const price = row.querySelector('input[name="RawMaterialPrice[]"]').value || 0;
                const cost = qty * price;
                row.querySelector('input[name="RawMaterialCost[]"]').value = cost.toFixed(2);

                updateTotal();
            }
        });

        function updateTotal() {
            const costInputs = document.querySelectorAll('input[name="RawMaterialCost[]"]');
            let total = 0;
            costInputs.forEach(input => {
                total += parseFloat(input.value) || 0;
            });

            // Update total displays
            const totalElement = document.getElementById('rawMaterialTotal');
            if (totalElement) {
                totalElement.textContent = `TOTAL: ₹ ${total.toFixed(2)}`;
            }

            const summaryElement = document.getElementById('totalCostSummary');
            if (summaryElement) {
                summaryElement.textContent = `Total Estimated Cost (Raw Material + Additional Cost) = ₹ ${total.toFixed(2)}`;
            }
        }

        // Calculate totals on page load for edit mode
        document.addEventListener('DOMContentLoaded', function() {
            updateTotal();
        });
    </script>

