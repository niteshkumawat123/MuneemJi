              // Helper function to convert file to base64 with comprehensive error handling
        function getFileAsBase64(file) {
            debugger;
            return new Promise((resolve, reject) => {
                try {
                    // Validate input
                    if (!file) {
                        const error = new Error('No file provided to getFileAsBase64 function');
                        console.error('getFileAsBase64 Error - Input Validation:', {
                            error: error.message,
                            file: file,
                            timestamp: new Date().toISOString()
                        });
                        reject(error);
                        return;
                    }

                    if (!(file instanceof File)) {
                        const error = new Error('Provided parameter is not a valid File object');
                        console.error('getFileAsBase64 Error - Type Validation:', {
                            error: error.message,
                            fileType: typeof file,
                            fileConstructor: file.constructor.name,
                            timestamp: new Date().toISOString()
                        });
                        reject(error);
                        return;
                    }

                    // Log file information
                    console.log('getFileAsBase64 - Processing file:', {
                        fileName: file.name,
                        fileSize: file.size,
                        fileType: file.type,
                        lastModified: new Date(file.lastModified).toISOString(),
                        timestamp: new Date().toISOString()
                    });

                    const reader = new FileReader();

                    // Handle successful file reading
                    reader.onload = function(e) {
                        try {
                            console.log('FileReader onload triggered');

                            if (!e.target || !e.target.result) {
                                const error = new Error('FileReader result is null or undefined');
                                console.error('getFileAsBase64 Error - No Result:', {
                                    error: error.message,
                                    eventTarget: e.target,
                                    result: e.target ? e.target.result : 'No target',
                                    timestamp: new Date().toISOString()
                                });
                                reject(error);
                                return;
                            }

                            const result = e.target.result;
                            console.log('FileReader result received:', {
                                resultType: typeof result,
                                resultLength: result.length,
                                startsWithData: result.startsWith('data:'),
                                timestamp: new Date().toISOString()
                            });

                            // Validate data URL format
                            if (!result.includes(',')) {
                                const error = new Error('Invalid data URL format - missing comma separator');
                                console.error('getFileAsBase64 Error - Invalid Format:', {
                                    error: error.message,
                                    result: result.substring(0, 100) + '...', // First 100 chars for debugging
                                    timestamp: new Date().toISOString()
                                });
                                reject(error);
                                return;
                            }

                            // Remove the data URL prefix (e.g., "data:image/jpeg;base64,")
                            const base64 = result.split(',')[1];

                            if (!base64) {
                                const error = new Error('Failed to extract base64 data from result');
                                console.error('getFileAsBase64 Error - Base64 Extraction:', {
                                    error: error.message,
                                    splitResult: result.split(','),
                                    timestamp: new Date().toISOString()
                                });
                                reject(error);
                                return;
                            }

                            console.log('getFileAsBase64 - Success:', {
                                fileName: file.name,
                                originalSize: file.size,
                                base64Length: base64.length,
                                compressionRatio: (base64.length / file.size).toFixed(2),
                                timestamp: new Date().toISOString()
                            });

                            resolve(base64);

                        } catch (processError) {
                            console.error('getFileAsBase64 Error - Processing Exception:', {
                                error: processError.message,
                                stack: processError.stack,
                                fileName: file.name,
                                timestamp: new Date().toISOString()
                            });
                            reject(processError);
                        }
                    };

                    // Handle file reading errors
                    reader.onerror = function(e) {
                        const error = new Error(`FileReader error: ${reader.error ? reader.error.message : 'Unknown error'}`);
                        console.error('getFileAsBase64 Error - FileReader Error:', {
                            error: error.message,
                            readerError: reader.error,
                            readerReadyState: reader.readyState,
                            fileName: file.name,
                            fileSize: file.size,
                            timestamp: new Date().toISOString()
                        });
                        reject(error);
                    };

                    // Handle file reading abort
                    reader.onabort = function(e) {
                        const error = new Error('FileReader operation was aborted');
                        console.error('getFileAsBase64 Error - Operation Aborted:', {
                            error: error.message,
                            fileName: file.name,
                            timestamp: new Date().toISOString()
                        });
                        reject(error);
                    };

                    // Start reading the file
                    console.log('Starting FileReader.readAsDataURL()');
                    reader.readAsDataURL(file);

                } catch (initError) {
                    console.error('getFileAsBase64 Error - Initialization Exception:', {
                        error: initError.message,
                        stack: initError.stack,
                        timestamp: new Date().toISOString()
                    });
                    reject(initError);
                }
            });
        }

