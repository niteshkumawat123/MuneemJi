@{
    ViewData["Title"] = "Import Items From Excel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .import-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 20px 30px;
        background: #fff;
        min-height: calc(100vh - 65px);
    }

    .import-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 16px;
        border-bottom: 2px solid #e9ecef;
        margin-bottom: 30px;
    }

    .import-header a {
        color: #333;
        text-decoration: none;
        font-size: 20px;
    }

    .import-header h4 {
        margin: 0;
        font-weight: 700;
        color: #1a237e;
        font-size: 1.3rem;
    }

    .import-body {
        display: flex;
        gap: 40px;
    }

    .import-steps {
        flex: 0 0 420px;
        min-width: 0;
    }

    .import-upload-area {
        flex: 1;
        min-width: 0;
    }

    .step-title {
        color: #e53935;
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 6px;
    }

    .step-desc {
        font-size: 14px;
        color: #333;
        margin-bottom: 12px;
    }

    .download-sample-btn {
        display: inline-block;
        padding: 8px 20px;
        border: 2px solid #1a73e8;
        color: #1a73e8;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        font-size: 13px;
        transition: all 0.2s;
        margin-bottom: 16px;
    }

    .download-sample-btn:hover {
        background: #1a73e8;
        color: #fff;
    }

    .excel-preview {
        width: 100%;
        border: 1px solid #ccc;
        border-radius: 6px;
        overflow: hidden;
        margin-bottom: 24px;
    }

    .excel-preview table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
    }

    .excel-preview thead {
        background: #3f51b5;
        color: #fff;
    }

    .excel-preview th,
    .excel-preview td {
        padding: 6px 8px;
        border: 1px solid #ddd;
        text-align: left;
        white-space: nowrap;
    }

    .excel-preview tbody tr:nth-child(even) {
        background: #f5f5f5;
    }

    .upload-title {
        text-align: center;
        font-size: 14px;
        color: #555;
        margin-bottom: 16px;
        font-weight: 500;
    }

    .upload-dropzone {
        border: 2px dashed #90caf9;
        border-radius: 12px;
        background: #e3f2fd;
        padding: 40px 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
        position: relative;
    }

    .upload-dropzone:hover,
    .upload-dropzone.dragover {
        border-color: #1a73e8;
        background: #bbdefb;
    }

    .upload-dropzone .cloud-icon {
        font-size: 48px;
        color: #90caf9;
        margin-bottom: 12px;
    }

    .upload-dropzone p {
        color: #666;
        margin: 8px 0;
        font-size: 14px;
    }

    .upload-dropzone .or-text {
        color: #999;
        font-size: 13px;
        margin: 12px 0;
    }

    .upload-file-btn {
        display: inline-block;
        padding: 10px 28px;
        background: #e53935;
        color: #fff;
        border: none;
        border-radius: 25px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: background 0.2s;
    }

    .upload-file-btn:hover {
        background: #c62828;
    }

    .upload-file-btn i {
        margin-right: 6px;
    }

    .file-info {
        margin-top: 16px;
        padding: 12px 16px;
        background: #e8f5e9;
        border-radius: 8px;
        display: none;
        align-items: center;
        gap: 10px;
    }

    .file-info.show {
        display: flex;
    }

    .file-info .file-name {
        font-weight: 600;
        color: #2e7d32;
        font-size: 13px;
    }

    .file-info .file-remove {
        margin-left: auto;
        color: #e53935;
        cursor: pointer;
        font-size: 18px;
    }

    .import-actions {
        margin-top: 24px;
        text-align: center;
    }

    .import-submit-btn {
        padding: 12px 40px;
        background: #e53935;
        color: #fff;
        border: none;
        border-radius: 25px;
        font-weight: 600;
        font-size: 15px;
        cursor: pointer;
        transition: background 0.2s;
    }

    .import-submit-btn:hover {
        background: #c62828;
    }

    .import-submit-btn:disabled {
        background: #bbb;
        cursor: not-allowed;
    }

    .import-result {
        margin-top: 20px;
        padding: 16px;
        border-radius: 8px;
        display: none;
    }

    .import-result.success {
        display: block;
        background: #e8f5e9;
        border: 1px solid #a5d6a7;
        color: #2e7d32;
    }

    .import-result.error {
        display: block;
        background: #ffebee;
        border: 1px solid #ef9a9a;
        color: #c62828;
    }

    .import-progress {
        display: none;
        margin-top: 16px;
        text-align: center;
    }

    .import-progress.show {
        display: block;
    }

    .import-progress .spinner-border {
        width: 24px;
        height: 24px;
    }

    @@media (max-width: 768px) {
        .import-body {
            flex-direction: column;
        }
        .import-steps {
            flex: unset;
        }
    }
</style>

<div class="import-container">
    <!-- Header -->
    <div class="import-header">
        <a href="/Web/Items/Products"><i class="bi bi-arrow-left"></i></a>
        <h4>Import Items From Excel File</h4>
    </div>

    <div class="import-body">
        <!-- Left: Steps -->
        <div class="import-steps">
            <h6 style="font-weight:700; margin-bottom:16px;">Steps to Import</h6>

            <div class="step-title">STEP 1</div>
            <p class="step-desc">Create an Excel file with the following format.</p>
            <a href="/Web/Items/DownloadItemsTemplate" download class="download-sample-btn">
                <i class="bi bi-download me-1"></i> Download Sample
            </a>

            <!-- Excel Preview Table -->
            <div class="excel-preview">
                <table>
                    <thead>
                        <tr>
                            <th>Item Name*</th>
                            <th>Item Code</th>
                            <th>HSN</th>
                            <th>Sale Price</th>
                            <th>Purchase Price</th>
                            <th>Opening Stock Quantity</th>
                            <th>Minimum Stock Quantity</th>
                            <th>Item Location</th>
                            <th>Tax Rate</th>
                            <th>Tax Inclusive</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>a101</td><td>Item 1</td><td>H001</td><td>5</td><td>4</td><td>20</td><td>5</td><td>Store 1</td><td>IGST@@0%</td><td>N</td>
                        </tr>
                        <tr>
                            <td>a102</td><td>Item 2</td><td>H002</td><td>10</td><td>8</td><td>40</td><td>10</td><td>Store 2</td><td>IGST@@0%</td><td>N</td>
                        </tr>
                        <tr>
                            <td>a103</td><td>Item 3</td><td>H003</td><td>15</td><td>12</td><td>60</td><td>15</td><td>Store 3</td><td>IGST@@0%</td><td>N</td>
                        </tr>
                        <tr>
                            <td>a104</td><td>Item 4</td><td>H004</td><td>20</td><td>18</td><td>80</td><td>20</td><td>Store 4</td><td>IGST@@0%</td><td>N</td>
                        </tr>
                        <tr>
                            <td>a105</td><td>Item 5</td><td>H005</td><td>25</td><td>20</td><td>100</td><td>25</td><td>Store 5</td><td>IGST@@0%</td><td>N</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="step-title">STEP 2</div>
            <p class="step-desc"><i class="bi bi-upload me-1"></i> Upload the file (<strong>xlsx or xls</strong>) by clicking on the Upload File button below.</p>

            <div class="step-title">STEP 3</div>
            <p class="step-desc">Verify the items from the file & complete the import.</p>
        </div>

        <!-- Right: Upload Area -->
        <div class="import-upload-area">
            <p class="upload-title">Upload your <strong>.xls/ .xlsx</strong> (excel sheet)</p>

            <div class="upload-dropzone" id="uploadDropzone">
                <div class="cloud-icon"><i class="bi bi-cloud-arrow-up"></i></div>
                <p>Drag & Drop files here</p>
                <p class="or-text">or</p>
                <button type="button" class="upload-file-btn" id="uploadFileBtn">
                    <i class="bi bi-upload"></i> Upload File
                </button>
                <input type="file" id="fileInput" accept=".xls,.xlsx" style="display:none;" />
            </div>

            <div class="file-info" id="fileInfo">
                <i class="bi bi-file-earmark-excel" style="font-size:24px; color:#2e7d32;"></i>
                <span class="file-name" id="fileName"></span>
                <span class="file-remove" id="fileRemove" title="Remove file">&times;</span>
            </div>

            <div class="import-progress" id="importProgress">
                <div class="spinner-border text-primary" role="status"></div>
                <p style="margin-top:8px; color:#666;">Importing items, please wait...</p>
            </div>

            <div class="import-actions">
                <button type="button" class="import-submit-btn" id="importSubmitBtn" disabled>
                    <i class="bi bi-check-circle me-1"></i> Import Items
                </button>
            </div>

            <div class="import-result" id="importResult"></div>
        </div>
    </div>
</div>

<script>
    (function () {
        const dropzone = document.getElementById('uploadDropzone');
        const fileInput = document.getElementById('fileInput');
        const uploadBtn = document.getElementById('uploadFileBtn');
        const fileInfo = document.getElementById('fileInfo');
        const fileName = document.getElementById('fileName');
        const fileRemove = document.getElementById('fileRemove');
        const submitBtn = document.getElementById('importSubmitBtn');
        const importProgress = document.getElementById('importProgress');
        const importResult = document.getElementById('importResult');

        let selectedFile = null;

        // Click upload button
        uploadBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            fileInput.click();
        });

        // Click dropzone
        dropzone.addEventListener('click', function () {
            fileInput.click();
        });

        // Drag events
        dropzone.addEventListener('dragover', function (e) {
            e.preventDefault();
            dropzone.classList.add('dragover');
        });

        dropzone.addEventListener('dragleave', function () {
            dropzone.classList.remove('dragover');
        });

        dropzone.addEventListener('drop', function (e) {
            e.preventDefault();
            dropzone.classList.remove('dragover');
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                handleFile(files[0]);
            }
        });

        // File input change
        fileInput.addEventListener('change', function () {
            if (this.files.length > 0) {
                handleFile(this.files[0]);
            }
        });

        function handleFile(file) {
            const ext = file.name.split('.').pop().toLowerCase();
            if (ext !== 'xls' && ext !== 'xlsx') {
                alert('Please select a valid Excel file (.xls or .xlsx)');
                return;
            }
            selectedFile = file;
            fileName.textContent = file.name;
            fileInfo.classList.add('show');
            submitBtn.disabled = false;
            importResult.style.display = 'none';
            importResult.className = 'import-result';
        }

        // Remove file
        fileRemove.addEventListener('click', function () {
            selectedFile = null;
            fileInput.value = '';
            fileInfo.classList.remove('show');
            submitBtn.disabled = true;
        });

        // Submit import
        submitBtn.addEventListener('click', function () {
            if (!selectedFile) return;

            const formData = new FormData();
            formData.append('file', selectedFile);

            submitBtn.disabled = true;
            importProgress.classList.add('show');
            importResult.style.display = 'none';
            importResult.className = 'import-result';

            fetch('/Web/Items/ImportItemsFromExcel', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                importProgress.classList.remove('show');
                if (data.success) {
                    importResult.className = 'import-result success';
                    importResult.innerHTML = '<i class="bi bi-check-circle me-2"></i><strong>Success!</strong> ' + data.message;
                    importResult.style.display = 'block';
                    // Reset
                    selectedFile = null;
                    fileInput.value = '';
                    fileInfo.classList.remove('show');
                } else {
                    importResult.className = 'import-result error';
                    let errHtml = '<i class="bi bi-exclamation-triangle me-2"></i><strong>Error:</strong> ' + (data.message || 'Import failed.');
                    if (data.errors && data.errors.length > 0) {
                        errHtml += '<ul style="margin-top:8px;padding-left:20px;">';
                        data.errors.forEach(function (err) {
                            errHtml += '<li>' + err + '</li>';
                        });
                        errHtml += '</ul>';
                    }
                    importResult.innerHTML = errHtml;
                    importResult.style.display = 'block';
                    submitBtn.disabled = false;
                }
            })
            .catch(error => {
                importProgress.classList.remove('show');
                importResult.className = 'import-result error';
                importResult.innerHTML = '<i class="bi bi-exclamation-triangle me-2"></i><strong>Error:</strong> An unexpected error occurred. Please try again.';
                importResult.style.display = 'block';
                submitBtn.disabled = false;
            });
        });
    })();
</script>
