        overflow: hidden;
    }
    .stock-adj-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px 16px;
        border-bottom: 1px solid #e9ecef;
    }
    .stock-adj-header h4 {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
        color: #2c3e50;
    }
    .stock-adj-header-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .stock-adj-close {
        background: none;
        border: none;
        font-size: 24px;
        color: #999;
        cursor: pointer;
        padding: 4px 8px;
    }
    .stock-adj-close:hover { color: #333; }
    .stock-adj-toggle {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        font-weight: 600;
    }
    .stock-adj-toggle-label {
        color: #6c757d;
        cursor: pointer;
    }
    .stock-adj-toggle-label.active { color: #007bff; }
    .stock-adj-switch {
        position: relative;
        width: 44px;
        height: 24px;
        background: #007bff;
        border-radius: 12px;
        cursor: pointer;
        transition: background 0.3s;
    }
    .stock-adj-switch.reduce { background: #dc3545; }
    .stock-adj-switch-knob {
        position: absolute;
        top: 3px;
        left: 3px;
        width: 18px;
        height: 18px;
        background: #fff;
        border-radius: 50%;
        transition: left 0.3s;
    }
    .stock-adj-switch.reduce .stock-adj-switch-knob { left: 23px; }
    .stock-adj-body {
        padding: 20px 24px;
    }
    .stock-adj-item-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid #f0f0f0;
    }
    .stock-adj-item-name {
        font-size: 12px;
        color: #6c757d;
    }
    .stock-adj-item-name strong {
        display: block;
        font-size: 15px;
        color: #2c3e50;
        margin-top: 2px;
    }
    .stock-adj-date-field {
        position: relative;
    }
    .stock-adj-date-field label {
        position: absolute;
        top: -8px;
        left: 10px;
        background: #fff;
        padding: 0 4px;
        font-size: 11px;
        color: #6c757d;
    }
    .stock-adj-date-field input {
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        outline: none;
        width: 180px;
    }
    .stock-adj-date-field input:focus { border-color: #007bff; }
    .stock-adj-fields {
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }
    .stock-adj-field {
        flex: 1;
    }
    .stock-adj-field input, .stock-adj-field select {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        outline: none;
    }
    .stock-adj-field input:focus, .stock-adj-field select:focus { border-color: #007bff; }
    .stock-adj-field input::placeholder { color: #aaa; }
    .stock-adj-details {
        margin-top: 16px;
    }
    .stock-adj-details-wrapper {
        position: relative;
    }
    .stock-adj-details-wrapper label {
        position: absolute;
        top: -8px;
        left: 10px;
        background: #fff;
        padding: 0 4px;
        font-size: 11px;
        color: #007bff;
