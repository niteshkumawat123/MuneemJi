        .then(response => response.json())
        .then(data => {
            if (data.success) {
                closeBulkActiveModal();
                toastr.success(data.message || 'Items marked as active successfully!');
                setTimeout(function() { window.location.reload(); }, 1500);
            } else {
                toastr.error(data.message || 'Failed to mark items as active.');
                submitBtn.disabled = false;
                submitBtn.textContent = 'Mark as Active';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            toastr.error('An error occurred. Please try again.');
            submitBtn.disabled = false;
            submitBtn.textContent = 'Mark as Active';
        });
    }

    // Search within Bulk Active modal
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('bulkActiveSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const term = this.value.toLowerCase();
                const rows = document.querySelectorAll('#bulkActiveTableBody tr');
                rows.forEach(row => {
                    const name = row.getAttribute('data-item-name') || '';
                    row.style.display = name.includes(term) || term === '' ? '' : 'none';
                });
            });
        }
    });
</script>

