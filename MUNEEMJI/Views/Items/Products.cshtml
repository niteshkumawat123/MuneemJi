        const selectAll = document.getElementById('bulkActiveSelectAll');
        const checkboxes = document.querySelectorAll('.bulk-active-checkbox');
        const submitBtn = document.getElementById('bulkActiveSubmitBtn');

        selectAll.checked = false;

        selectAll.addEventListener('change', function () {
            const visibleRows = document.querySelectorAll('#bulkActiveTableBody tr:not([style*="display: none"]) .bulk-active-checkbox');
            visibleRows.forEach(cb => cb.checked = this.checked);
            updateBulkActiveSubmitBtn();
        });

