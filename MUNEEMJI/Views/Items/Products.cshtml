<!-- Bulk Inactive Modal -->
<div class="bulk-inactive-overlay" id="bulkInactiveOverlay">
    <div class="bulk-inactive-modal">
        <div class="bulk-inactive-header">
            <h4>Bulk Inactive</h4>
            <button class="bulk-inactive-close" onclick="closeBulkInactiveModal()">&times;</button>
        </div>
        <div class="bulk-inactive-search">
            <div class="bulk-inactive-search-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" id="bulkInactiveSearch" placeholder="Search items">
            </div>
        </div>
        <div class="bulk-inactive-table-wrapper">
            <table class="bulk-inactive-table">
                <thead>
                    <tr>
                        <th><input type="checkbox" id="bulkInactiveSelectAll"></th>
                        <th>Item Name</th>
                        <th>Quantity</th>
                        <th>Quantity Sold in Last 90 Days</th>
                    </tr>
                </thead>
                <tbody id="bulkInactiveTableBody">
                    <!-- Populated dynamically -->
                </tbody>
            </table>
        </div>
        <div class="bulk-inactive-footer">
            <div class="bulk-inactive-info">
                <i class="bi bi-info-circle-fill"></i>
                <span>Showing only active items</span>
            </div>
            <div class="bulk-inactive-actions">
                <button class="bulk-inactive-cancel" onclick="closeBulkInactiveModal()">Cancel</button>
                <button class="bulk-inactive-submit" id="bulkInactiveSubmitBtn" disabled onclick="submitBulkInactive()">Mark as Inactive</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Bulk Inactive functionality
    function openBulkInactiveModal() {
        const overlay = document.getElementById('bulkInactiveOverlay');
        overlay.classList.add('show');
        loadActiveItemsForBulkInactive();
    }

    function closeBulkInactiveModal() {
        const overlay = document.getElementById('bulkInactiveOverlay');
        overlay.classList.remove('show');
        document.getElementById('bulkInactiveSearch').value = '';
    }

    function loadActiveItemsForBulkInactive() {
        const tbody = document.getElementById('bulkInactiveTableBody');
        tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:30px; color:#999;">Loading...</td></tr>';

        fetch('/Web/Items/GetActiveItems', {
            method: 'GET',
            headers: { 'Accept': 'application/json' }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success && data.items) {
                renderBulkInactiveItems(data.items);
            } else {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:30px; color:#dc3545;">Failed to load items</td></tr>';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:30px; color:#dc3545;">Error loading items</td></tr>';
        });
    }

    function renderBulkInactiveItems(items) {
        const tbody = document.getElementById('bulkInactiveTableBody');

        if (!items || items.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:30px; color:#999;">No active items found</td></tr>';
            return;
        }

        tbody.innerHTML = items.map(item => `
            <tr data-item-id="${item.id}" data-item-name="${(item.itemName || '').toLowerCase()}">
                <td><input type="checkbox" class="bulk-inactive-checkbox" value="${item.id}"></td>
                <td>${item.itemName || ''}</td>
                <td class="qty-value">${item.quantity || 0}</td>
                <td class="sold-value">${item.quantitySoldIn90Days || 0}</td>
            </tr>
        `).join('');

        // Bind checkbox events
        bindBulkInactiveCheckboxes();
    }

    function bindBulkInactiveCheckboxes() {
        const selectAll = document.getElementById('bulkInactiveSelectAll');
        const checkboxes = document.querySelectorAll('.bulk-inactive-checkbox');
        const submitBtn = document.getElementById('bulkInactiveSubmitBtn');

        selectAll.checked = false;

        selectAll.addEventListener('change', function () {
            const visibleRows = document.querySelectorAll('#bulkInactiveTableBody tr:not([style*="display: none"]) .bulk-inactive-checkbox');
            visibleRows.forEach(cb => cb.checked = this.checked);
            updateBulkInactiveSubmitBtn();
        });

        checkboxes.forEach(cb => {
            cb.addEventListener('change', function () {
                updateBulkInactiveSubmitBtn();
                // Update select-all state
                const visibleCheckboxes = document.querySelectorAll('#bulkInactiveTableBody tr:not([style*="display: none"]) .bulk-inactive-checkbox');
                const allChecked = Array.from(visibleCheckboxes).every(c => c.checked);
                selectAll.checked = allChecked && visibleCheckboxes.length > 0;
            });
        });
    }

    function updateBulkInactiveSubmitBtn() {
        const checked = document.querySelectorAll('.bulk-inactive-checkbox:checked');
        const submitBtn = document.getElementById('bulkInactiveSubmitBtn');
        submitBtn.disabled = checked.length === 0;
    }

    function submitBulkInactive() {
        const checked = document.querySelectorAll('.bulk-inactive-checkbox:checked');
        const itemIds = Array.from(checked).map(cb => parseInt(cb.value));

        if (itemIds.length === 0) return;

        const submitBtn = document.getElementById('bulkInactiveSubmitBtn');
