<script>
    // Assign Units functionality
    let assignUnitsSelectedItemIds = [];

    function openAssignUnitsModal() {
        const overlay = document.getElementById('assignUnitsOverlay');
        overlay.classList.add('show');
        loadItemsWithoutUnit();
    }

    function closeAssignUnitsModal() {
        const overlay = document.getElementById('assignUnitsOverlay');
        overlay.classList.remove('show');
        document.getElementById('assignUnitsSearch').value = '';
    }

    function closeSelectUnitModal() {
        const overlay = document.getElementById('selectUnitOverlay');
        overlay.classList.remove('show');
    }

    function loadItemsWithoutUnit() {
        const tbody = document.getElementById('assignUnitsTableBody');
        tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:30px; color:#999;">Loading...</td></tr>';

        fetch('/Web/Items/GetItemsWithoutUnit', {
            method: 'GET',
            headers: { 'Accept': 'application/json' }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success && data.items) {
                renderAssignUnitsItems(data.items);
            } else {
                tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:30px; color:#dc3545;">Failed to load items</td></tr>';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:30px; color:#dc3545;">Error loading items</td></tr>';
        });
    }

    function renderAssignUnitsItems(items) {
        const tbody = document.getElementById('assignUnitsTableBody');

        if (!items || items.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:30px; color:#999;">No items without unit found</td></tr>';
            return;
        }

        tbody.innerHTML = items.map(item => `
            <tr data-item-id="${item.id}" data-item-name="${(item.itemName || '').toLowerCase()}">
                <td><input type="checkbox" class="assign-units-checkbox" value="${item.id}"></td>
                <td>${item.itemName || ''}</td>
                <td class="qty-value" style="text-align:right;">${item.quantity || 0}</td>
            </tr>
        `).join('');

        bindAssignUnitsCheckboxes();
    }

    function bindAssignUnitsCheckboxes() {
        const selectAll = document.getElementById('assignUnitsSelectAll');
        const checkboxes = document.querySelectorAll('.assign-units-checkbox');
        const nextBtn = document.getElementById('assignUnitsNextBtn');

        selectAll.checked = false;

        selectAll.addEventListener('change', function () {
            const visibleRows = document.querySelectorAll('#assignUnitsTableBody tr:not([style*="display: none"]) .assign-units-checkbox');
            visibleRows.forEach(cb => cb.checked = this.checked);
            updateAssignUnitsNextBtn();
        });

        checkboxes.forEach(cb => {
            cb.addEventListener('change', function () {
                updateAssignUnitsNextBtn();
                const visibleCheckboxes = document.querySelectorAll('#assignUnitsTableBody tr:not([style*="display: none"]) .assign-units-checkbox');
                const allChecked = Array.from(visibleCheckboxes).every(c => c.checked);
                selectAll.checked = allChecked && visibleCheckboxes.length > 0;
            });
        });
    }

    function updateAssignUnitsNextBtn() {
        const checked = document.querySelectorAll('.assign-units-checkbox:checked');
        const nextBtn = document.getElementById('assignUnitsNextBtn');
        nextBtn.disabled = checked.length === 0;
    }

    function showAssignUnitsStep2() {
        const checked = document.querySelectorAll('.assign-units-checkbox:checked');
        assignUnitsSelectedItemIds = Array.from(checked).map(cb => parseInt(cb.value));

        if (assignUnitsSelectedItemIds.length === 0) return;

        // Close step 1 and open step 2
        closeAssignUnitsModal();
        document.getElementById('selectUnitOverlay').classList.add('show');

        // Load units from master
        loadUnitsFromMaster();
    }

    function loadUnitsFromMaster() {
        fetch('/Web/Items/GetUnitsFromMaster', {
            method: 'GET',
            headers: { 'Accept': 'application/json' }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success && data.units) {
                const baseSelect = document.getElementById('baseUnitSelect');
                const secondarySelect = document.getElementById('secondaryUnitSelect');

                baseSelect.innerHTML = '<option value="">None</option>';
                secondarySelect.innerHTML = '<option value="">None</option>';

                data.units.forEach(unit => {
                    const label = unit.fullName + (unit.shortName ? ' (' + unit.shortName + ')' : '');
                    baseSelect.innerHTML += `<option value="${unit.fullName}">${label}</option>`;
                    secondarySelect.innerHTML += `<option value="${unit.fullName}">${label}</option>`;
                });
            }
        })
        .catch(error => {
            console.error('Error loading units:', error);
        });
    }

    function submitBulkAssignUnit() {
        const baseUnit = document.getElementById('baseUnitSelect').value;
        const secondaryUnit = document.getElementById('secondaryUnitSelect').value;

        if (!baseUnit) {
            toastr.error('Please select a base unit.');
            return;
        }

        const saveBtn = document.getElementById('assignUnitSaveBtn');
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';

        fetch('/Web/Items/BulkAssignUnit', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({
                itemIds: assignUnitsSelectedItemIds,
                baseUnit: baseUnit,
                secondaryUnit: secondaryUnit || ''
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                closeSelectUnitModal();
                toastr.success(data.message || 'Unit assigned successfully!');
                setTimeout(function() { window.location.reload(); }, 1500);
            } else {
                toastr.error(data.message || 'Failed to assign unit.');
                saveBtn.disabled = false;
                saveBtn.textContent = 'SAVE';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            toastr.error('An error occurred. Please try again.');
            saveBtn.disabled = false;
            saveBtn.textContent = 'SAVE';
        });
    }

    // Search within Assign Units modal
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('assignUnitsSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const term = this.value.toLowerCase();
