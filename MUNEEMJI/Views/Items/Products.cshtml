        font-weight: 600;
        cursor: pointer;
    }
    .stock-adj-save-btn:hover { background: #0069d9; }
    .stock-adj-save-btn:disabled { background: #ccc; cursor: not-allowed; }
</style>

<div class="stock-adj-overlay" id="stockAdjOverlay">
    <div class="stock-adj-modal">
        <div class="stock-adj-header">
            <div class="stock-adj-header-left">
                <h4>Stock Adjustment</h4>
                <div class="stock-adj-toggle">
                    <span class="stock-adj-toggle-label active" id="addStockLabel">Add Stock</span>
                    <div class="stock-adj-switch" id="stockAdjSwitch" onclick="toggleStockAdjType()">
                        <div class="stock-adj-switch-knob"></div>
                    </div>
                    <span class="stock-adj-toggle-label" id="reduceStockLabel">Reduce Stock</span>
                </div>
            </div>
            <button class="stock-adj-close" onclick="closeStockAdjustmentModal()">&times;</button>
        </div>
        <div class="stock-adj-body">
            <div class="stock-adj-item-row">
                <div class="stock-adj-item-name">
                    Item Name
                    <strong id="stockAdjItemName"></strong>
                </div>
                <div class="stock-adj-date-field">
                    <label>Adjustment Date</label>
                    <input type="date" id="stockAdjDate">
                </div>
            </div>
            <div class="stock-adj-fields">
                <div class="stock-adj-field">
                    <input type="number" id="stockAdjQty" placeholder="Total Qty" min="1">
                </div>
                <div class="stock-adj-field" style="max-width:90px;">
                    <select id="stockAdjUnit">
                        <option value="Pcs">Pcs</option>
                    </select>
                </div>
                <div class="stock-adj-field">
                    <input type="number" id="stockAdjPrice" placeholder="At Price" step="0.01" min="0">
                </div>
            </div>
            <div class="stock-adj-details">
                <div class="stock-adj-details-wrapper">
                    <label>Details</label>
                    <textarea id="stockAdjDetails" placeholder=""></textarea>
                </div>
            </div>
        </div>
        <div class="stock-adj-footer">
            <button class="stock-adj-save-btn" id="stockAdjSaveBtn" onclick="submitStockAdjustment()">Save</button>
        </div>
    </div>
</div>

<script>
    let stockAdjItemId = 0;
    let stockAdjType = 'add'; // 'add' or 'reduce'

    function openStockAdjustmentModal(itemId, itemName, unit) {
        stockAdjItemId = itemId;
        stockAdjType = 'add';

        document.getElementById('stockAdjItemName').textContent = itemName;
        document.getElementById('stockAdjDate').value = new Date().toISOString().split('T')[0];
        document.getElementById('stockAdjQty').value = '';
        document.getElementById('stockAdjPrice').value = '';
        document.getElementById('stockAdjDetails').value = '';

        // Set unit dropdown
        const unitSelect = document.getElementById('stockAdjUnit');
        unitSelect.innerHTML = `<option value="${unit}">${unit}</option>`;

        // Load units from master for the dropdown
        fetch('/Web/Items/GetUnitsFromMaster', { headers: { 'Accept': 'application/json' } })
            .then(r => r.json())
            .then(data => {
                if (data.success && data.units) {
                    unitSelect.innerHTML = '';
                    let hasCurrentUnit = false;
                    data.units.forEach(u => {
                        const label = u.shortName || u.fullName;
                        if (label === unit) hasCurrentUnit = true;
                        unitSelect.innerHTML += `<option value="${label}" ${label === unit ? 'selected' : ''}>${label}</option>`;
                    });
                    if (!hasCurrentUnit && unit) {
                        unitSelect.innerHTML = `<option value="${unit}" selected>${unit}</option>` + unitSelect.innerHTML;
                    }
                }
            })
            .catch(() => {});

        // Reset toggle to 'add'
        updateStockAdjToggle();

        document.getElementById('stockAdjOverlay').classList.add('show');
    }

    function closeStockAdjustmentModal() {
        document.getElementById('stockAdjOverlay').classList.remove('show');
    }

    function toggleStockAdjType() {
        stockAdjType = stockAdjType === 'add' ? 'reduce' : 'add';
        updateStockAdjToggle();
    }

    function updateStockAdjToggle() {
        const switchEl = document.getElementById('stockAdjSwitch');
        const addLabel = document.getElementById('addStockLabel');
        const reduceLabel = document.getElementById('reduceStockLabel');

        if (stockAdjType === 'reduce') {
            switchEl.classList.add('reduce');
            addLabel.classList.remove('active');
            reduceLabel.classList.add('active');
        } else {
            switchEl.classList.remove('reduce');
            addLabel.classList.add('active');
            reduceLabel.classList.remove('active');
        }
    }

    function submitStockAdjustment() {
        const qty = parseInt(document.getElementById('stockAdjQty').value);
        const price = parseFloat(document.getElementById('stockAdjPrice').value) || 0;
        const date = document.getElementById('stockAdjDate').value;
        const details = document.getElementById('stockAdjDetails').value;

        if (!qty || qty <= 0) {
            toastr.error('Please enter a valid quantity.');
            return;
        }

        const saveBtn = document.getElementById('stockAdjSaveBtn');
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';

        fetch('/Web/Items/AdjustStock', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({
                itemId: stockAdjItemId,
                adjustmentType: stockAdjType,
                totalQty: qty,
                atPrice: price,
                adjustmentDate: date,
                details: details
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                closeStockAdjustmentModal();
                toastr.success(data.message || 'Stock adjusted successfully!');
                setTimeout(function() { window.location.reload(); }, 1500);
            } else {
                toastr.error(data.message || 'Failed to adjust stock.');
                saveBtn.disabled = false;
                saveBtn.textContent = 'Save';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            toastr.error('An error occurred. Please try again.');
            saveBtn.disabled = false;
            saveBtn.textContent = 'Save';
        });
    }
</script>
