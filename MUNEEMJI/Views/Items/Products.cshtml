            cb.addEventListener('change', function () {
                updateBulkActiveSubmitBtn();
                const visibleCheckboxes = document.querySelectorAll('#bulkActiveTableBody tr:not([style*="display: none"]) .bulk-active-checkbox');
                const allChecked = Array.from(visibleCheckboxes).every(c => c.checked);
                selectAll.checked = allChecked && visibleCheckboxes.length > 0;
            });
        });
    }

    function updateBulkActiveSubmitBtn() {
        const checked = document.querySelectorAll('.bulk-active-checkbox:checked');
        const submitBtn = document.getElementById('bulkActiveSubmitBtn');
        submitBtn.disabled = checked.length === 0;
    }

    function submitBulkActive() {
        const checked = document.querySelectorAll('.bulk-active-checkbox:checked');
        const itemIds = Array.from(checked).map(cb => parseInt(cb.value));

        if (itemIds.length === 0) return;

        const submitBtn = document.getElementById('bulkActiveSubmitBtn');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Processing...';

        fetch('/Web/Items/BulkMarkActive', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({ itemIds: itemIds })
