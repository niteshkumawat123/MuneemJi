@model ItemViewModel

<div class="d-flex">
    <div class="sidebar">
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="product-search" placeholder="Search items...">
        </div>

        <button class="add-item-btn" onclick="window.location.href='/Web/Items/create';">
            <i class="fas fa-plus"></i> Add Item
        </button>

        <select class="godown-select" data-dropdown-source="Godowns">
            <option value="">Godown: All Godowns</option>
        </select>

        <div class="item-list">
            <div class="item-list-header">
                <div class="item-name">ITEM <i class="fas fa-filter"></i></div>
                <div class="item-quantity">QUANTITY</div>
            </div>
            @foreach (var item in Model.ItemView)
            {
                <div class="item-row">
                    <a href="#"
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center product-item-link @(item.Id == Model.SelectedItem?.Id ? "active" : "")"
                       data-item-id="@item.Id"
                       style="text-decoration: none; color: inherit; width: 100%; display: flex;">
                        <div class="item-name">@item.ItemName</div>
                        <div class="item-quantity">@item.OpeningQuantity</div>
                        <i class="fas fa-ellipsis-v" style="color: #6c757d;"></i>
                    </a>

                    <button type="button"
                            class="btn btn-link p-1"
                            data-bs-toggle="popover"
                            data-bs-placement="left"
                            data-bs-trigger="click"
                            data-bs-html="true"
                            data-bs-content='<a href="#" class="popover-action" onclick="viewItem(@item.Id); return false;">View</a><a href="#" class="popover-action" onclick="deleteItem(@item.Id); return false;">Delete</a>'
                            style="border: none; background: none; outline: none; cursor: pointer;">
                        <span style="font-size: 16px; color: #6c757d;">⋮</span>
                    </button>
                </div>
            }
        </div>
    </div>

    <div class="content-area" id="product-detail-area">
        @if (Model.SelectedItem != null)
        {
            <div class="product-header">
                <div class="product-title">
                    <span>@Model.SelectedItem.ItemName</span>
                    <a asp-action="Create" asp-route-id="@Model.SelectedItem.Id" class="btn btn-sm btn-outline-secondary ms-2 p-1">
                        <i class="bi bi-pencil"></i>
                    </a>
                </div>
            </div>

            <div class="product-info">
                <div class="info-card">
                    <div class="info-label">Sale Price</div>
                    <div class="info-value">₹ @((Model.SelectedItem?.SalePrice ?? 0).ToString("0.00")) (excl)</div>
                </div>
                <div class="info-card">
                    <div class="info-label">Purchase Price</div>
                    <div class="info-value">₹ @((Model.SelectedItem?.PurchasePrice ?? 0).ToString("0.00")) (excl)</div>
                </div>
                <div class="info-card">
                    <div class="info-label stock-warning">Stock Quantity</div>
                    <div class="info-value stock-warning">@(Model.SelectedItem?.OpeningQuantity ?? 0)</div>
                </div>
                <div class="info-card">
                    <div class="info-label">Stock Value</div>
                    <div class="info-value stock-value">₹ @((Model.SelectedItem?.OnlineStorePrice ?? 0).ToString("0.00"))</div>
                </div>
            </div>

            <div class="transactions-section">
                <div class="section-header">
                    <h3 class="section-title">TRANSACTIONS</h3>
                    <div class="search-transactions">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="Search transactions...">
                    </div>
                </div>

                <div class="transactions-table">
                    <table>
                        <thead>
                            <tr>
                                <th>TYPE <i class="fas fa-sort sort-icon"></i></th>
                                <th>INVOICE/REF. <i class="fas fa-sort sort-icon"></i></th>
                                <th>NAME <i class="fas fa-sort sort-icon"></i></th>
                                <th>DATE <i class="fas fa-sort-down sort-icon"></i></th>
                                <th>QUANTITY <i class="fas fa-sort sort-icon"></i></th>
                                <th>PRICE/UNIT <i class="fas fa-sort sort-icon"></i></th>
                                <th>STATUS <i class="fas fa-sort sort-icon"></i></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.SelectedItem.OpeningQuantity > 0)
                            {
                                <tr>
                                    <td>
                                        <span class="transaction-indicator indicator-purchase"></span>
                                        Purchase (Main ...)
                                    </td>
                                    <td>-</td>
                                    <td>test</td>
                                    <td>14/06/2025</td>
                                    <td>1 Btl</td>
                                    <td>₹ 1,233.00</td>
                                    <td>
                                        <span class="status-badge status-partial">Partial</span>
                                    </td>
                                    <td>
                                        <i class="fas fa-ellipsis-v" style="color: #6c757d; cursor: pointer;"></i>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="no-transactions">No transactions to show</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="loading-content">
                <div>
                    <i class="fas fa-box"></i>
                    <p>Select an item to view details</p>
                </div>
            </div>
        }
    </div>
</div>

<script>
        // Products Partial View JavaScript - JSON Version
    (function() {
        console.log('Products partial view loaded');

        // Handle product item click
        function initProductItemHandlers() {
            const productLinks = document.querySelectorAll('.product-item-link');

            productLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();

                    const itemId = this.getAttribute('data-item-id');

                    // Remove active class from all items
                    productLinks.forEach(l => l.classList.remove('active'));

                    // Add active class to clicked item
                    this.classList.add('active');

                    // Load product details via AJAX
                    loadProductDetails(itemId);
                });
            });
        }

        // Load product details and render JSON response
        function loadProductDetails(itemId) {
            const detailArea = document.getElementById('product-detail-area');

            if (!detailArea) {
                console.error('Product detail area not found');
                return;
            }

            // Show loading state
            detailArea.innerHTML = `
                <div class="loading-content" style="display: flex; justify-content: center; align-items: center; height: 400px;">
                    <div style="text-align: center; color: #6c757d;">
                        <i class="fas fa-spinner fa-spin" style="font-size: 32px; margin-bottom: 15px;"></i>
                        <p>Loading product details...</p>
                    </div>
                </div>`;

            // Make AJAX call to get product details as JSON
            fetch(`/Web/Items/ViewItemForPartial?id=${itemId}`, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                }
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Failed to load product details');
                }
                return response.json();
            })
            .then(data => {
                // Render the product details from JSON
                renderProductDetails(data);
            })
            .catch(error => {
                console.error('Error loading product details:', error);
                detailArea.innerHTML = `
                    <div class="loading-content" style="display: flex; justify-content: center; align-items: center; height: 400px;">
                        <div style="text-align: center; color: #dc3545;">
                            <i class="fas fa-exclamation-triangle" style="font-size: 32px; margin-bottom: 15px;"></i>
                            <p>Error loading product details</p>
                            <button class="btn btn-primary btn-sm" onclick="loadProductDetails(${itemId})">Retry</button>
                        </div>
                    </div>`;
            });
        }

        // Render product details from JSON data
        function renderProductDetails(item) {
            const detailArea = document.getElementById('product-detail-area');

            if (!item) {
                detailArea.innerHTML = `
                    <div class="loading-content">
                        <div>
                            <i class="fas fa-box"></i>
                            <p>Select an item to view details</p>
                        </div>
                    </div>`;
                return;
            }

            const salePrice = (item.salePrice || 0).toFixed(2);
            const purchasePrice = (item.purchasePrice || 0).toFixed(2);
            const openingQuantity = item.openingQuantity || 0;
            const stockValue = (item.onlineStorePrice || 0).toFixed(2);

            // Render transactions rows
            let transactionsHTML = '';
            if (item.transactions && item.transactions.length > 0) {
                debugger;
                transactionsHTML = item.transactions.map(transaction => `
                    <tr>
                        <td>
                            <span class="transaction-indicator indicator-${transaction.type?.toLowerCase()}"></span>
                            ${transaction.type || 'N/A'} (${transaction.location || 'N/A'})
                        </td>
                        <td>${transaction.invoiceRef || '-'}</td>
                        <td>${transaction.name || '-'}</td>
                        <td>${transaction.date || '-'}</td>
                        <td>${transaction.quantity || '-'}</td>
                        <td>₹ ${(transaction.pricePerUnit || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 })}</td>
                        <td>
                            <span class="status-badge status-${transaction.status?.toLowerCase()}">${transaction.status || 'N/A'}</span>
                        </td>
                        <td>
                            <i class="fas fa-ellipsis-v" style="color: #6c757d; cursor: pointer;"></i>
                        </td>
                    </tr>
                `).join('');
            } else if (openingQuantity > 0) {
                // Default transaction if no transactions array but has quantity
                transactionsHTML = `
                    <tr>
                        <td>
                            <span class="transaction-indicator indicator-purchase"></span>
                            Purchase (Main ...)
                        </td>
                        <td>-</td>
                        <td>test</td>
                        <td>14/06/2025</td>
                        <td>1 Btl</td>
                        <td>₹ 1,233.00</td>
                        <td>
                            <span class="status-badge status-partial">Partial</span>
                        </td>
                        <td>
                            <i class="fas fa-ellipsis-v" style="color: #6c757d; cursor: pointer;"></i>
                        </td>
                    </tr>
                `;
            } else {
                transactionsHTML = `
                    <tr>
                        <td colspan="8" class="no-transactions">No transactions to show</td>
                    </tr>
                `;
            }

            const html = `
                <div class="product-header">
                    <div class="product-title">
                        <span>${item.itemName || 'Unknown Item'}</span>
                        <a href="/Web/Items/Create?id=${item.id}" class="btn btn-sm btn-outline-secondary ms-2 p-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </div>
                </div>

                <div class="product-info">
                    <div class="info-card">
                        <div class="info-label">Sale Price</div>
                        <div class="info-value">₹ ${salePrice} (excl)</div>
                    </div>
                    <div class="info-card">
                        <div class="info-label">Purchase Price</div>
                        <div class="info-value">₹ ${purchasePrice} (excl)</div>
                    </div>
                    <div class="info-card">
                        <div class="info-label stock-warning">Stock Quantity</div>
                        <div class="info-value stock-warning">${openingQuantity}</div>
                    </div>
                    <div class="info-card">
                        <div class="info-label">Stock Value</div>
                        <div class="info-value stock-value">₹ ${stockValue}</div>
                    </div>
                </div>

                <div class="transactions-section">
                    <div class="section-header">
                        <h3 class="section-title">TRANSACTIONS</h3>
                        <div class="search-transactions">
                            <i class="fas fa-search"></i>
                            <input type="text" placeholder="Search transactions...">
                        </div>
                    </div>

                    <div class="transactions-table">
                        <table>
                            <thead>
                                <tr>
                                    <th>TYPE <i class="fas fa-sort sort-icon"></i></th>
                                    <th>INVOICE/REF. <i class="fas fa-sort sort-icon"></i></th>
                                    <th>NAME <i class="fas fa-sort sort-icon"></i></th>
                                    <th>DATE <i class="fas fa-sort-down sort-icon"></i></th>
                                    <th>QUANTITY <i class="fas fa-sort sort-icon"></i></th>
                                    <th>PRICE/UNIT <i class="fas fa-sort sort-icon"></i></th>
                                    <th>STATUS <i class="fas fa-sort sort-icon"></i></th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                ${transactionsHTML}
                            </tbody>
                        </table>
                    </div>
                </div>
            `;

            detailArea.innerHTML = html;
        }

        // Search functionality
        function initProductSearch() {
            const searchInput = document.getElementById('product-search');

            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    const searchTerm = this.value.toLowerCase();
                    const itemRows = document.querySelectorAll('.item-row');

                    itemRows.forEach(row => {
                        const itemName = row.querySelector('.item-name')?.textContent.toLowerCase();
                        if (itemName && (itemName.includes(searchTerm) || searchTerm === '')) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });
            }
        }

        // Initialize when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
                initProductItemHandlers();
                initProductSearch();
            });
        } else {
            initProductItemHandlers();
            initProductSearch();
        }

        // Make functions available globally
        window.loadProductDetails = loadProductDetails;
        window.renderProductDetails = renderProductDetails;
    })();
</script>