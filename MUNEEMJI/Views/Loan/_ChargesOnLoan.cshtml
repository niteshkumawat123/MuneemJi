<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
    <div id="successToastCharges" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" style="font-size:12px;">
                <i class="fas fa-check-circle me-2"></i>
                Charges saved successfully!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<div class="modal fade" id="chargesOnLoanModal" tabindex="-1" aria-labelledby="chargesOnLoanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content">
            <div class="modal-header" style="padding:10px 14px;background:#f8f9fa;border-bottom:1px solid #dee2e6;">
                <h6 class="modal-title" id="chargesOnLoanModalLabel" style="font-size:13px;font-weight:600;margin:0;">Charges On Loan</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="font-size:10px;"></button>
            </div>
            <div class="modal-body" style="padding:14px;">
                <form id="chargesOnLoanForm">
                    <input type="hidden" id="chargesLoanAccountId" />

                    <div class="mb-2">
                        <label class="form-label" style="font-size:11px;color:#555;margin-bottom:3px;">Transaction Type Name<span style="color:#dc3545;">*</span></label>
                        <input type="text" id="transactionTypeName" class="form-control-custom" placeholder="Example: Penalty on Missing EMI" required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label" style="font-size:11px;color:#555;margin-bottom:3px;">Date</label>
                        <input type="date" id="chargesDate" class="form-control-custom" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label" style="font-size:11px;color:#555;margin-bottom:3px;">Amount</label>
                        <input type="number" id="chargesAmount" class="form-control-custom" placeholder="0" step="0.01" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label" style="font-size:11px;color:#555;margin-bottom:3px;">Loan Received In</label>
                        <select id="chargesLoanReceivedIn" class="form-control-custom">
                            <option value="Cash">Cash</option>
                            <option value="Bank">Bank</option>
                            <option value="Cheque">Cheque</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="padding:8px 14px;border-top:1px solid #dee2e6;">
                <button type="button" class="btn btn-sm" style="font-size:11px;padding:4px 12px;background:#f5f5f5;color:#666;border:1px solid #dee2e6;border-radius:4px;" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm" style="font-size:11px;padding:4px 12px;background:#dc3545;color:#fff;border:none;border-radius:4px;" onclick="saveChargesOnLoan()">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        const today = new Date().toISOString().split('T')[0];
        $('#chargesDate').val(today);
        $('#chargesLoanAccountId').val(currentAccountId);
    });

    function saveChargesOnLoan() {
        const formData = {
            LoanAccountId: $('#chargesLoanAccountId').val(),
            TransactionTypeName: $('#transactionTypeName').val(),
            Date: $('#chargesDate').val(),
            Amount: $('#chargesAmount').val(),
            LoanReceivedIn: $('#chargesLoanReceivedIn').val()
        };

        if (!formData.TransactionTypeName) {
            alert('Please enter transaction type name');
            return;
        }

        if (!formData.Amount) {
            alert('Please enter amount');
            return;
        }

        $.ajax({
            url: '@Url.Action("SaveChargesOnLoan")',
            type: 'POST',
            data: JSON.stringify(formData),
            contentType: 'application/json',
            success: function(response) {
                if (response.success) {
                    var modal = bootstrap.Modal.getInstance(document.getElementById('chargesOnLoanModal'));
                    modal.hide();
                    var successToast = new bootstrap.Toast(document.getElementById('successToastCharges'));
                    successToast.show();
                    loadAccountDetails(currentAccountId);
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function(xhr, status, error) {
                alert('Error saving charges: ' + error);
            }
        });
    }
</script>