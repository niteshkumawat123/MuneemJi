<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
    <div id="successToastLoan" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" style="font-size:12px;">
                <i class="fas fa-check-circle me-2"></i>
                Loan Transaction Credited successfully!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<div class="modal fade" id="takeMoreLoanModal" tabindex="-1" aria-labelledby="takeMoreLoanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content">
            <div class="modal-header" style="padding:10px 14px;background:#f8f9fa;border-bottom:1px solid #dee2e6;">
                <h6 class="modal-title" id="takeMoreLoanModalLabel" style="font-size:13px;font-weight:600;margin:0;">Take More Loan</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="font-size:10px;"></button>
            </div>
            <div class="modal-body" style="padding:14px;">
                <form id="takeMoreLoanForm">
                    <input type="hidden" id="moreLoanAccountId" />

                    <div class="mb-2">
                        <label class="form-label" style="font-size:11px;color:#555;margin-bottom:3px;">Loan Amount<span style="color:#dc3545;">*</span></label>
                        <input type="number" id="loanAmount" class="form-control-custom" placeholder="0" step="0.01" required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label" style="font-size:11px;color:#555;margin-bottom:3px;">Date</label>
                        <input type="date" id="moreLoanDate" class="form-control-custom" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label" style="font-size:11px;color:#555;margin-bottom:3px;">Loan Received In</label>
                        <select id="moreLoanReceivedIn" class="form-control-custom">
                            <option value="Cash">Cash</option>
                            <option value="Bank">Bank</option>
                            <option value="Cheque">Cheque</option>
                        </select>
                    </div>

                    <div class="mb-2">
                        <label class="form-label" style="font-size:11px;color:#555;margin-bottom:3px;">Interest Rate</label>
                        <div style="position:relative;">
                            <input type="number" id="moreLoanInterestRate" class="form-control-custom" placeholder="0" step="0.01" style="padding-right:70px;" />
                            <span style="position:absolute;right:8px;top:50%;transform:translateY(-50%);font-size:10px;color:#888;">% per annum</span>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label" style="font-size:11px;color:#555;margin-bottom:3px;">Term Duration (Months)</label>
                        <input type="number" id="moreLoanTermDuration" class="form-control-custom" placeholder="0" />
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="padding:8px 14px;border-top:1px solid #dee2e6;">
                <button type="button" class="btn btn-sm" style="font-size:11px;padding:4px 12px;background:#f5f5f5;color:#666;border:1px solid #dee2e6;border-radius:4px;" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm" style="font-size:11px;padding:4px 12px;background:#dc3545;color:#fff;border:none;border-radius:4px;" onclick="saveTakeMoreLoan()">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        const today = new Date().toISOString().split('T')[0];
        $('#moreLoanDate').val(today);
        $('#moreLoanAccountId').val(currentAccountId);
    });

    function saveTakeMoreLoan() {
        const formData = {
            LoanAccountId: $('#moreLoanAccountId').val(),
            LoanAmount: $('#loanAmount').val(),
            Date: $('#moreLoanDate').val(),
            LoanReceivedIn: $('#moreLoanReceivedIn').val(),
            InterestRate: $('#moreLoanInterestRate').val() || 0,
            TermDuration: $('#moreLoanTermDuration').val() || 0
        };

        if (!formData.LoanAmount) {
            alert('Please enter loan amount');
            return;
        }

        $.ajax({
            url: '@Url.Action("SaveTakeMoreLoan")',
            type: 'POST',
            data: JSON.stringify(formData),
            contentType: 'application/json',
            success: function(response) {
                if (response.success) {
                    var modal = bootstrap.Modal.getInstance(document.getElementById('takeMoreLoanModal'));
                    modal.hide();
                    var successToast = new bootstrap.Toast(document.getElementById('successToastLoan'));
                    successToast.show();
                    loadAccountDetails(currentAccountId);
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function(xhr, status, error) {
                alert('Error saving loan: ' + error);
            }
        });
    }
</script>