<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="fas fa-check-circle me-2"></i>
                Loan Transection Creadited succssfully!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<div class="modal fade" id="takeMoreLoanModal" tabindex="-1" aria-labelledby="takeMoreLoanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 450px;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="takeMoreLoanModalLabel">Take More Loan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="takeMoreLoanForm">
                    <input type="hidden" id="moreLoanAccountId" />

                    <div class="form-group mb-3">
                        <label class="form-label">Loan Amount<span class="required-asterisk">*</span></label>
                        <input type="number" id="loanAmount" class="form-control-custom" placeholder="0" step="0.01" required />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Date</label>
                        <input type="date" id="moreLoanDate" class="form-control-custom" />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Loan Received In</label>
                        <select id="moreLoanReceivedIn" class="form-control-custom">
                            <option value="Cash">Cash</option>
                            <option value="Bank">Bank</option>
                            <option value="Cheque">Cheque</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Interest Rate</label>
                        <div class="input-with-label">
                            <input type="number" id="moreLoanInterestRate" class="form-control-custom" placeholder="0" step="0.01" style="padding-right: 80px;" />
                            <span class="input-suffix">% per annum</span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Term Duration (in Months)</label>
                        <input type="number" id="moreLoanTermDuration" class="form-control-custom" placeholder="0" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-save" onclick="saveTakeMoreLoan()">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        // Set current date
        const today = new Date().toISOString().split('T')[0];
        $('#moreLoanDate').val(today);

        // Set current account ID
        $('#moreLoanAccountId').val(currentAccountId);
    });

    function saveTakeMoreLoan() {
        const formData = {
            LoanAccountId: $('#moreLoanAccountId').val(),
            LoanAmount: $('#loanAmount').val(),
            Date: $('#moreLoanDate').val(),
            LoanReceivedIn: $('#moreLoanReceivedIn').val(),
            InterestRate: $('#moreLoanInterestRate').val() || 0,
            TermDuration: $('#moreLoanTermDuration').val() || 0
        };

        if (!formData.LoanAmount) {
            alert('Please enter loan amount');
            return;
        }

        showLoading();

        $.ajax({
            url: '@Url.Action("SaveTakeMoreLoan")',
            type: 'POST',
            data: JSON.stringify(formData),
            contentType: 'application/json',
            success: function(response) {
                hideLoading();
                if (response.success) {
                    var modal = bootstrap.Modal.getInstance(document.getElementById('takeMoreLoanModal'));
                    modal.hide();
                   var successToast = new bootstrap.Toast(document.getElementById('successToast'));
                   successToast.show() ; 
                   loadAccountDetails(currentAccountId);
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function(xhr, status, error) {
                hideLoading();
                alert('Error saving loan: ' + error);
            }
        });
    }
</script>