@model OtherIncomeModel

@{
    ViewData["Title"] = "Create Bill";
}
@{
    Layout = "~/Views/Shared/_Layout.cshtml"; // or your layout
}

<style>
    .form-container {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
    }

    .search-section {
        background: white;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
        border: 1px solid #dee2e6;
    }

    .bill-info-section {
        background: white;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
        border: 1px solid #dee2e6;
    }

    .items-section {
        background: white;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
        border: 1px solid #dee2e6;
    }

    .transport-section {
        background: white;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
        border: 1px solid #dee2e6;
    }

    .payment-section {
        background: white;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
        border: 1px solid #dee2e6;
    }

    .items-table {
        width: 100%;
        margin-top: 15px;
    }

        .items-table th {
            background-color: #f8f9fa;
            font-weight: bold;
            padding: 8px;
            text-align: center;
            border: 1px solid #dee2e6;
            font-size: 12px;
        }

        .items-table td {
            padding: 5px;
            border: 1px solid #dee2e6;
            text-align: center;
        }

        .items-table input, .items-table select {
            width: 100%;
            border: none;
            padding: 5px;
            text-align: center;
            font-size: 12px;
        }

    .total-row {
        background-color: #f8f9fa;
        font-weight: bold;
    }

    .btn-add-row {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 4px;
        margin-top: 10px;
    }

    .form-control-sm {
        font-size: 12px;
        padding: 4px 8px;
    }

    .checkbox-container {
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .action-buttons {
        text-align: right;
        margin-top: 20px;
    }

    .btn-share {
        background-color: #6c757d;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 4px;
        margin-right: 10px;
    }

    .btn-save {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 10px 30px;
        border-radius: 4px;
    }

    .upload-area-imgshow:hover {
        border-color: #0056b3;
        background: #f0f4ff;
    }
</style>

<div class="container-fluid">
    <form asp-action="Create" method="post" enctype="multipart/form-data" id="billForm">
        <div class="form-container">
            <input type="hidden" id="deleteLogoFlag" name="OtherIncomeView.IsDeleteImage" value="false" />
            
            <!-- Hidden fields for category name and totals -->
            <input type="hidden" id="categoryNameHidden" name="OtherIncomeView.IncomeCategory" value="" />
            <input type="hidden" id="totalAmountHidden" name="OtherIncomeView.Total" value="0" />
            <input type="hidden" id="roundOffValueHidden" name="OtherIncomeView.RoundOff" value="0" />

            <!-- Search Section -->
            <div class="search-section">
                <div class="row">
                    <div class="col-md-2">
                        <label>Category</label>
                        <select class="form-control form-control-sm custom-dropdown" id="partyDropdown" name="OtherIncomeView.IncomeCategoryId" onchange="updateCategoryName()">
                            <option value="">Select</option>
                            @if (Model?.Categories != null)
                            {
                                <!-- Header Option (disabled and styled) -->
                                <option disabled class="dropdown-header">
                                    <span class="header-item">Category Name</span>
                                </option>

                                @if (Model?.Categories != null)
                                {
                                    foreach (var category in Model.Categories)
                                    {
                                        if (category != null)
                                        {
                                            <option value="@category.Id"
                                                    data-name="@category.Name"
                                                    class="category-option"
                                                    selected="@(Model?.OtherIncomeView?.IncomeCategoryId == category.Id)">
                                                @(category.Name ?? "Unnamed Category")
                                            </option>
                                        }
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label>Date</label>
                        <input asp-for="OtherIncomeView.EntryDate" type="date" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>

            <!-- Items Section -->
            <div class="items-section">
                <table class="items-table">
                    <thead>
                        <tr>
                            <th style="width: 5%">#</th>
                            <th style="width: 45%">ITEM NAME</th>
                            <th style="width: 15%">QTY</th>
                            <th style="width: 15%">PRICE/UNIT<br />Without Tax</th>
                            <th style="width: 15%">AMOUNT</th>
                            <th style="width: 5%">Action</th>
                        </tr>
                    </thead>
                    <tbody id="itemsTableBody">
                        @if (Model?.OtherIncomeView?.Items != null && Model.OtherIncomeView.Items.Any())
                        {
                            @for (int i = 0; i < Model.OtherIncomeView.Items.Count; i++)
                            {
                                var item = Model.OtherIncomeView.Items[i];
                                if (item != null)
                                {
                                    <tr class="item-row" data-index="@i">
                                        <td>@(i + 1)</td>
                                        <td>
                                            <input asp-for="OtherIncomeView.Items[i].ItemName" type="text" class="form-control-sm item-name-input" value="@(item.ItemName ?? "")" />
                                        </td>
                                        <td>
                                            <input asp-for="OtherIncomeView.Items[i].Qty" type="number" step="0.01" class="form-control-sm qty-input" value="@(item.Qty)" onchange="calculateItemAmount(@i)" />
                                        </td>
                                        <td>
                                            <input asp-for="OtherIncomeView.Items[i].PricePerUnit" type="number" step="0.01" class="form-control-sm price-input" value="@(item.PricePerUnit)" onchange="calculateItemAmount(@i)" />
                                        </td>
                                        <td>
                                            <input asp-for="OtherIncomeView.Items[i].Amount" type="number" step="0.01" class="form-control-sm item-amount" value="@(item.Amount)" readonly />
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-danger" onclick="removeRow(@i)">×</button>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr class="total-row">
                            <td colspan="5" style="text-align: right; font-weight: bold;">TOTAL</td>
                            <td><span id="grandTotal">0</span></td>
                        </tr>
                    </tfoot>
                </table>
                <button type="button" class="btn-add-row" onclick="addNewRow()">ADD ROW</button>
            </div>

            <!-- Payment Section -->
            <div class="payment-section">
                <div class="row">
                    <div class="col-md-3">
                        <label>Payment Type</label>
                        <select asp-for="OtherIncomeView.PaymentType" class="form-control form-control-sm">
                            <option value="Cash">Cash</option>
                            <option value="Check">Check</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>ADD DESCRIPTION</label>
                        <textarea asp-for="OtherIncomeView.Description" class="form-control form-control-sm" rows="2" placeholder="Add description"></textarea>
                    </div>
                    <div class="col-md-3">
                        <div class="floating-label-container upload-area-imgshow"
                             style="border: 2px solid lightgray; border-radius: 8px; padding: 20px; text-align: center; background: #f8f9fb; cursor: pointer; transition: all 0.3s ease; position: relative;"
                             onclick="document.querySelector('input[name=\'OtherIncomeView.ImageUrl\']').click()">

                            <span class="upload-label-imgshow"
                                  style="position: absolute; top: -10px; left: 20px; background: white; padding: 0 8px; color: #6c757d; font-size: 14px;">
                                Add Image
                            </span>

                            <input type="file" name="OtherIncomeView.ImageUrl" class="floating-input" accept="image/*"
                                   onchange="previewImage(this)" style="display: none;" />

                            <div class="upload-content-imgshow">
                                <i class="bi bi-cloud-upload" style="font-size: 24px; color: #007bff; margin-bottom: 8px;"></i>
                                <div style="color: #007bff; font-weight: 500;">Upload</div>
                                <div style="color: #6c757d; font-size: 12px; margin-top: 4px;">Click to browse files</div>
                            </div>

                            <div class="image-preview-imgshow" style="display: none;">
                                <img id="preview-img-imgshow" src="" alt="Preview"
                                     style="max-width: 200px; max-height: 85px; border: 1px solid #ddd; border-radius: 4px;" />
                                <div id="image-name-imgshow" style="margin-top: 8px; color: #6c757d; font-size: 12px; word-break: break-all;"></div>
                                <div style="margin-top: 8px;">
                                    <button type="button" onclick="removeImage(event)" style="padding: 5px 15px; background: #007bff; color: white; border: none; border-radius: 3px; cursor: pointer;">
                                        Delete
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="checkbox-container">
                            <input asp-for="OtherIncomeView.IsRoundOff" type="checkbox" checked onchange="updateGrandTotal()" />
                            <label asp-for="OtherIncomeView.RoundOff">Round Off</label>
                            <span id="roundOffAmount">0</span>
                            <span style="margin-left: 20px;">Total: <strong id="finalTotal">0</strong></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="action-buttons">
                <button type="button" class="btn-share">Share ▼</button>
                <button type="button" class="btn-save" onclick="showSaveConfirmation()">Save</button>
            </div>

        </div>
    </form>

    <!-- Confirmation Modal -->
    <div class="modal fade" id="confirmationModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmationModalTitle">Confirm Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="confirmationModalBody">
                    Are you sure you want to proceed?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                    <button type="button" class="btn btn-primary" id="confirmationModalYes">Yes</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Message Modal -->
    <div class="modal fade" id="messageModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="messageModalTitle">Message</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="messageModalBody">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal" onclick="redirectToIndex()">OK</button>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    let itemIndex = @(Model?.OtherIncomeView?.Items?.Count ?? 0);

    // Update category name in hidden field when dropdown changes
    function updateCategoryName() {
        const dropdown = document.getElementById('partyDropdown');
        const categoryNameHidden = document.getElementById('categoryNameHidden');
        
        if (dropdown && categoryNameHidden) {
            const selectedOption = dropdown.options[dropdown.selectedIndex];
            const categoryName = selectedOption ? selectedOption.getAttribute('data-name') : '';
            categoryNameHidden.value = categoryName || '';
        }
    }

    function addNewRow() {
        const tbody = document.getElementById('itemsTableBody');
        if (!tbody) return;

        const newRow = document.createElement('tr');
        newRow.className = 'item-row';
        newRow.setAttribute('data-index', itemIndex);

        newRow.innerHTML = `
            <td>${itemIndex + 1}</td>
            <td><input name="OtherIncomeView.Items[${itemIndex}].ItemName" type="text" class="form-control-sm item-name-input" /></td>
            <td><input name="OtherIncomeView.Items[${itemIndex}].Qty" type="number" step="0.01" class="form-control-sm qty-input" onchange="calculateItemAmount(${itemIndex})" /></td>
            <td><input name="OtherIncomeView.Items[${itemIndex}].PricePerUnit" type="number" step="0.01" class="form-control-sm price-input" onchange="calculateItemAmount(${itemIndex})" /></td>
            <td><input name="OtherIncomeView.Items[${itemIndex}].Amount" type="number" step="0.01" class="form-control-sm item-amount" readonly /></td>
            <td><button type="button" class="btn btn-sm btn-danger" onclick="removeRow(${itemIndex})">×</button></td>
        `;

        tbody.appendChild(newRow);
        itemIndex++;
        updateRowNumbers();
    }

    function removeRow(index) {
        const row = document.querySelector(`tr[data-index="${index}"]`);
        if (row) {
            row.remove();
            updateGrandTotal();
            updateRowNumbers();
        }
    }

    function updateRowNumbers() {
        const rows = document.querySelectorAll('#itemsTableBody .item-row');
        if (rows) {
            rows.forEach((row, index) => {
                const firstCell = row.querySelector('td:first-child');
                if (firstCell) {
                    firstCell.textContent = index + 1;
                }
            });
        }
    }

    function calculateItemAmount(index) {
        const row = document.querySelector(`tr[data-index="${index}"]`);
        if (!row) return;

        const quantityInput = row.querySelector('.qty-input');
        const priceInput = row.querySelector('.price-input');
        const amountInput = row.querySelector('.item-amount');

        if (!quantityInput || !priceInput || !amountInput) return;

        const quantity = parseFloat(quantityInput.value) || 0;
        const pricePerUnit = parseFloat(priceInput.value) || 0;
        const amount = quantity * pricePerUnit;

        amountInput.value = amount.toFixed(2);
        updateGrandTotal();
    }

    function updateGrandTotal() {
        let total = 0;
        const amountInputs = document.querySelectorAll('.item-amount');

        if (amountInputs) {
            amountInputs.forEach(input => {
                const value = parseFloat(input.value) || 0;
                total += value;
            });
        }

        const grandTotalElement = document.getElementById('grandTotal');
        if (grandTotalElement) {
            grandTotalElement.textContent = total.toFixed(2);
        }

        const roundOffCheckbox = document.querySelector('input[name="OtherIncomeView.IsRoundOff"]');
        const roundOffAmountElement = document.getElementById('roundOffAmount');
        const finalTotalElement = document.getElementById('finalTotal');

        // Update hidden fields
        const totalAmountHidden = document.getElementById('totalAmountHidden');
        const roundOffValueHidden = document.getElementById('roundOffValueHidden');
        const finalTotalHidden = document.getElementById('finalTotalHidden');

        if (roundOffCheckbox && roundOffAmountElement && finalTotalElement) {
            const roundOff = roundOffCheckbox.checked;
            let finalTotal = roundOff ? Math.round(total) : total;
            let roundOffAmount = finalTotal - total;

            roundOffAmountElement.textContent = roundOffAmount.toFixed(2);
            finalTotalElement.textContent = finalTotal.toFixed(2);

            // Update hidden fields
            if (totalAmountHidden) totalAmountHidden.value = total.toFixed(2);
            if (roundOffValueHidden) roundOffValueHidden.value = roundOffAmount.toFixed(2);
            if (finalTotalHidden) finalTotalHidden.value = finalTotal.toFixed(2);
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Initialize category name on load
        updateCategoryName();

        // Calculate initial amounts for existing rows
        const existingRows = document.querySelectorAll('.item-row');
        if (existingRows) {
            existingRows.forEach((row, index) => {
                const dataIndex = row.getAttribute('data-index');
                if (dataIndex !== null && dataIndex !== undefined) {
                    calculateItemAmount(parseInt(dataIndex));
                }
            });
        }

        const roundOffCheckbox = document.querySelector('input[name="OtherIncomeView.IsRoundOff"]');
        if (roundOffCheckbox) {
            roundOffCheckbox.addEventListener('change', updateGrandTotal);
        }

        // Initial total calculation
        updateGrandTotal();
    });
</script>

<script>
    function previewImage(input) {
        if (!input || !input.files || !input.files[0]) return;

        const file = input.files[0];
        const reader = new FileReader();
        
        reader.onload = function(e) {
            const uploadContent = document.querySelector('.upload-content-imgshow');
            const imagePreview = document.querySelector('.image-preview-imgshow');
            const previewImg = document.getElementById('preview-img-imgshow');
            const imageName = document.getElementById('image-name-imgshow');
            const uploadArea = document.querySelector('.upload-area-imgshow');
            const deleteFlag = document.getElementById('deleteLogoFlag');

            if (uploadContent) uploadContent.style.display = 'none';
            if (imagePreview) imagePreview.style.display = 'block';
            if (previewImg) previewImg.src = e.target.result;
            if (imageName) imageName.textContent = file.name;
            if (uploadArea) uploadArea.style.borderColor = '#28a745';
            if (deleteFlag) deleteFlag.value = 'false';
        };
        
        reader.readAsDataURL(file);
    }

    function setLogoFromData(imageUrl, imageName) {
        const uploadContent = document.querySelector('.upload-content-imgshow');
        const imagePreview = document.querySelector('.image-preview-imgshow');
        const previewImg = document.getElementById('preview-img-imgshow');
        const imageNameEl = document.getElementById('image-name-imgshow');
        const uploadArea = document.querySelector('.upload-area-imgshow');
        const deleteFlag = document.getElementById('deleteLogoFlag');

        if (uploadContent) uploadContent.style.display = 'none';
        if (imagePreview) imagePreview.style.display = 'block';
        if (previewImg) previewImg.src = imageUrl;
        if (imageNameEl) imageNameEl.textContent = imageName || 'Loaded Image';
        if (uploadArea) uploadArea.style.borderColor = '#28a745';
        if (deleteFlag) deleteFlag.value = 'false';
    }

    function removeImage(event) {
        if (event) event.stopPropagation();

        const fileInput = document.querySelector('input[name="OtherIncomeView.ImageUrl"]');
        const uploadContent = document.querySelector('.upload-content-imgshow');
        const imagePreview = document.querySelector('.image-preview-imgshow');
        const previewImg = document.getElementById('preview-img-imgshow');
        const imageName = document.getElementById('image-name-imgshow');
        const uploadArea = document.querySelector('.upload-area-imgshow');
        const deleteFlag = document.getElementById('deleteLogoFlag');

        if (fileInput) fileInput.value = '';
        if (uploadContent) uploadContent.style.display = 'block';
        if (imagePreview) imagePreview.style.display = 'none';
        if (previewImg) previewImg.src = '';
        if (imageName) imageName.textContent = '';
        if (uploadArea) uploadArea.style.borderColor = 'lightgray';
        if (deleteFlag) deleteFlag.value = 'true';
    }

    document.addEventListener('DOMContentLoaded', function() {
        var logoPath = '@Html.Raw(Model?.OtherIncomeView?.BaseImageUrl ?? "")';

        // If logo exists, display it
        if (logoPath && logoPath !== '') {
            var logoUrl = logoPath.startsWith('/') ? logoPath : '/' + logoPath;
            var logoFileName = logoPath.split('/').pop();
            setLogoFromData(logoUrl, logoFileName);
        }
    });

    function showSaveConfirmation() {
        const confirmTitle = document.getElementById('confirmationModalTitle');
        const confirmBody = document.getElementById('confirmationModalBody');

        if (confirmTitle) confirmTitle.textContent = 'Confirm Save';
        if (confirmBody) confirmBody.textContent = 'Are you sure you want to save?';

        const confirmModalElement = document.getElementById('confirmationModal');
        if (confirmModalElement) {
            const confirmModal = new bootstrap.Modal(confirmModalElement);
            confirmModal.show();

            const yesButton = document.getElementById('confirmationModalYes');
            if (yesButton) {
                yesButton.onclick = function() {
                    confirmModal.hide();
                    submitForm();
                };
            }
        }
    }

    function submitForm() {
        // Update hidden fields before submission
        updateCategoryName();
        updateGrandTotal();

        const form = document.getElementById('billForm');
        if (!form) return;

        const formData = new FormData(form);

        fetch(form.action, {
            method: 'POST',
            body: formData
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            return response.json();
        })
        .then(data => {
            showMessageModal(data.success, data.message);
        })
        .catch(error => {
            console.error('Error:', error);
            showMessageModal(false, 'An error occurred while saving.');
        });
    }

    function showMessageModal(isSuccess, message) {
        const messageModalElement = document.getElementById('messageModal');
        if (!messageModalElement) return;

        const messageModal = new bootstrap.Modal(messageModalElement);
        const messageTitle = document.getElementById('messageModalTitle');
        const messageBody = document.getElementById('messageModalBody');
        const modalHeader = messageModalElement.querySelector('.modal-header');

        if (messageTitle) messageTitle.textContent = isSuccess ? 'Success' : 'Error';
        if (messageBody) messageBody.textContent = message || 'No message provided';
        
        if (modalHeader) {
            modalHeader.style.backgroundColor = isSuccess ? '#28a745' : '#dc3545';
            modalHeader.style.color = 'white';
        }

        messageModal.show();
    }

    function redirectToIndex() {
        window.location.href = '/Web/OtherIncome/Index';
    }
</script>