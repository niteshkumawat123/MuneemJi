@model ItemViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml"; // or your layout
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #f5f7fa;
        min-height: 100vh;
        padding: 0;
        margin: 0;
    }

    .income-page-title {
        text-align: center;
        color: #999;
        font-size: 18px;
        font-weight: 500;
        padding: 20px 0;
        background: white;
        margin-bottom: 0;
        border-bottom: 1px solid #e9ecef;
    }

    .income-container {
       
        height: calc(100vh - 80px);
        margin: 0 auto;
        background: white;
        border-radius: 0;
        box-shadow: none;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        padding: 0;
    }

    .income-main-content {
        display: flex;
        flex: 1;
        overflow: hidden;
        padding-left: 0px;
    }

    .income-sidebar {
        width: 340px;
        background: white;
        border-right: 1px solid #e9ecef;
        padding: 0;
        flex-shrink: 0;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }

    .income-sidebar-header {
        padding: 20px;
        border-bottom: 1px solid #e9ecef;
        background: #f8f9fa;
    }

    .income-search-box {
        position: relative;
        margin-bottom: 15px;
    }

        .income-search-box input {
            width: 100%;
            padding: 10px 15px 10px 40px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 14px;
            background: white;
        }

        .income-search-box i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
            font-size: 14px;
        }

    .income-add-item-btn {
        background: #ff9500;
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
        width: 100%;
        font-size: 14px;
        transition: all 0.3s ease;
    }

        .income-add-item-btn:hover {
            background: #e6850e;
        }

        .income-add-item-btn i {
            margin-right: 8px;
        }

    .income-item-list {
        flex: 1;
        overflow-y: auto;
    }

    .income-item-list-header {
        display: flex;
        background: #f8f9fa;
        padding: 15px 20px;
        font-weight: 600;
        color: #495057;
        border-bottom: 1px solid #e9ecef;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .income-item-name {
        flex: 1;
        display: flex;
        align-items: center;
    }

        .income-item-name i {
            margin-left: 5px;
            font-size: 10px;
            color: #6c757d;
        }

    .income-item-quantity {
        width: 80px;
        text-align: right;
        font-weight: 600;
    }

    .income-item-row {
        border-bottom: 1px solid #f1f3f4;
    }

        .income-item-row a {
            display: flex;
            padding: 15px 20px;
            align-items: center;
            color: #2c3e50;
            text-decoration: none;
            transition: all 0.2s ease;
        }

            .income-item-row a:hover {
                background: #f8f9fa;
                text-decoration: none;
            }

            .income-item-row a.active {
                background: #e3f2fd;
                border-left: 3px solid #2196f3;
                color: #1976d2;
            }

        .income-item-row .income-item-name {
            font-size: 14px;
            font-weight: 500;
        }

        .income-item-row .income-item-quantity {
            font-size: 14px;
            font-weight: 600;
            color: #28a745;
        }

        .income-item-row i.fa-ellipsis-v {
            margin-left: 10px;
            color: #6c757d;
            font-size: 12px;
        }

    .income-content-area {
        flex: 1;
        padding: 30px;
        overflow-y: auto;
        background: white;
    }

    .income-product-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e9ecef;
    }

    .income-product-title {
        font-size: 28px;
        font-weight: 600;
        color: #2c3e50;
        display: flex;
        align-items: center;
        gap: 15px;
    }

        .income-product-title i {
            color: #007bff;
            font-size: 18px;
        }

    .income-add-other-income-btn {
        background: #007bff;
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 500;
        font-size: 14px;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .income-add-other-income-btn:hover {
            background: #0056b3;
        }

    .income-product-info {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .income-info-card {
        background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
        color: #2c3e50;
        padding: 25px;
        border-radius: 8px;
        border: 1px solid #e9ecef;
        transition: transform 0.3s ease;
    }

        .income-info-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }

    .income-info-label {
        font-size: 12px;
        color: #6c757d;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 500;
    }

    .income-info-value {
        font-size: 22px;
        font-weight: 600;
        color: #28a745;
    }

    .income-transactions-section {
        margin-top: 20px;
    }

    .income-section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .income-section-title {
        font-size: 16px;
        font-weight: 600;
        color: #2c3e50;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .income-search-transactions {
        position: relative;
        width: 300px;
    }

        .income-search-transactions input {
            width: 100%;
            padding: 8px 15px 8px 35px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 14px;
            background: white;
        }

        .income-search-transactions i {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
            font-size: 14px;
        }

    .income-transactions-table {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #e9ecef;
    }

        .income-transactions-table table {
            width: 100%;
            border-collapse: collapse;
        }

        .income-transactions-table th {
            background: #f8f9fa;
            color: #495057;
            padding: 15px 20px;
            text-align: left;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #e9ecef;
        }

        .income-transactions-table td {
            padding: 15px 20px;
            border-bottom: 1px solid #f1f3f4;
            color: #2c3e50;
            font-size: 14px;
        }

        .income-transactions-table tr:hover {
            background: #f8f9ff;
        }

    .income-sort-icon {
        margin-left: 8px;
        opacity: 0.7;
        font-size: 10px;
        color: #6c757d;
    }

    .income-transactions-table th:hover .income-sort-icon {
        opacity: 1;
        color: #007bff;
    }

    @@media (max-width: 768px) {
        .income-main-content

    {
        flex-direction: column;
    }

    .income-sidebar {
        width: 100%;
        max-height: 300px;
    }

    .income-product-info {
        grid-template-columns: 1fr;
    }

    .income-search-transactions {
        width: 100%;
        margin-top: 10px;
    }

    .income-section-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .income-content-area {
        padding: 20px;
    }

    .income-product-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
    }

    }
</style>

<div class="income-page-title">OTHER INCOMES</div>

<div class="income-container">
    <div class="income-main-content">
        <div class="income-sidebar">
            <div class="income-sidebar-header">
                <div class="income-search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Search items...">
                </div>

                <button class="income-add-item-btn" onclick="window.location.href='/Web/OtherIncome/create';">
                    <i class="fas fa-plus"></i> Add Category
                </button>
            </div>

            <div class="income-item-list">
                <div class="income-item-list-header">
                    <div class="income-item-name">CATEGORY <i class="fas fa-sort"></i></div>
                    <div class="income-item-quantity">AMOUNT</div>
                </div>
                @foreach (var item in Model.ItemView)
                {
                    <div class="income-item-row">
                        <a class="@(item.Id == Model.SelectedItem?.Id ? "active" : "")"
                           asp-action="Index" asp-route-id="@item.Id">
                            <div class="income-item-name">@item.ItemName</div>
                            <div class="income-item-quantity">@item.OpeningQuantity</div>
                            <i class="fas fa-ellipsis-v"></i>
                        </a>
                    </div>
                }
            </div>
        </div>

        <div class="income-content-area">
            <div class="income-product-header">
                <div class="income-product-title">
                    <span>@Model.SelectedItem.ItemName</span>
                    <i class="fas fa-external-link-alt"></i>
                </div>
                <button class="income-add-other-income-btn" onclick="window.location.href='/Web/OtherIncome/create'">
                    <i class="fas fa-plus"></i> Add Other Income
                </button>
            </div>

            <div class="income-product-info">
                <div class="income-info-card">
                    <div class="income-info-label">Sale Price</div>
                    <div class="income-info-value">₹ @Model.SelectedItem.SalePrice</div>
                </div>
            </div>

            <div class="income-transactions-section">
                <div class="income-section-header">
                    <h3 class="income-section-title">TRANSACTIONS</h3>
                    <div class="income-search-transactions">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="Search transactions...">
                    </div>
                </div>

                <div class="income-transactions-table">
                    <table>
                        <thead>
                            <tr>
                                <th>
                                    DATE <i class="fas fa-sort income-sort-icon"></i>
                                </th>
                                <th>
                                    AMOUNT <i class="fas fa-sort income-sort-icon"></i>
                                </th>
                                <th>
                                    ACTION <i class="fas fa-sort income-sort-icon"></i>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>05/09/2025, 04:50 AM</td>
                                <td>₹ 1,221.00</td>
                                <td>⋮</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Add some interactive functionality
    document.addEventListener('DOMContentLoaded', function() {
        // Search functionality
        const searchInputs = document.querySelectorAll('input[type="text"]');
        searchInputs.forEach(input => {
            input.addEventListener('focus', function() {
                this.style.borderColor = '#007bff';
            });
            input.addEventListener('blur', function() {
                this.style.borderColor = '#ddd';
            });
        });

        // Add hover effects to cards
        const infoCards = document.querySelectorAll('.income-info-card');
        infoCards.forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-5px)';
            });
            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
            });
        });

        // Sortable table headers
        const sortHeaders = document.querySelectorAll('.income-transactions-table th');
        sortHeaders.forEach(header => {
            header.addEventListener('click', function() {
                // Reset all sort icons
                sortHeaders.forEach(h => {
                    const icon = h.querySelector('.income-sort-icon');
                    if (icon) {
                        icon.className = 'fas fa-sort income-sort-icon';
                    }
                });

                // Set clicked header to sorted
                const icon = this.querySelector('.income-sort-icon');
                if (icon) {
                    icon.className = 'fas fa-sort-down income-sort-icon';
                }
            });
        });
    });
</script>