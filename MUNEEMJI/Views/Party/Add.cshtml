@model PartyModel

@{
    ViewData["Title"] = "Add Party";
    var shippingDisabled = Model.IsShippingDisabled ? "disabled" : "";
    var field1Disabled = Model.AdditionalField1Enabled ? "" : "disabled";
    var field2Disabled = Model.AdditionalField2Enabled ? "" : "disabled";
    var field3Disabled = Model.AdditionalField3Enabled ? "" : "disabled";
    var field4Disabled = Model.AdditionalField4Enabled ? "" : "disabled";
}

@section Styles {
    <style>
        .field {
            margin-bottom: 15px;
        }

        .toggle-container {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

        .switch {
            position: relative;
            display: inline-block;
            width: 40px;
            height: 20px;
        }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 20px;
        }

            .slider:before {
                position: absolute;
                content: "";
                height: 16px;
                width: 16px;
                left: 2px;
                bottom: 2px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

        input:checked + .slider {
            background-color: #3b82f6;
        }

            input:checked + .slider:before {
                transform: translateX(20px);
            }

        .toggle-label {
            font-size: 14px;
            cursor: pointer;
        }

        .blue-text {
            color: #3b82f6;
            font-weight: bold;
        }

        .hidden {
            display: none;
        }

        .select2-results__option--highlighted {
            background-color: #e7f1ff !important;
            color: #333 !important;
        }

        .add-group-link {
            color: #0d6efd;
            font-weight: 500;
            padding: 8px 16px;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            border-bottom: 1px solid #e9ecef;
        }

                    .add-group-link:hover {
                        background-color: #f0f6ff;
                        text-decoration: none;
                    }

                    #gstinStatus {
                        display: block;
                        font-size: 12px;
                        margin-top: 4px;
                    }
                    #gstinStatus.text-success { color: #28a745 !important; }
                    #gstinStatus.text-danger { color: #dc3545 !important; }
                    #gstinStatus.text-info { color: #17a2b8 !important; }
                </style>
            }

<div class="container-fluid mt-4">
    <h2>Add Party</h2>
    <form asp-action="Add" method="post" onsubmit="return validateAndPrepareForm()" id="partyForm">
        <div class="row mb-3">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="col-md-4 field">
                <label asp-for="PartyName">Party Name *</label>
                <input asp-for="PartyName" class="form-control" required />
                <span asp-validation-for="PartyName" class="text-danger"></span>
            </div>
            <div class="col-md-4 field">
                <label asp-for="GSTIN">GSTIN</label>
                <div class="input-group">
                    <input asp-for="GSTIN" class="form-control" maxlength="15" style="text-transform:uppercase;" />
                    <button type="button" class="btn btn-outline-primary" id="btnGstinLookup" title="Verify GSTIN" onclick="lookupGstin()">
                        <i class="bi bi-search" id="gstinSearchIcon"></i>
                        <span class="spinner-border spinner-border-sm d-none" id="gstinSpinner" role="status"></span>
                    </button>
                </div>
                <span asp-validation-for="GSTIN" class="text-danger"></span>
                <small id="gstinStatus" class="d-none mt-1"></small>
            </div>
            <div class="col-md-4 field">
                <label asp-for="PhoneNumber">Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="col-md-4 field">
                <label asp-for="PartyGroup">Party Group</label>
                <input type="hidden" id="PartyGroupId" name="PartyGroupId" />
                <select id="PartyGroup" asp-for="PartyGroup" class="form-select">
                    <option value="">-- Select Party Group --</option>
                </select>
                <span asp-validation-for="PartyGroup" class="text-danger"></span>
            </div>
        </div>

        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" data-bs-toggle="tab" href="#gstTab">GST & Address</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#creditTab">Credit & Balance</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#additionalTab">Additional Fields</a>
            </li>
        </ul>

        <div class="tab-content mt-3">
            <div class="tab-pane fade show active" id="gstTab">
                <div class="row mb-3">
                    <div class="col-md-4 field">
                        <label asp-for="GSTType">GST Type</label>
                        <select asp-for="GSTType" class="form-select">
                            <option value="Unregistered/Consumer">Unregistered/Consumer</option>
                            <option value="Registered Business">Registered Business</option>
                            <option value="Composition Scheme">Composition Scheme</option>
                        </select>
                        <span asp-validation-for="GSTType" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 field">
                        <label asp-for="State">State</label>
                        <select asp-for="State" class="form-select" asp-items="@(new SelectList(Model.States, "StateId", "Name"))">
                            <option value="">-- Select State --</option>
                        </select>
                        <span asp-validation-for="State" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 field">
                        <label asp-for="Email">Email ID</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6 field">
                        <label asp-for="BillingAddress">Billing Address</label>
                        <textarea asp-for="BillingAddress" class="form-control"></textarea>
                        <span asp-validation-for="BillingAddress" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 field">
                        <label asp-for="ShippingAddress">Shipping Address</label>
                        <textarea asp-for="ShippingAddress" class="form-control"></textarea>
                        <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="creditTab">
                <div class="row mb-3">
                    <div class="col-md-4 field">
                        <label asp-for="OpeningBalance">Opening Balance</label>
                        <input asp-for="OpeningBalance" class="form-control" placeholder="Opening Balance" />
                        <span asp-validation-for="OpeningBalance" class="text-danger" oninput="autoCheck('EnableOpeningBalance')"></span>
                    </div>
                    <div class="mb-3">
                        <input type="radio" id="ToPay" name="BalanceDirection" value="ToPay"
                        @(Model.BalanceDirection == "ToPay" ? "checked" : "") onclick="autoCheck('EnableOpeningBalance')" />
                        <label for="ToPay">To Pay</label>

                        <input type="radio" id="ToReceive" name="BalanceDirection" value="ToReceive"
                        @(Model.BalanceDirection == "ToReceive" ? "checked" : "") onclick="autoCheck('EnableOpeningBalance')" />
                        <label for="ToReceive">To Receive</label>
                    </div>

                    <input type="checkbox" id="EnableOpeningBalance" name="EnableOpeningBalance"
                           style="display: none;" @(Model.EnableOpeningBalance ? "checked" : "") />
                    <div class="col-md-4 field">
                        <label asp-for="AsOfDate">As Of Date</label>
                        <input asp-for="AsOfDate" type="date" class="form-control" />
                        <span asp-validation-for="AsOfDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="credit-limit-label field">
                    <label>Credit Limit <span title="Set a limit to restrict credit">&#9432;</span></label>
                </div>

                <div class="toggle-container field">
                    <span id="noLimitLabel" class="toggle-label">No Limit</span>
                    <label class="switch">
                        <input type="checkbox" asp-for="HasCustomCreditLimit" id="creditToggle">
                        <span class="slider"></span>
                    </label>
                    <span id="customLimitLabel" class="toggle-label">Custom Limit</span>
                </div>

                <div id="creditLimitField" class="field">
                    <label asp-for="CreditLimit" class="hidden" id="creditLimitLabel">Credit Limit</label>
                    <input asp-for="CreditLimit" class="form-control" placeholder="Credit Limit" />
                    <span asp-validation-for="CreditLimit" class="text-danger"></span>
                </div>
            </div>

            <div class="tab-pane fade" id="additionalTab">
                <div class="form-check mb-1">
                    <input class="form-check-input" type="checkbox" id="enableField1"
                           onchange="toggleField('field1', this)"
                    @(Model.AdditionalField1Enabled != null ? "checked" : "") />
                    <label class="form-check-label" for="enableField1">Enable Additional Field 1</label>
                </div>
                <input type="text" class="form-control mb-3" id="field1" name="AdditionalField1"
                       placeholder="Additional Field 1 Name"
                       value="@Model.AdditionalField1Value"
                @(Model.AdditionalField1Value != null ? "" : "disabled") />

                <div class="form-check mb-1">
                    <input class="form-check-input" type="checkbox" id="enableField2"
                           onchange="toggleField('field2', this)"
                    @(Model.AdditionalField2Enabled != null ? "checked" : "") />
                    <label class="form-check-label" for="enableField2">Enable Additional Field 2</label>
                </div>
                <input type="text" class="form-control mb-3" id="field2" name="AdditionalField2"
                       placeholder="Additional Field 2 Name"
                       value="@Model.AdditionalField2Value"
                @(Model.AdditionalField2Value != null ? "" : "disabled") />

                <div class="form-check mb-1">
                    <input class="form-check-input" type="checkbox" id="enableField3"
                           onchange="toggleField('field3', this)"
                    @(Model.AdditionalField3Enabled != null ? "checked" : "") />
                    <label class="form-check-label" for="enableField3">Enable Additional Field 3</label>
                </div>
                <input type="text" class="form-control mb-3" id="field3" name="AdditionalField3"
                       placeholder="Additional Field 3 Name"
                       value="@Model.AdditionalField3Value"
                @(Model.AdditionalField3Value != null ? "" : "disabled") />

                <div class="form-check mb-1">
                    <input class="form-check-input" type="checkbox" id="enableField4"
                           onchange="toggleField('field4', this)"
                    @(Model.AdditionalField4Enabled != null ? "checked" : "") />
                    <label class="form-check-label" for="enableField4">Enable Additional Field 4</label>
                </div>
                <input type="date" class="form-control mb-3" id="field4" name="AdditionalField4"
                       value="@(Model.AdditionalField4Value?.ToString("yyyy-MM-dd"))"
                @(Model.AdditionalField4Value != null ? "" : "disabled") />
            </div>
        </div>

        @if (Model.Id > 0)
        {
            <div class="mt-3 text-end">
                <button type="button" name="deleteBtn" onclick="showDeleteConfirmation(@Model.Id)" class="btn btn-primary">Delete</button>
                <button type="submit" name="save" value="save" class="btn btn-outline-primary">Update</button>
            </div>
        }
        else
        {
            <div class="mt-3 text-end">
                <button type="submit" name="save" value="new" class="btn btn-outline-primary">Save & New</button>
                <button type="submit" name="save" value="save" class="btn btn-primary">Save</button>
            </div>
        }
    </form>
</div>

<!-- Add Party Group Modal -->
<div class="modal fade" id="addGroupModal" tabindex="-1" aria-labelledby="addGroupModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addGroupModalLabel">Add Party Group</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="newGroupName" class="form-label">ENTER PARTY GROUP NAME</label>
                    <input type="text" class="form-control" id="newGroupName" placeholder="Enter group name">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="saveNewGroup()">SAVE</button>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmationModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmationModalTitle">Confirm Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="confirmationModalBody">
                Are you sure you want to proceed?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <button type="button" class="btn btn-primary" id="confirmationModalYes">Yes</button>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Message Modal -->
<div class="modal fade" id="messageModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="messageModalHeader">
                <h5 class="modal-title" id="messageModalTitle">Message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="messageModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" onclick="redirectAfterMessage()">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2-bootstrap-5-theme/1.3.0/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <script>
        let partyGroups = [];
        let savedPartyGroup = '@Model.PartyGroup';
        let savedPartyGroupId = '@Model.PartyGroupId';
        let messageModalAction = null;

        $(document).ready(function () {
            // Initialize Select2
            $('#PartyGroup').select2({
                theme: 'bootstrap-5',
                placeholder: 'Party Group',
                allowClear: true,
                width: '100%'
            });

            // Load groups from database
            loadPartyGroups();

            // Update PartyGroupId when selection changes
            $('#PartyGroup').on('change', function () {
                const selectedGroupName = $(this).val();
                const selectedGroup = partyGroups.find(g => g.groupname === selectedGroupName);
                if (selectedGroup) {
                    $('#PartyGroupId').val(selectedGroup.id);
                    console.log('PartyGroupId set to:', selectedGroup.id);
                } else {
                    $('#PartyGroupId').val('');
                }
            });

            // Add "Add Group" option when dropdown opens
            $('#PartyGroup').on('select2:opening', function () {
                setTimeout(() => {
                    const $addGroupLink = $(`<div class="add-group-link">
                        <span>+</span>
                        <span>Add Group</span>
                    </div>`);

                    const $resultsList = $('.select2-results');
                    const existingLink = $resultsList.find('.add-group-link');
                    if (existingLink.length === 0) {
                        $resultsList.prepend($addGroupLink);
                        $addGroupLink.on('click', function () {
                            $('#addGroupModal').modal('show');
                            $('#PartyGroup').select2('close');
                        });
                    }
                }, 100);
            });
        });

        function validateAndPrepareForm() {
            // Ensure PartyGroupId is set before form submits
            const selectedGroupName = $('#PartyGroup').val();
            if (selectedGroupName) {
                const selectedGroup = partyGroups.find(g => g.groupname === selectedGroupName);
                if (selectedGroup) {
                    $('#PartyGroupId').val(selectedGroup.id);
                }
            }

            // Basic validation
            const partyName = $('#PartyName').val().trim();
            if (!partyName) {
                // alert('Please enter Party Name');
                return false;
            }

            console.log('Form Data:');
            console.log('PartyName:', partyName);
            console.log('PartyGroup:', $('#PartyGroup').val());
            console.log('PartyGroupId:', $('#PartyGroupId').val());

            return true;
        }

        function loadPartyGroups() {
            $.ajax({
                url: '/Web/Party/GetPartyGroups',
                type: 'GET',
                success: function (response) {
                    partyGroups = response;
                    let $select = $('#PartyGroup');
                    $select.find('option:not(:first)').remove();

                    response.forEach(group => {
                        $select.append(new Option(group.groupname, group.groupname));
                    });

                    // If editing (has saved party group), set it as selected
                    if (savedPartyGroup && savedPartyGroup.trim()) {
                        $select.val(savedPartyGroup).trigger('change');
                        if (savedPartyGroupId && savedPartyGroupId.trim()) {
                            $('#PartyGroupId').val(savedPartyGroupId);
                        }
                        console.log('Loaded saved group:', savedPartyGroup);
                    }

                    $select.trigger('change');
                },
                error: function (error) {
                    console.log('Error loading party groups:', error);
                }
            });
        }

        function saveNewGroup() {
            const groupName = $('#newGroupName').val().trim();
            if (!groupName) {
                alert('Please enter a group name');
                return;
            }

            $.ajax({
                url: '/Web/Party/CreatePartyGroup',
                type: 'POST',
                data: { name: groupName },
                success: function (response) {
                    $('#addGroupModal').modal('hide');
                    $('#newGroupName').val('');

                    // Reload groups and select the new one
                    loadPartyGroups();
                    setTimeout(() => {
                        $('#PartyGroup').val(groupName).trigger('change');
                    }, 200);
                },
                error: function (error) {
                    console.log('Error creating group:', error);
                    alert('Error creating group. Please try again.');
                }
            });
        }

        // Credit toggle functionality
        const toggle = document.getElementById('creditToggle');
        const creditLimitField = document.getElementById('creditLimitField');
        const noLimitLabel = document.getElementById('noLimitLabel');
        const customLimitLabel = document.getElementById('customLimitLabel');
        const creditLimitInput = document.querySelector('[asp-for="CreditLimit"]');
        const creditLimitLabel = document.getElementById('creditLimitLabel');

        function updateCreditLimitVisibility(isChecked) {
            if (isChecked) {
                creditLimitField.classList.remove('hidden');
                noLimitLabel.classList.remove('blue-text');
                customLimitLabel.classList.add('blue-text');
                if (creditLimitLabel) creditLimitLabel.classList.remove('hidden');
                if (creditLimitInput) creditLimitInput.disabled = false;
            } else {
                creditLimitField.classList.add('hidden');
                customLimitLabel.classList.remove('blue-text');
                noLimitLabel.classList.add('blue-text');
                if (creditLimitLabel) creditLimitLabel.classList.add('hidden');
                if (creditLimitInput) creditLimitInput.disabled = true;
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (toggle) updateCreditLimitVisibility(toggle.checked);
        });

        if (toggle) {
            toggle.addEventListener('change', function () {
                updateCreditLimitVisibility(this.checked);
            });
        }

        function toggleField(fieldId, checkbox) {
            const field = document.getElementById(fieldId);
            if (field) field.disabled = !checkbox.checked;
        }

        window.onload = function () {
            ['1', '2', '3', '4'].forEach(function (num) {
                const cb = document.getElementById('enableField' + num);
                if (cb) toggleField('field' + num, cb);
            });
        };

        function autoCheck(checkboxId) {
            const checkbox = document.getElementById(checkboxId);
            if (checkbox) checkbox.checked = true;
        }

        function showDeleteConfirmation(id) {
            document.getElementById('confirmationModalTitle').textContent = 'Confirm Delete';
            document.getElementById('confirmationModalBody').textContent = 'Are you sure you want to delete this party? This action cannot be undone.';

            const confirmModal = new bootstrap.Modal(document.getElementById('confirmationModal'));
            confirmModal.show();

            document.getElementById('confirmationModalYes').onclick = function() {
                confirmModal.hide();
                deleteAndNew(id);
            };
        }

        function deleteAndNew(id) {
            fetch(`/Web/Party/DeleteParty?id=${id}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => {
                if (response.ok) {
                    showMessageModal(true, 'Party deleted successfully!', '/Web/Party/index');
                } else {
                    showMessageModal(false, 'Error deleting party');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showMessageModal(false, 'An error occurred while deleting the party');
            });
        }

        function showMessageModal(isSuccess, message, redirectUrl = null) {
            const messageModalHeader = document.getElementById('messageModalHeader');
            const messageModalTitle = document.getElementById('messageModalTitle');
            const messageModalBody = document.getElementById('messageModalBody');

            messageModalTitle.textContent = isSuccess ? 'Success' : 'Error';
            messageModalBody.textContent = message;

            if (isSuccess) {
                messageModalHeader.style.backgroundColor = '#28a745';
                messageModalHeader.style.color = 'white';
            } else {
                messageModalHeader.style.backgroundColor = '#dc3545';
                messageModalHeader.style.color = 'white';
            }

            messageModalAction = redirectUrl;
            const messageModal = new bootstrap.Modal(document.getElementById('messageModal'));
            messageModal.show();
        }

        function redirectAfterMessage() {
            if (messageModalAction) {
                window.location.href = messageModalAction;
            }
        }

                let clickedButton = null;

        // Capture which button was clicked
        document.querySelectorAll('button[type="submit"]').forEach(button => {
            button.addEventListener('click', function(e) {
                clickedButton = this.value; // 'new' or 'save'
                console.log('Button clicked:', clickedButton);
            });
        });

        // ── GSTIN Auto-Lookup ──
        function lookupGstin() {
            const gstinInput = document.getElementById('GSTIN');
            const gstin = gstinInput.value.trim().toUpperCase();
            const statusEl = document.getElementById('gstinStatus');
            const spinner = document.getElementById('gstinSpinner');
            const icon = document.getElementById('gstinSearchIcon');
            const btn = document.getElementById('btnGstinLookup');

            if (!gstin || gstin.length !== 15) {
                statusEl.className = 'text-danger mt-1';
                statusEl.textContent = 'GSTIN must be exactly 15 characters';
                statusEl.classList.remove('d-none');
                return;
            }

            // Show loading
            spinner.classList.remove('d-none');
            icon.classList.add('d-none');
            btn.disabled = true;
            statusEl.className = 'text-info mt-1';
            statusEl.textContent = 'Verifying GSTIN...';
            statusEl.classList.remove('d-none');

            fetch('/Web/Party/LookupGstin?gstin=' + encodeURIComponent(gstin))
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        // Auto-fill fields
                        const stateSelect = document.getElementById('State');
                        if (stateSelect && data.state) {
                            // Try to match state by name in dropdown
                            const opts = stateSelect.options;
                            for (let i = 0; i < opts.length; i++) {
                                if (opts[i].text.toLowerCase().includes(data.state.toLowerCase())) {
                                    stateSelect.selectedIndex = i;
                                    break;
                                }
                            }
                        }

                        const billingAddr = document.getElementById('BillingAddress');
                        const shippingAddr = document.getElementById('ShippingAddress');
                        if (billingAddr && data.address) billingAddr.value = data.address;
                        if (shippingAddr && data.address) shippingAddr.value = data.address;

                        // Auto-fill party name if empty
                        const partyName = document.getElementById('PartyName');
                        if (partyName && !partyName.value.trim()) {
                            partyName.value = data.tradeName || data.legalName || '';
                        }

                        // Show status
                        const src = data.source === 'cache' ? ' (cached)' : ' (verified)';
                        statusEl.className = 'text-success mt-1';
                        statusEl.innerHTML = '<i class="bi bi-patch-check-fill"></i> ' +
                            (data.status || 'Active') + ' — ' + (data.legalName || data.tradeName) + src;
                    } else {
                        statusEl.className = 'text-danger mt-1';
                        statusEl.textContent = data.message || 'GSTIN not found';
                    }
                })
                .catch(err => {
                    statusEl.className = 'text-danger mt-1';
                    statusEl.textContent = 'Error verifying GSTIN. Please try again.';
                })
                .finally(() => {
                    spinner.classList.add('d-none');
                    icon.classList.remove('d-none');
                    btn.disabled = false;
                });
        }

        // Auto-trigger lookup when user finishes typing 15 chars
        document.getElementById('GSTIN').addEventListener('input', function() {
            this.value = this.value.toUpperCase();
            if (this.value.trim().length === 15) {
                lookupGstin();
            } else {
                const s = document.getElementById('gstinStatus');
                s.classList.add('d-none');
            }
        });

