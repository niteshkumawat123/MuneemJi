        }
             debugger;

            const formData = new FormData(this);

                 if (clickedButton) {
            formData.append('save', clickedButton);
            console.log('Save parameter added:', clickedButton);
        }


            const action = this.action;
            const partyId = document.querySelector('input[name="Id"]').value;
            const isUpdate = partyId > 0;

            fetch(action, {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }

                // Expect JSON always
                return response.json();
            })
            .then(data => {
                debugger;
                console.log("Received JSON:", data);

                // ✅ Example: do some work with the data before showing the message
                if (data.success) {
