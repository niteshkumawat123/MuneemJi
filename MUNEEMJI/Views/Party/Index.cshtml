@model PartyViewModel
@{
    ViewData["Title"] = "Parties";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<div class="container-fluid" style="padding: 0; font-size: 13px;">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center py-2 px-3 border-bottom">
        <div class="d-flex align-items-center position-relative">
            <div class="dropdown">
                <h5 class="mb-0 me-2 dropdown-toggle" style="font-size: 16px; font-weight: 600; cursor: pointer;" data-bs-toggle="dropdown" aria-expanded="false">
                    Parties
                </h5>
                <ul class="dropdown-menu" style="font-size: 13px;">
                    <li><a class="dropdown-item active" href="/Web/Party/Index"><i class="bi bi-check me-1"></i>Parties</a></li>
                    <li><a class="dropdown-item" href="/Web/Party/Group">Groups</a></li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-danger btn-sm" style="font-size: 12px; padding: 4px 12px;" onclick="window.location.href='/Web/party/add'">
                <i class="bi bi-plus"></i> Add Party
            </button>
            <button type="button" class="bi bi-gear" onclick="window.location.href='/Web/Settings/Party/Index?returnUrl=' + encodeURIComponent(window.location.href)" style="font-size: 16px; color: #fff; background-color:#007bff;border: 1px solid #89bcf3;border-radius: 15%; padding: 2px 5px;">
            </button>
            <div class="dropdown">
                <button class="btn btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 18px; padding: 2px 6px; border: none; color: #333; line-height: 1;">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" style="font-size: 13px;">
                    <li><a class="dropdown-item" href="/Web/Party/ImportParties"><i class="bi bi-file-earmark-arrow-down me-2"></i>Import from Excel</a></li>
                    <li><a class="dropdown-item" href="#" onclick="openPhoneImportModal(); return false;"><i class="bi bi-phone me-2"></i>Import from Phone</a></li>
                    <li><a class="dropdown-item" href="#"><i class="bi bi-google me-2"></i>Import Via Google Contacts</a></li>
                    @if (Model.ManagePartyStatus)
                    {
                        <li><a class="dropdown-item" href="#" onclick="openManagePartyStatus(); return false;"><i class="bi bi-toggle2-on me-2"></i>Manage Party Status</a></li>
                    }
                    <li><a class="dropdown-item" href="/Web/Report/Index" onclick="sessionStorage.setItem('autoLoadReport','PartyStatement')"><i class="bi bi-file-earmark-text me-2"></i>Party Statement (Report)</a></li>
                    <li><a class="dropdown-item" href="/Web/Report/Index" onclick="sessionStorage.setItem('autoLoadReport','AllParties')"><i class="bi bi-people me-2"></i>All Parties (Report)</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="row g-0">
        <!-- Left Sidebar: Party Search and List -->
        <div class="col-md-3 border-end" style="height: calc(100vh - 100px); display: flex; flex-direction: column;">
            <!-- Search Box -->
            <div class="p-2 border-bottom">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted" style="font-size: 12px;"></i>
                    <input type="text" id="searchInput" class="form-control form-control-sm ps-4" placeholder="Search Party Name" autocomplete="off" style="font-size: 12px;" value="@ViewBag.CurrentSearch" oninput="debounceSearch()" />
                </div>
            </div>

            <!-- Party List Header with Sort & Filter -->
            <div class="d-flex align-items-center px-3 py-2 bg-light border-bottom" style="font-size: 11px;">
                <div class="d-flex align-items-center" style="cursor:pointer; flex:1;" onclick="togglePartySort()">
                    <span style="font-weight:600; color:#333;">Party Name</span>
                    <i class="bi bi-arrow-down-up ms-1" id="partySortIcon" style="font-size:10px; color:#333;"></i>
                </div>
                <div class="position-relative d-inline-block" style="margin:0 8px;">
                    <i class="bi bi-funnel" style="font-size:11px; cursor:pointer; color:#e53e3e;" onclick="toggleFilterDropdown()"></i>
                    <div id="partyFilterDropdown" style="display:none; position:absolute; top:calc(100% + 6px); right:-40px; background:#fff; border-radius:8px; box-shadow:0 4px 16px rgba(0,0,0,0.15); z-index:1000; padding:12px 16px; min-width:160px;">
                        <label style="display:flex; align-items:center; gap:6px; margin-bottom:8px; font-size:12px; color:#333; cursor:pointer;">
                            <input type="checkbox" value="All" onchange="handleFilterCheck(this)" style="accent-color:#e53e3e;"> All
                        </label>
                        <label style="display:flex; align-items:center; gap:6px; margin-bottom:8px; font-size:12px; color:#333; cursor:pointer;">
                            <input type="checkbox" value="Active" onchange="handleFilterCheck(this)" style="accent-color:#e53e3e;"> Active
                        </label>
                        <label style="display:flex; align-items:center; gap:6px; margin-bottom:8px; font-size:12px; color:#333; cursor:pointer;">
                            <input type="checkbox" value="Inactive" onchange="handleFilterCheck(this)" style="accent-color:#e53e3e;"> Inactive
                        </label>
                        <label style="display:flex; align-items:center; gap:6px; margin-bottom:8px; font-size:12px; color:#333; cursor:pointer;">
                            <input type="checkbox" value="ToReceive" onchange="handleFilterCheck(this)" style="accent-color:#e53e3e;"> To Receive
                        </label>
                        <label style="display:flex; align-items:center; gap:6px; margin-bottom:12px; font-size:12px; color:#333; cursor:pointer;">
                            <input type="checkbox" value="ToPay" onchange="handleFilterCheck(this)" style="accent-color:#e53e3e;"> To Pay
                        </label>
                        <div style="display:flex; gap:8px; justify-content:flex-end;">
                            <button onclick="clearPartyFilter()" style="padding:4px 14px; border:1px solid #ddd; border-radius:4px; background:#fff; font-size:11px; cursor:pointer;">Clear</button>
                            <button onclick="applyPartyFilter()" style="padding:4px 14px; border:none; border-radius:4px; background:#e53e3e; color:#fff; font-size:11px; font-weight:600; cursor:pointer;">Apply</button>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center">
                    <span style="font-weight:600; color:#333;">Amount</span>
                </div>
            </div>

            <!-- Party List with scrollbar -->
            <div class="list-group list-group-flush" id="partyList" style="flex: 1; overflow-y: auto; overflow-x: hidden;">
                @foreach (var party in Model.Parties)
                {
                    var amtDisplay = (party?.OpeningBalance ?? 0) > 0
                        ? party?.OpeningBalance?.ToString("N2") ?? "0.00"
                        : "0.00";
                    var isToPay = party?.BalanceDirection == "ToPay";
                    var amtColor = (party?.OpeningBalance ?? 0) > 0 ? (isToPay ? "color:#e53e3e;" : "color:#2e7d32;") : "color:#666;";
                    <a class="list-group-item list-group-item-action border-0 d-flex justify-content-between align-items-center py-2 px-2 party-item @(party.Id == Model.SelectedParty?.Id ? "party-selected" : "")"
                       href="#" data-party-id="@party.Id" data-party-name="@party.PartyName"
                       data-balance-direction="@party.BalanceDirection" data-is-active="@party.IsActive.ToString().ToLower()"
                       onclick="selectParty('@party.Id'); return false;" style="font-size: 12px;">
                        <span class="party-name text-truncate-party" title="@party.PartyName">@party.PartyName</span>
                        <span class="fw-bold text-truncate-amount" title="₹ @amtDisplay" style="font-size: 11px; @amtColor">
                            @amtDisplay
                        </span>
                    </a>
                }
            </div>


        </div>

        <!-- Right Panel: Party Details and Transactions -->
        <div class="col-md-9">
            @if (Model.SelectedParty != null)
            {
                <!-- Party Details Header -->
                <div class="p-3 border-bottom">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h6 class="mb-0 d-flex align-items-center" style="font-size: 14px; font-weight: 600;">
                            @Model.SelectedParty.PartyName
                            <a asp-action="Add" asp-route-id="@Model.SelectedParty.Id" class="btn btn-sm btn-outline-secondary ms-2 p-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </h6>
                    </div>

                    <!-- Party Information Grid -->
                    <div class="row g-2">
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedParty.PhoneNumber))
                        {
                            <div class="col-auto">
                                <small class="text-muted" style="font-size: 11px;">Phone Number</small>
                                <div class="fw-medium detail-hover-value" title="@Model.SelectedParty.PhoneNumber" style="font-size: 12px;">@Model.SelectedParty.PhoneNumber</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedParty.Email))
                        {
                            <div class="col-auto">
                                <small class="text-muted" style="font-size: 11px;">Email</small>
                                <div class="fw-medium detail-hover-value" title="@Model.SelectedParty.Email" style="font-size: 12px; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@Model.SelectedParty.Email</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedParty.GSTIN))
                        {
                            <div class="col-auto">
                                <small class="text-muted" style="font-size: 11px;">GSTIN</small>
                                <div class="fw-medium detail-hover-value" title="@Model.SelectedParty.GSTIN" style="font-size: 12px;">@Model.SelectedParty.GSTIN</div>
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.SelectedParty.BillingAddress))
                    {
                        <div class="mt-1">
                            <small class="text-muted" style="font-size: 11px;">Billing Address</small>
                            <div class="fw-medium detail-hover-value text-truncate-address" title="@Model.SelectedParty.BillingAddress" style="font-size: 12px;">@Model.SelectedParty.BillingAddress</div>
                        </div>
                    }
                </div>

                <!-- Transactions Section -->
                <div class="p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0" style="font-size: 13px; font-weight: 600;">Transactions</h6>
                        <div class="d-flex gap-2">
                            <div class="position-relative">
                                <input type="text" id="transactionSearchInput" class="form-control form-control-sm" placeholder="Search transactions..." style="width: 180px; height: 30px; padding-left: 28px; font-size: 12px;" />
                                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted" style="font-size: 11px;"></i>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary" onclick="window.print()" title="Print">
                                <i class="bi bi-printer"></i>
                            </button>
                            <a href="/Web/PaymentIn/ExcelReport" download>
                                <button type="button" class="btn btn-success btn-sm" title="Download Excel" style="height: 30px;">
                                    <i class="bi bi-file-earmark-excel"></i>
                                </button>
                            </a>
                        </div>
                    </div>

                    <!-- No Results Message -->
                    <div id="noResultsMessage" class="alert alert-info" style="display: none;">
                        <i class="bi bi-info-circle me-2"></i>No transactions found matching your search.
                    </div>

                    <!-- Transactions Table -->
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered" style="font-size: 12px;">
                            <thead style="background-color: #f8f9fa;">
                                <tr>
                                    <th class="border-0" style="font-weight: 500; color: #6c757d; font-size: 11px;">
                                        <div class="d-flex align-items-center">
                                            <span>Type</span>
                                            <i class="bi bi-funnel ms-1 text-muted" style="font-size: 10px;"></i>
                                        </div>
                                    </th>
                                    <th class="border-0" style="font-weight: 500; color: #6c757d; font-size: 11px;">
                                        <div class="d-flex align-items-center">
                                            <span>Number</span>
                                            <i class="bi bi-funnel ms-1 text-muted" style="font-size: 10px;"></i>
                                        </div>
                                    </th>
                                    <th class="border-0" style="font-weight: 500; color: #6c757d; font-size: 11px;">
                                        <div class="d-flex align-items-center">
                                            <span>Date</span>
                                            <i class="bi bi-funnel ms-1 text-muted" style="font-size: 10px;"></i>
                                        </div>
                                    </th>
                                    <th class="border-0" style="font-weight: 500; color: #6c757d; font-size: 11px;">
                                        <div class="d-flex align-items-center">
                                            <span>Total</span>
                                            <i class="bi bi-funnel ms-1 text-muted" style="font-size: 10px;"></i>
                                        </div>
                                    </th>
                                    <th class="border-0" style="font-weight: 500; color: #6c757d; font-size: 11px;">
                                        <div class="d-flex align-items-center">
                                            <span>Balance/ Unused</span>
                                            <i class="bi bi-funnel ms-1 text-muted" style="font-size: 10px;"></i>
                                        </div>
                                    </th>
                                    <th class="border-0" style="font-weight: 500; color: #6c757d; font-size: 11px;">
                                        <div class="d-flex align-items-center">
                                            <span>Due Date</span>
                                            <i class="bi bi-funnel ms-1 text-muted" style="font-size: 10px;"></i>
                                        </div>
                                    </th>
                                    <th class="border-0" style="font-weight: 500; color: #6c757d; font-size: 11px;">
                                        <div class="d-flex align-items-center">
                                            <span>Status</span>
                                            <i class="bi bi-funnel ms-1 text-muted" style="font-size: 10px;"></i>
                                        </div>
                                    </th>
                                    <th class="border-0" style="width: 30px;"></th>
                                </tr>
                            </thead>
                            <tbody id="transactionTableBody">
                                @if (Model.PartyTransection != null && Model.PartyTransection.Count() > 0)
                                {
                                    foreach (var item in Model.PartyTransection)
                                    {
                                        var typeName = Enum.GetName(typeof(TradeDocumentTypes), item.tradedocumenttypesid) ?? "-";
                                        var balanceAmount = item.FinalAmount != 0 ? item.FinalAmount.ToString("N2") : "0.00";
                                        var totalAmount = item.Total != 0 ? item.Total.ToString("N2") : "0.00";
                                        var dueDateStr = item.DueDate != default(DateTime) ? item.DueDate.ToString("dd/MM/yyyy") : "";
                                        var isPaid = item.paidReciveamount >= item.FinalAmount && item.FinalAmount > 0;
                                        var statusText = isPaid ? "Paid" : "Unpaid";
                                        var statusColor = isPaid ? "#2e7d32" : "#e53935";
                                        <tr class="transaction-row">
                                            <td style="color: #3e4245;" data-type="@typeName">@typeName</td>
                                            <td style="color: #3e4245;" data-invoice="@(item?.InvoiceNumber)">@(item?.InvoiceNumber)</td>
                                            <td style="color: #3e4245;" data-date="@(item?.CreatedDate != default(DateTime) ? item.CreatedDate.ToString("dd/MM/yyyy") : "-")">@(item?.CreatedDate != default(DateTime) ? item.CreatedDate.ToString("dd/MM/yyyy") : "-")</td>
                                            <td style="color: #3e4245;" data-total="@totalAmount">₹ @totalAmount</td>
                                            <td style="color: #3e4245;" data-balance="@balanceAmount">₹ @balanceAmount</td>
                                            <td style="color: #3e4245;">@dueDateStr</td>
                                            <td style="color: @statusColor; font-weight: 500;">@statusText</td>
                                            <td class="text-center">
                                                <i class="bi bi-three-dots-vertical text-muted" style="cursor: pointer; font-size: 14px;"></i>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    @if (Model.SelectedParty != null && Model.SelectedParty.OpeningBalance != null && Model.SelectedParty.OpeningBalance != 0)
                                    {
                                        var obAmount = Model.SelectedParty.OpeningBalance?.ToString("N2") ?? "0.00";
                                        <tr class="transaction-row">
                                            <td style="color: #3e4245;">Receivable Opening B.</td>
                                            <td style="color: #3e4245;"></td>
                                            <td style="color: #3e4245;">@(Model.SelectedParty.AsOfDate != null ? Model.SelectedParty.AsOfDate.Value.ToString("dd/MM/yyyy") : DateTime.Today.ToString("dd/MM/yyyy"))</td>
                                            <td style="color: #3e4245;">₹ @obAmount</td>
                                            <td style="color: #3e4245;">₹ @obAmount</td>
                                            <td style="color: #3e4245;"></td>
                                            <td style="color: #e53935; font-weight: 500;">Unpaid</td>
                                            <td class="text-center">
                                                <i class="bi bi-three-dots-vertical text-muted" style="cursor: pointer; font-size: 14px;"></i>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <!-- No Party Selected State -->
                <div class="d-flex align-items-center justify-content-center h-100">
                    <div class="text-center text-muted">
                        <i class="bi bi-person-plus" style="font-size: 3rem;"></i>
                        <div class="mt-2">Select a party to view details</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .list-group-item.active {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
    }

    .party-selected {
        background-color: #e3f0ff !important;
        border-left: 3px solid #4da3ff !important;
    }

    .table th {
        font-weight: 500;
        font-size: 0.75rem;
        color: #6c757d;
    }

    .bg-light {
        background-color: #f8f9fa !important;
    }

    .party-item {
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .party-item:not(.party-selected):hover {
            background-color: #f0f0f0;
        }

        .party-item:not(.party-selected):nth-child(even) {
            background-color: #f9f9f9;
        }

        .party-item:not(.party-selected):nth-child(odd) {
            background-color: #ffffff;
        }

    /* Truncate long party names */
    .text-truncate-party {
        display: inline-block;
        max-width: 60%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: middle;
    }

    /* Truncate long amounts */
    .text-truncate-amount {
        display: inline-block;
        max-width: 38%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-align: right;
        vertical-align: middle;
    }

    /* Truncate billing address */
    .text-truncate-address {
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Hover tooltip for detail values */
    .detail-hover-value {
        position: relative;
        cursor: default;
    }

    .detail-hover-value:hover::after {
        content: attr(title);
        position: absolute;
        left: 0;
        top: 100%;
        z-index: 1050;
        background: #3b5998;
        color: #fff;
        padding: 6px 10px;
        border-radius: 4px;
        font-size: 12px;
        white-space: normal;
        word-break: break-all;
        max-width: 400px;
        min-width: 120px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.18);
        pointer-events: none;
    }

    /* Hover tooltip for party list items */
    .text-truncate-party:hover::after,
    .text-truncate-amount:hover::after {
        content: attr(title);
        position: absolute;
        left: 0;
        top: 100%;
        z-index: 1050;
        background: #3b5998;
        color: #fff;
        padding: 5px 8px;
        border-radius: 4px;
        font-size: 11px;
        white-space: nowrap;
        box-shadow: 0 2px 8px rgba(0,0,0,0.18);
        pointer-events: none;
    }

    .text-truncate-party,
    .text-truncate-amount {
        position: relative;
    }

    #partyList {
        scrollbar-width: thin;
        scrollbar-color: #ccc #f5f5f5;
    }

        #partyList::-webkit-scrollbar {
            width: 8px;
        }

        #partyList::-webkit-scrollbar-track {
            background: #f5f5f5;
        }

        #partyList::-webkit-scrollbar-thumb {
            background: #ccc;
            border-radius: 4px;
        }

            #partyList::-webkit-scrollbar-thumb:hover {
                background: #999;
            }

    .transaction-row {
        transition: background-color 0.2s;
    }

        .transaction-row.highlight {
            background-color: #fff3cd !important;
        }
</style>

<script>
    let allParties = [];
    let currentScroll = 0;

    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const partyList = document.getElementById('partyList');
        const transactionSearchInput = document.getElementById('transactionSearchInput');


        allParties = Array.from(document.querySelectorAll('.party-item')).map(item => ({
            id: item.getAttribute('data-party-id'),
            name: item.getAttribute('data-party-name'),
            element: item
        }));

        if (transactionSearchInput) {
            transactionSearchInput.addEventListener('input', function() {
                const searchValue = this.value.toLowerCase().trim();
                const rows = document.querySelectorAll('.transaction-row');
                const noResultsMessage = document.getElementById('noResultsMessage');
                let visibleCount = 0;

                rows.forEach(row => {
                    
                    const type = (row.querySelector('[data-type]')?.getAttribute('data-type') || '').toLowerCase();
                    const invoice = (row.querySelector('[data-invoice]')?.getAttribute('data-invoice') || '').toLowerCase();
                    const date = (row.querySelector('[data-date]')?.getAttribute('data-date') || '').toLowerCase();
                    const total = (row.querySelector('[data-total]')?.getAttribute('data-total') || '').toLowerCase();
                    const balance = (row.querySelector('[data-balance]')?.getAttribute('data-balance') || '').toLowerCase();

                   
                    const rowText = `${type} ${invoice} ${date} ${total} ${balance}`;

                    
                    if (searchValue === '' || rowText.includes(searchValue)) {
                        row.style.display = '';
                        visibleCount++;

                        // Add highlight effect if searching
                        if (searchValue !== '') {
                            row.classList.add('highlight');
                        } else {
                            row.classList.remove('highlight');
                        }
                    } else {
                        row.style.display = 'none';
                        row.classList.remove('highlight');
                    }
                });

                
                if (visibleCount === 0 && searchValue !== '') {
                    noResultsMessage.style.display = 'block';
                } else {
                    noResultsMessage.style.display = 'none';
                }
            });
        }


        });

    function selectPartyFromSearch(partyId) {
        selectParty(partyId);
    }

    function selectParty(partyId) {
        window.location.href = '/Web/Party/Index?id=' + partyId;
    }

    // Double-click on party item navigates to edit page
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.party-item').forEach(function(item) {
            item.addEventListener('dblclick', function(e) {
                e.preventDefault();
                var partyId = this.getAttribute('data-party-id');
                if (partyId) {
                    window.location.href = '/Web/Party/Add?id=' + partyId;
                }
            });
        });
        // Close filter dropdown on outside click
        document.addEventListener('click', function(e) {
            var dd = document.getElementById('partyFilterDropdown');
            if (dd && dd.style.display !== 'none' && !dd.contains(e.target) && !e.target.classList.contains('bi-funnel')) {
                dd.style.display = 'none';
            }
        });
    });

    // Debounced backend search
    var _searchTimer = null;
    function debounceSearch() {
        clearTimeout(_searchTimer);
        _searchTimer = setTimeout(function() {
            navigateWithParams();
        }, 400);
    }

    function navigateWithParams(filterVal) {
        var search = document.getElementById('searchInput').value.trim();
        var filter = filterVal !== undefined ? filterVal : '@ViewBag.CurrentFilter';
        var url = '/Web/Party/Index?';
        var params = [];
        if (search) params.push('search=' + encodeURIComponent(search));
        if (filter && filter !== 'All') params.push('filter=' + encodeURIComponent(filter));
        window.location.href = url + params.join('&');
    }

    // Sort toggle (client-side, no reload needed)
    var partySortAsc = true;
    function togglePartySort() {
        partySortAsc = !partySortAsc;
        var list = document.getElementById('partyList');
        var items = Array.from(list.querySelectorAll('.party-item'));
        items.sort(function(a, b) {
            var na = (a.getAttribute('data-party-name') || '').toLowerCase();
            var nb = (b.getAttribute('data-party-name') || '').toLowerCase();
            return partySortAsc ? na.localeCompare(nb) : nb.localeCompare(na);
        });
        items.forEach(function(item) { list.appendChild(item); });
        document.getElementById('partySortIcon').className = partySortAsc ? 'bi bi-arrow-down-up ms-1' : 'bi bi-arrow-up-down ms-1';
    }

    // Filter dropdown
    function toggleFilterDropdown() {
        var dd = document.getElementById('partyFilterDropdown');
        dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
    }

    function handleFilterCheck(el) {
        // Radio-style: only one filter at a time
        var checks = el.closest('#partyFilterDropdown').querySelectorAll('input[type=checkbox]');
        checks.forEach(function(c) { if (c !== el) c.checked = false; });
    }

    function clearPartyFilter() {
        document.querySelectorAll('#partyFilterDropdown input[type=checkbox]').forEach(function(c) { c.checked = false; });
        document.getElementById('partyFilterDropdown').style.display = 'none';
        navigateWithParams('');
    }

    function applyPartyFilter() {
        var selected = '';
        document.querySelectorAll('#partyFilterDropdown input[type=checkbox]:checked').forEach(function(c) { selected = c.value; });
        document.getElementById('partyFilterDropdown').style.display = 'none';
        navigateWithParams(selected || '');
    }

    // Pre-select current filter checkbox on load
    document.addEventListener('DOMContentLoaded', function() {
        var currentFilter = '@ViewBag.CurrentFilter';
        if (currentFilter) {
            var cb = document.querySelector('#partyFilterDropdown input[value="' + currentFilter + '"]');
            if (cb) cb.checked = true;
        }
    });

        // ---- Phone Import ----
        var phoneImportPollTimer = null;

    function openManagePartyStatus() {
        document.getElementById('partyStatusModal').style.display = 'flex';
        loadPartyStatuses();
    }

    function closePartyStatusModal() {
        document.getElementById('partyStatusModal').style.display = 'none';
    }

    function loadPartyStatuses() {
        fetch('/Web/Party/GetPartiesWithStatus')
            .then(r => r.json())
            .then(data => {
                window._partyStatuses = data;
                window._partyStatusesOriginal = data.map(p => ({ id: p.id, isActive: p.isActive }));
                renderPartyStatusList(data);
            });
    }

    function renderPartyStatusList(parties) {
        const search = document.getElementById('partyStatusSearch').value.toLowerCase();
        const filtered = parties.filter(p => p.partyName.toLowerCase().includes(search));
        const tbody = document.getElementById('partyStatusBody');
        tbody.innerHTML = filtered.map(p => `
            <tr style="border-bottom:1px solid #f0f0f0;">
                <td style="padding:12px 16px; font-size:13px; font-weight:500; color:#333;">${p.partyName}</td>
                <td style="padding:12px 16px; font-size:13px; color:#666;">${p.phoneNumber}</td>
                <td style="padding:12px 16px; text-align:center;">
                    <label class="party-status-toggle">
                        <input type="checkbox" ${p.isActive ? 'checked' : ''} data-party-id="${p.id}" onchange="togglePartyActive(this)">
                        <span class="party-status-slider"></span>
                    </label>
                </td>
            </tr>
        `).join('');
    }

    function togglePartyActive(el) {
        const id = parseInt(el.dataset.partyId);
        const party = window._partyStatuses.find(p => p.id === id);
        if (party) party.isActive = el.checked;
    }

    function savePartyStatuses() {
        // Only send changed statuses
        const updates = window._partyStatuses
            .filter(p => {
                const orig = window._partyStatusesOriginal.find(o => o.id === p.id);
                return orig && orig.isActive !== p.isActive;
            })
            .map(p => ({ partyId: p.id, isActive: p.isActive }));

        if (updates.length === 0) {
            closePartyStatusModal();
            toastr.info('No changes to save.');
            return;
        }

        // Show loader
        document.getElementById('partyStatusLoader').style.display = 'flex';
        document.getElementById('partyStatusSaveBtn').disabled = true;

        fetch('/Web/Party/SavePartyStatuses', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(updates)
        }).then(r => r.json()).then(res => {
            document.getElementById('partyStatusLoader').style.display = 'none';
            document.getElementById('partyStatusSaveBtn').disabled = false;
            if (res.success) {
                closePartyStatusModal();
                toastr.success(res.message);
            } else {
                toastr.error(res.message);
            }
        });
    }

    function openPhoneImportModal() {
        document.getElementById('phoneImportStep1').style.display = 'flex';
        document.getElementById('phoneImportStep2').style.display = 'none';
        document.getElementById('phoneImportResult').style.display = 'none';
        document.getElementById('phoneImportModal').style.display = 'flex';
    }

    function closePhoneImportModal() {
        document.getElementById('phoneImportModal').style.display = 'none';
        if (phoneImportPollTimer) { clearInterval(phoneImportPollTimer); phoneImportPollTimer = null; }
    }

    function proceedToQR() {
        document.getElementById('phoneImportStep1').style.display = 'none';
        document.getElementById('phoneImportStep2').style.display = 'flex';
        document.getElementById('qrLoading').style.display = 'block';
        document.getElementById('qrContainer').innerHTML = '';
        document.getElementById('phoneImportResult').style.display = 'none';

        $.post('/Web/Party/GeneratePhoneImportToken', function(res) {
            document.getElementById('qrLoading').style.display = 'none';
            if (res.success) {
                new QRCode(document.getElementById('qrContainer'), {
                    text: res.mobileUrl,
                    width: 250,
                    height: 250,
                    colorDark: '#000000',
                    colorLight: '#ffffff',
                    correctLevel: QRCode.CorrectLevel.M
                });
                // Start polling
                phoneImportPollTimer = setInterval(function() {
                    $.get('/Web/Party/CheckPhoneImportStatus?token=' + res.token, function(status) {
                        if (status.status === 'completed') {
                            clearInterval(phoneImportPollTimer);
                            phoneImportPollTimer = null;
                            document.getElementById('phoneImportStep2').style.display = 'none';
                            document.getElementById('phoneImportResult').style.display = 'flex';
                            document.getElementById('phoneImportResultText').textContent =
                                status.contactCount + ' contact(s) imported as parties successfully!';
                        }
                    });
                }, 3000);
            } else {
                document.getElementById('qrContainer').textContent = 'Failed to generate QR. Try again.';
            }
        });
    }
</script>

<!-- QRCode.js CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<!-- Phone Import Modal -->
<div id="phoneImportModal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.45); z-index:9999; align-items:center; justify-content:center;">
