                    <circle cx="100" cy="162" r="5" fill="#90caf9"/>
                    <!-- Hand -->
                    <ellipse cx="55" cy="120" rx="22" ry="35" fill="#ffccbc" transform="rotate(-10 55 120)"/>
                    <ellipse cx="48" cy="95" rx="8" ry="20" fill="#ffccbc" transform="rotate(5 48 95)"/>
                    <ellipse cx="145" cy="120" rx="22" ry="35" fill="#ffccbc" transform="rotate(10 145 120)"/>
                    <!-- Contact avatars -->
                    <circle cx="40" cy="50" r="18" fill="#ef5350"/><text x="40" y="55" text-anchor="middle" fill="#fff" font-size="14" font-weight="bold">&#x1F469;</text>
                    <circle cx="160" cy="45" r="18" fill="#42a5f5"/><text x="160" y="50" text-anchor="middle" fill="#fff" font-size="14" font-weight="bold">&#x1F468;</text>
                    <circle cx="165" cy="100" r="16" fill="#ffa726"/><text x="165" y="105" text-anchor="middle" fill="#fff" font-size="12" font-weight="bold">&#x1F469;</text>
                    <circle cx="160" cy="155" r="16" fill="#e53935"/><text x="160" y="160" text-anchor="middle" fill="#fff" font-size="12" font-weight="bold">&#x1F474;</text>
