@model PartyViewModel
@{
    ViewData["Title"] = "Parties";
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
        <div class="d-flex align-items-center">
            <h4 class="mb-0 me-2">Parties</h4>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-danger btn-sm" onclick="window.location.href='/Web/party/add'">
                <i class="bi bi-plus"></i> Add Party
            </button>
            <button type="button" class="bi bi-gear" onclick="window.location.href='/Web/Settings/Party/Index?returnUrl=' + encodeURIComponent(window.location.href)" style="font-size: 20px; color: #fff; background-color:#007bff;border: 2px solid #89bcf3;border-radius: 15%; padding-bottom:2px;padding-top:0px;padding-left:6px; padding-right:6px;">
            </button>
        </div>
    </div>

    <div class="row g-0">
        <!-- Left Sidebar: Party Search and List -->
        <div class="col-md-4 border-end" style="height: calc(100vh - 120px); display: flex; flex-direction: column;">
            <!-- Search Box with Dropdown -->
            <div class="p-3 border-bottom">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted"></i>
                    <input type="text" id="searchInput" class="form-control ps-4" placeholder="Search Party Name" autocomplete="off" />
                    <div id="searchDropdown" class="position-absolute w-100 bg-white border rounded mt-1" style="display: none; max-height: 300px; overflow-y: auto; z-index: 1000; left: 0; top: 100%; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                    </div>
                </div>
            </div>

            <!-- Party List Header -->
            <div class="d-flex justify-content-between align-items-center p-3 bg-light small text-muted border-bottom">
                <div class="d-flex align-items-center">
                    <span>Party Name</span>
                    <i class="bi bi-funnel ms-1"></i>
                </div>
                <div class="d-flex align-items-center">
                    <span>Amount</span>
                    <i class="bi bi-funnel ms-1"></i>
                </div>
            </div>

            <!-- Party List with scrollbar -->
            <div class="list-group list-group-flush" id="partyList" style="flex: 1; overflow-y: scroll; overflow-x: hidden;">
                @foreach (var party in Model.Parties)
                {
                    <a class="list-group-item list-group-item-action border-0 d-flex justify-content-between align-items-center py-3 party-item @(party.Id == Model.SelectedParty?.Id ? "bg-primary text-white" : "")"
                       href="#" data-party-id="@party.Id" data-party-name="@party.PartyName" onclick="selectParty('@party.Id'); return false;">
                        <span class="party-name">@party.PartyName</span>
                        <span class="fw-bold">
                            ₹ @((party?.OpeningBalance ?? 0) > 0
                              ? party?.OpeningBalance?.ToString("0.00") ?? "0.00"
                              : "0.00")
                        </span>
                    </a>
                }
            </div>

            <!-- Slider Control -->
            <div class="p-3 border-top bg-light d-flex align-items-center justify-content-between">
                <button class="btn btn-sm btn-outline-secondary" onclick="scrollUp()" title="Scroll Up">
                    <i class="bi bi-chevron-up"></i>
                </button>
                <span id="scrollIndicator" class="small text-muted">1/10</span>
                <button class="btn btn-sm btn-outline-secondary" onclick="scrollDown()" title="Scroll Down">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>
        </div>

        <!-- Right Panel: Party Details and Transactions -->
        <div class="col-md-8">
            @if (Model.SelectedParty != null)
            {
                <!-- Party Details Header -->
                <div class="p-4 border-bottom">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="mb-0 d-flex align-items-center">
                            @Model.SelectedParty.PartyName
                            <a asp-action="Add" asp-route-id="@Model.SelectedParty.Id" class="btn btn-sm btn-outline-secondary ms-2 p-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </h5>
                    </div>

                    <!-- Party Information Grid -->
                    <div class="row g-3">
                        <div class="col-md-3">
                            <small class="text-muted">Phone Number</small>
                            <div class="fw-medium">@(Model.SelectedParty.PhoneNumber ?? "N/A")</div>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Email</small>
                            <div class="fw-medium" style="word-wrap: break-word; overflow-wrap: break-word; white-space: normal;">@(Model.SelectedParty.Email ?? "N/A")</div>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">GSTIN</small>
                            <div class="fw-medium">@(Model.SelectedParty.GSTIN ?? "N/A")</div>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Billing Address</small>
                            <div class="fw-medium">@(Model.SelectedParty.BillingAddress ?? "N/A")</div>
                        </div>
                    </div>
                </div>

                <!-- Transactions Section -->
                <div class="p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="mb-0">Transactions</h6>
                        <div class="d-flex gap-2">
                            <div class="position-relative">
                                <input type="text" id="transactionSearchInput" class="form-control form-control-sm" placeholder="Search transactions..." style="width: 200px; height: 39px; padding-left: 30px;" />
                                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted"></i>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary" onclick="window.print()">
                                <i class="bi bi-printer"></i>
                            </button>
                            <a href="/Web/PaymentIn/ExcelReport" download>
                                <button type="button" class="btn btn-success btn-sm" title="Download Excel" style="height: 38px;">
                                    <i class="bi bi-file-earmark-excel"></i>
                                </button>
                            </a>
                        </div>
                    </div>

                    <!-- No Results Message -->
                    <div id="noResultsMessage" class="alert alert-info" style="display: none;">
                        <i class="bi bi-info-circle me-2"></i>No transactions found matching your search.
                    </div>

                    <!-- Transactions Table -->
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0">
                                        <div class="d-flex align-items-center">
                                            <span>Type</span>
                                            <i class="bi bi-funnel ms-1 text-muted"></i>
                                        </div>
                                    </th>
                                    <th class="border-0">
                                        <div class="d-flex align-items-center">
                                            <span>Number</span>
                                            <i class="bi bi-funnel ms-1 text-muted"></i>
                                        </div>
                                    </th>
                                    <th class="border-0">
                                        <div class="d-flex align-items-center">
                                            <span>Date</span>
                                            <i class="bi bi-funnel ms-1 text-muted"></i>
                                        </div>
                                    </th>
                                    <th class="border-0">
                                        <div class="d-flex align-items-center">
                                            <span>Total</span>
                                            <i class="bi bi-funnel ms-1 text-muted"></i>
                                        </div>
                                    </th>
                                    <th class="border-0">
                                        <div class="d-flex align-items-center">
                                            <span>Balance</span>
                                            <i class="bi bi-funnel ms-1 text-muted"></i>
                                        </div>
                                    </th>
                                    <th class="border-0"></th>
                                </tr>
                            </thead>
                            <tbody id="transactionTableBody">
                                @if (Model.PartyTransection != null && Model.PartyTransection.Count() > 0)
                                {
                                    foreach (var item in Model.PartyTransection)
                                    {
                                        <tr class="transaction-row">
                                            <td style="color: #3e4245;" data-type="@Enum.GetName(typeof(TradeDocumentTypes), item.tradedocumenttypesid)">
                                                @Enum.GetName(typeof(TradeDocumentTypes), item.tradedocumenttypesid)
                                            </td>
                                            <td style="color: #3e4245;" data-invoice="@(item?.InvoiceNumber)">@(item?.InvoiceNumber)</td>
                                            <td style="color: #3e4245;" data-date="@(item?.CreatedDate != null ? item.CreatedDate.ToString("dd-MM-yyyy") : "-")">@(item?.CreatedDate != null ? item.CreatedDate.ToString("dd-MM-yyyy") : "-")</td>
                                            <td style="color: #3e4245;" data-total="@(item?.Total != null ? item.Total.ToString("0.00") : "0.00")"> @(item?.Total != null ? item.Total.ToString("0.00") : "0.00")</td>
                                            <td style="color: #3e4245;" data-balance="@(item?.FinalAmount != null ? item.FinalAmount.ToString("0.00") : "0.00")"> @(item?.FinalAmount != null ? item.FinalAmount.ToString("0.00") : "0.00")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    @if (Model.SelectedParty.Balance != 0)
                                    {
                                        <tr class="bg-light transaction-row">
                                            <td>-</td>
                                            <td></td>
                                            <td>-</td>
                                            <td>-</td>
                                            <td>-</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <!-- No Party Selected State -->
                <div class="d-flex align-items-center justify-content-center h-100">
                    <div class="text-center text-muted">
                        <i class="bi bi-person-plus" style="font-size: 3rem;"></i>
                        <div class="mt-2">Select a party to view details</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .list-group-item.active {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
    }

    .table th {
        font-weight: 500;
        font-size: 0.875rem;
        color: #6c757d;
    }

    .bg-light {
        background-color: #f8f9fa !important;
    }

    .party-item {
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .party-item:not(.bg-primary):hover {
            background-color: #f0f0f0;
        }

    #partyList {
        scrollbar-width: thin;
        scrollbar-color: #ccc #f5f5f5;
    }

        #partyList::-webkit-scrollbar {
            width: 8px;
        }

        #partyList::-webkit-scrollbar-track {
            background: #f5f5f5;
        }

        #partyList::-webkit-scrollbar-thumb {
            background: #ccc;
            border-radius: 4px;
        }

            #partyList::-webkit-scrollbar-thumb:hover {
                background: #999;
            }

    .transaction-row {
        transition: background-color 0.2s;
    }

        .transaction-row.highlight {
            background-color: #fff3cd !important;
        }
</style>

<script>
    let allParties = [];
    let currentScroll = 0;

    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const searchDropdown = document.getElementById('searchDropdown');
        const partyList = document.getElementById('partyList');
        const transactionSearchInput = document.getElementById('transactionSearchInput');

        
        allParties = Array.from(document.querySelectorAll('.party-item')).map(item => ({
            id: item.getAttribute('data-party-id'),
            name: item.getAttribute('data-party-name'),
            element: item
        }));

       
        searchInput.addEventListener('input', function() {
            const searchValue = this.value.toLowerCase().trim();

            if (searchValue === '') {
                searchDropdown.style.display = 'none';
                return;
            }

            const filtered = allParties.filter(party =>
                party.name.toLowerCase().includes(searchValue)
            );

            if (filtered.length > 0) {
                searchDropdown.innerHTML = filtered.map(party =>
                    `<div class="p-2 border-bottom" style="cursor: pointer;" onclick="selectPartyFromSearch('${party.id}')">
                        <small>${party.name}</small>
                    </div>`
                ).join('');
                searchDropdown.style.display = 'block';
            } else {
                searchDropdown.innerHTML = '<div class="p-2 text-muted"><small>No parties found</small></div>';
                searchDropdown.style.display = 'block';
            }
        });

        // Transaction search functionality
        if (transactionSearchInput) {
            transactionSearchInput.addEventListener('input', function() {
                const searchValue = this.value.toLowerCase().trim();
                const rows = document.querySelectorAll('.transaction-row');
                const noResultsMessage = document.getElementById('noResultsMessage');
                let visibleCount = 0;

                rows.forEach(row => {
                    
                    const type = (row.querySelector('[data-type]')?.getAttribute('data-type') || '').toLowerCase();
                    const invoice = (row.querySelector('[data-invoice]')?.getAttribute('data-invoice') || '').toLowerCase();
                    const date = (row.querySelector('[data-date]')?.getAttribute('data-date') || '').toLowerCase();
                    const total = (row.querySelector('[data-total]')?.getAttribute('data-total') || '').toLowerCase();
                    const balance = (row.querySelector('[data-balance]')?.getAttribute('data-balance') || '').toLowerCase();

                   
                    const rowText = `${type} ${invoice} ${date} ${total} ${balance}`;

                    
                    if (searchValue === '' || rowText.includes(searchValue)) {
                        row.style.display = '';
                        visibleCount++;

                        // Add highlight effect if searching
                        if (searchValue !== '') {
                            row.classList.add('highlight');
                        } else {
                            row.classList.remove('highlight');
                        }
                    } else {
                        row.style.display = 'none';
                        row.classList.remove('highlight');
                    }
                });

                // Show/hide no results message
                if (visibleCount === 0 && searchValue !== '') {
                    noResultsMessage.style.display = 'block';
                } else {
                    noResultsMessage.style.display = 'none';
                }
            });
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.position-relative')) {
                searchDropdown.style.display = 'none';
            }
        });

        updateScrollIndicator();
    });

    function selectPartyFromSearch(partyId) {
        selectParty(partyId);
    }

    function selectParty(partyId) {
        window.location.href = '/Web/Party/Index?id=' + partyId;
    }

    function scrollUp() {
        const partyList = document.getElementById('partyList');
        partyList.scrollBy({
            top: -150,
            behavior: 'smooth'
        });
        setTimeout(updateScrollIndicator, 300);
    }

    function scrollDown() {
        const partyList = document.getElementById('partyList');
        partyList.scrollBy({
            top: 150,
            behavior: 'smooth'
        });
        setTimeout(updateScrollIndicator, 300);
    }

    function updateScrollIndicator() {
        const partyList = document.getElementById('partyList');
        const items = partyList.querySelectorAll('.party-item');
        const itemHeight = 48;
        const scrollTop = partyList.scrollTop;
        const visibleIndex = Math.floor(scrollTop / itemHeight) + 1;

        document.getElementById('scrollIndicator').textContent = visibleIndex + '/' + items.length;
    }
</script>