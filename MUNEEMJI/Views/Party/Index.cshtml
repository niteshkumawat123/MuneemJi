            </div>
            <h5 style="font-weight:700; color:#222; margin-bottom:6px;">Select Contacts On Your Phone</h5>
            <p style="color:#888; font-size:13px; text-align:center; margin-bottom:20px;">Select all contacts on your phone you want to share</p>
            <button onclick="proceedToQR()" style="background:#1a73e8; color:#fff; border:none; border-radius:20px; padding:10px 32px; font-size:14px; font-weight:600; cursor:pointer;">Continue</button>
        </div>

        <!-- Step 2: QR Code -->
        <div id="phoneImportStep2" style="display:none; flex-direction:column; align-items:center; padding:40px 30px 30px;">
            <div id="qrContainer" style="margin-bottom:20px;"></div>
            <div id="qrLoading" style="display:none; color:#1a73e8; font-size:14px;">Generating QR code...</div>
            <h5 style="font-weight:700; color:#1a73e8; margin-bottom:6px;">Scan This QR On Your Phone</h5>
            <p style="color:#888; font-size:13px; text-align:center;">Or Open the link we've sent on your WhatsApp/SMS</p>
            <p style="color:#aaa; font-size:11px; margin-top:12px;">Waiting for contacts...</p>
        </div>

        <!-- Step 3: Result -->
        <div id="phoneImportResult" style="display:none; flex-direction:column; align-items:center; padding:40px 30px 30px;">
            <i class="bi bi-check-circle-fill" style="font-size:48px; color:#4caf50; margin-bottom:16px;"></i>
            <h5 style="font-weight:700; color:#222; margin-bottom:6px;">Import Complete</h5>
            <p id="phoneImportResultText" style="color:#555; font-size:14px; text-align:center;"></p>
            <button onclick="closePhoneImportModal(); window.location.reload();" style="background:#4caf50; color:#fff; border:none; border-radius:20px; padding:10px 32px; font-size:14px; font-weight:600; cursor:pointer; margin-top:16px;">Done</button>
        </div>
    </div>
</div>

<!-- Manage Party Status Modal -->
<style>
