@model PaymentInOutModel

<style>
    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 20px;
        border-bottom: 1px solid #e0e0e0;
        background-color: #ffffff;
    }

    .modal-title {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: #333;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
        color: #666;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        padding: 0;
    }

        .modal-close:hover {
            background-color: #f0f0f0;
            color: #333;
        }

    .modal-body {
        padding: 20px;
        background-color: #ffffff;
        min-height: 400px;
    }

    .form-row {
        display: flex;
        gap: 15px;
        margin-bottom: 15px;
        align-items: flex-start;
    }

        .form-row.main-row {
            margin-bottom: 25px;
        }

    .form-group {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

        .form-group.search-field {
            flex: 2;
        }

        .form-group.full-width {
            flex: 1 1 100%;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 500;
            color: #555;
            font-size: 14px;
        }

            .form-group label.required::after {
                content: ' *';
                color: #dc3545;
            }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

        .form-control:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
        }

        .form-control select {
            cursor: pointer;
        }

    .btn-link {
        color: #007bff;
        text-decoration: none;
        font-size: 14px;
        border: none;
        background: none;
        padding: 8px 0;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-weight: 500;
    }

        .btn-link:hover {
            text-decoration: underline;
            color: #0056b3;
        }

    .description-container {
        margin-top: 15px;
        padding: 15px;
        background-color: #fafafa;
        border-radius: 6px;
        border: 1px solid #e0e0e0;
    }

        .description-container.hidden {
            display: none;
        }

    .description-textarea {
        width: 100%;
        min-height: 100px;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        resize: vertical;
        font-family: inherit;
        box-sizing: border-box;
    }

    .image-upload {
        margin-top: 12px;
        color: #666;
        font-size: 20px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 15px;
        border: 2px dashed #ddd;
        border-radius: 6px;
        background-color: #fafafa;
        transition: all 0.2s ease;
        width: 50px;
        height: 50px;
    }

        .image-upload:hover {
            background-color: #f0f0f0;
            border-color: #bbb;
        }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 15px 20px;
        border-top: 1px solid #e0e0e0;
        background-color: #ffffff;
    }

    .btn {
        padding: 10px 24px;
        border: 1px solid transparent;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        display: inline-block;
        text-align: center;
        transition: all 0.2s ease;
        min-width: 80px;
    }

    .btn-secondary {
        background-color: #6c757d;
        border-color: #6c757d;
        color: #ffffff;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
            transform: translateY(-1px);
        }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        color: #ffffff;
    }

        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #004085;
            transform: translateY(-1px);
        }

    .right-side-fields {
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-width: 220px;
    }

    .receipt-info {
        background-color: #fafafa;
        padding: 15px;
        border-radius: 6px;
        border: 1px solid #e0e0e0;
    }

    .receipt-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

        .receipt-row:last-child {
            margin-bottom: 0;
        }

        .receipt-row label {
            margin-bottom: 0;
            font-weight: 500;
            color: #555;
            font-size: 13px;
        }

        .receipt-row input {
            width: 111px;
            text-align: center;
            padding: 6px 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 13px;
        }

    .left-section {
        flex: 1;
        padding-right: 15px;
    }

    .right-section {
        min-width: 200px;
        display: flex;
        flex-direction: column;
        gap: 15px;
        padding-left: 15px;
        border-left: 1px solid #f0f0f0;
    }

    .financial-field {
        display: flex;
        flex-direction: column;
    }

        .financial-field input {
            text-align: right;
            font-weight: 500;
        }

    .total-field input {
        color: #007bff;
        font-weight: 600;
        font-size: 16px;
    }

    .content-row {
        display: flex;
        gap: 20px;
        margin-top: 20px;
    }

    @@media (max-width: 768px) {
        .form-row

    {
        flex-direction: column;
        gap: 15px;
    }

    .content-row {
        flex-direction: column;
        gap: 15px;
    }

    .right-side-fields {
        min-width: auto;
    }

    .modal-body {
        padding: 15px;
    }

    .modal-footer {
        flex-direction: column;
        gap: 10px;
    }

    .btn {
        width: 100%;
    }

    .receipt-row input {
        width: 80px;
    }

    .left-section,
    .right-section {
        padding: 0;
        border: none;
    }

    }
</style>

<div class="modal-header">
    <h3 class="modal-title">Payment-In</h3>
    <button type="button" class="modal-close" onclick="closeModal()">×</button>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" id="paymentInEditForm">
    <div class="modal-body">
        <!-- Main row with Party selection and Receipt info -->
        <div class="form-row main-row">
            <div class="form-group search-field">
                <label for="PartyId" class="required">Search by Name/Phone *</label>
                <select name="PartyId" id="PartyId" class="form-control" required>
                    <option value="">fasdfae</option>
                    @foreach (var party in ViewBag.Parties)
                    {
                        <option value="@party.Value">@party.Text</option>
                    }
                </select>
            </div>
            <div class="form-group right-side-fields">
                <div class="receipt-info">
                    <div class="receipt-row">
                        <label for="RefNo">Receipt No</label>
                        <input type="text" name="RefNo" id="RefNo" class="form-control" value="2" required>
                    </div>
                    <div class="receipt-row">
                        <label for="Date">Date</label>
                        <input type="date" name="Date" id="Date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                    </div>
                    <div class="receipt-row">
                        <label for="Time">Time</label>
                        <input type="time" name="Time" id="Time" class="form-control" value="@DateTime.Now.ToString("HH:mm")">
                    </div>
                </div>
            </div>
        </div>

        <!-- Content row with left and right sections -->
        <div class="content-row">
            <!-- Left section -->
            <div class="left-section">
                <!-- Payment Type section -->
                <div class="form-group" style="margin-bottom: 20px;">
                    <label for="PaymentType" style="margin-left:-373px;">Payment Type </label>
                    <select name="PaymentType" id="PaymentType" class="form-control">
                        <option value="Cash" selected>Cash</option>
                        <option value="Bank">Bank</option>
                        <option value="Card">Card</option>
                        <option value="Online">Online</option>
                    </select>
                </div>

              

                <!-- Add Description input -->
                <div style="margin-bottom: 20px;">
                    <div class="form-group">
                        <label for="Description" style="margin-left: -337px;"> ADD DESCRIPTION</label>
                        <input type="text" name="Description" id="Description" class="form-control" placeholder="Enter description here...">
                    </div>
                </div>

                <!-- Image upload icon -->
                <div style="margin-bottom: 25px; margin-left: -417px;">
                    <div class="image-upload" onclick="document.getElementById('imageInput').click()" title="Upload Image">
                        📷
                    </div>
                    <input type="file" id="imageInput" accept="image/*" style="display: none;">
                </div>
            </div>

            <!-- Right section with financial fields -->
            <div class="right-section">
                <div class="financial-field">
                    <label for="ReceivedPaid">Received</label>
                    <input type="number" name="ReceivedPaid" id="ReceivedPaid" class="form-control" step="0.01" oninput="calculateBalance()">
                </div>

                <div class="financial-field">
                    <label for="Discount">Discount</label>
                    <input type="number" name="Discount" id="Discount" class="form-control" step="0.01" oninput="calculateBalance()">
                </div>

                <div class="financial-field total-field">
                    <label for="Total">Total</label>
                    <input type="number" name="Total" id="Total" class="form-control" step="0.01" value="0" oninput="calculateBalance()">
                </div>
            </div>
        </div>

        <!-- Hidden fields for compatibility -->
        <input type="hidden" name="CategoryName" id="CategoryName" value="">
        <input type="hidden" name="Type" id="Type" value="">
        <input type="hidden" name="PrintShare" id="PrintShare" value="">
        <input type="hidden" name="Balance" id="Balance" value="0">

        <!-- Description container - now hidden since we have input above -->
        <div id="descriptionContainer" class="description-container hidden">
            <textarea name="DescriptionExtra" id="DescriptionExtra" class="description-textarea" placeholder="Enter additional description here..."></textarea>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="sharePayment()">Share</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>

<script>
    function toggleDescription() {
        const container = document.getElementById('descriptionContainer');
        container.classList.toggle('hidden');
    }

    function togglePaymentType() {
        // Add functionality for additional payment types if needed
        alert('Add Payment Type functionality would go here');
    }

    function calculateBalance() {
        const total = parseFloat(document.getElementById('Total').value) || 0;
        const received = parseFloat(document.getElementById('ReceivedPaid').value) || 0;
        const discount = parseFloat(document.getElementById('Discount').value) || 0;
        const balance = total - received - discount;
        document.getElementById('Balance').value = balance.toFixed(2);
    }

    function closeModal() {
        // Add close modal functionality
        console.log('Close modal');
    }

    function sharePayment() {
        // Add share functionality
        alert('Share functionality would go here');
    }

    // Initialize balance calculation on page load
    document.addEventListener('DOMContentLoaded', function() {
        calculateBalance();
    });
</script>