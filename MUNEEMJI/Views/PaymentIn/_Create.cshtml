@model PaymentInOutModel

<style>
    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 20px;
        border-bottom: 1px solid #e0e0e0;
        background-color: #ffffff;
    }

    .modal-title {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: #333;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
        color: #666;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        padding: 0;
    }

        .modal-close:hover {
            background-color: #f0f0f0;
            color: #333;
        }

    .modal-body {
        padding: 20px;
        background-color: #ffffff;
        min-height: 400px;
    }

    .form-row {
        display: flex;
        gap: 15px;
        margin-bottom: 15px;
        align-items: flex-start;
    }

        .form-row.main-row {
            margin-bottom: 25px;
        }

    .form-group {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

        .form-group.search-field {
            flex: 2;
        }

        .form-group.full-width {
            flex: 1 1 100%;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 500;
            color: #555;
            font-size: 14px;
        }

            .form-group label.required::after {
                content: ' *';
                color: #dc3545;
            }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

        .form-control:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
        }

        .form-control select {
            cursor: pointer;
        }

    .btn-link {
        color: #007bff;
        text-decoration: none;
        font-size: 14px;
        border: none;
        background: none;
        padding: 8px 0;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-weight: 500;
    }

        .btn-link:hover {
            text-decoration: underline;
            color: #0056b3;
        }

    .description-container {
        margin-top: 15px;
        padding: 15px;
        background-color: #fafafa;
        border-radius: 6px;
        border: 1px solid #e0e0e0;
    }

        .description-container.hidden {
            display: none;
        }

    .description-textarea {
        width: 100%;
        min-height: 100px;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        resize: vertical;
        font-family: inherit;
        box-sizing: border-box;
    }

    /* Image Upload Styles - Complete from First Code */
    .upload-area-imgshow {
        border: 2px solid lightgray;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        background: #f8f9fb;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        min-height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
    }

        .upload-area-imgshow:hover {
            border-color: #0056b3;
            background: #f0f4ff;
        }

    .upload-label-imgshow {
        position: absolute;
        top: -10px;
        left: 20px;
        background: white;
        padding: 0 8px;
        color: #6c757d;
        font-size: 14px;
        font-weight: 500;
    }

    .upload-content-imgshow {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .image-preview-imgshow {
        display: none;
        flex-direction: column;
        align-items: center;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 15px 20px;
        border-top: 1px solid #e0e0e0;
        background-color: #ffffff;
    }

    .btn {
        padding: 10px 24px;
        border: 1px solid transparent;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        display: inline-block;
        text-align: center;
        transition: all 0.2s ease;
        min-width: 80px;
    }

    .btn-secondary {
        background-color: #6c757d;
        border-color: #6c757d;
        color: #ffffff;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
            transform: translateY(-1px);
        }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        color: #ffffff;
    }

        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #004085;
            transform: translateY(-1px);
        }

    .right-side-fields {
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-width: 220px;
    }

    .receipt-info {
        background-color: #fafafa;
        padding: 15px;
        border-radius: 6px;
        border: 1px solid #e0e0e0;
    }

    .receipt-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

        .receipt-row:last-child {
            margin-bottom: 0;
        }

        .receipt-row label {
            margin-bottom: 0;
            font-weight: 500;
            color: #555;
            font-size: 13px;
        }

        .receipt-row input {
            width: 111px;
            text-align: center;
            padding: 6px 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 13px;
        }

    .left-section {
        flex: 1;
        padding-right: 15px;
    }

    .right-section {
        min-width: 200px;
        display: flex;
        flex-direction: column;
        gap: 15px;
        padding-left: 15px;
        border-left: 1px solid #f0f0f0;
    }

    .financial-field {
        display: flex;
        flex-direction: column;
    }

        .financial-field input {
            text-align: right;
            font-weight: 500;
        }

    .total-field input {
        color: #007bff;
        font-weight: 600;
        font-size: 16px;
    }

    .content-row {
        display: flex;
        gap: 20px;
        margin-top: 20px;
    }

    @@media (max-width: 768px) {
        .form-row

    {
        flex-direction: column;
        gap: 15px;
    }

    .content-row {
        flex-direction: column;
        gap: 15px;
    }

    .right-side-fields {
        min-width: auto;
    }

    .modal-body {
        padding: 15px;
    }

    .modal-footer {
        flex-direction: column;
        gap: 10px;
    }

    .btn {
        width: 100%;
    }

    .receipt-row input {
        width: 80px;
    }

    .left-section,
    .right-section {
        padding: 0;
        border: none;
    }

    }
</style>

<!-- Bootstrap Icons CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />



<div class="modal-header">
    <h3 class="modal-title">Payment-In</h3>
    <button type="button" class="modal-close" onclick="closeModal()">×</button>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" id="paymentInEditForm">
    <div class="modal-body">
        <input type="hidden" id="deleteLogoFlag" name="IsDeleteImage" value="false" />

        <!-- Main row with Party selection and Receipt info -->
        <div class="form-row main-row">
            <div class="form-group search-field">
                <label for="PartyId" class="required">Search by Name/Phone *</label>
                <select name="PartyId" id="PartyId" class="form-control" required>
                    <option value="">Select Party</option>
                    @foreach (var party in ViewBag.Parties)
                    {
                        <option value="@party.Value">@party.Text</option>
                    }
                </select>
            </div>
            <div class="form-group right-side-fields">
                <div class="receipt-info">
                    <div class="receipt-row">
                        <label for="RefNo">Receipt No</label>
                        <input type="text" name="RefNo" id="RefNo" class="form-control" value="2" required>
                    </div>
                    <div class="receipt-row">
                        <label for="Date">Date</label>
                        <input type="date" name="Date" id="Date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                    </div>
                    <div class="receipt-row">
                        <label for="Time">Time</label>
                        <input type="time" name="Time" id="Time" class="form-control" value="@DateTime.Now.ToString("HH:mm")">
                    </div>
                </div>
            </div>
        </div>

        <!-- Content row with left and right sections -->
        <div class="content-row">
            <!-- Left section -->
            <div class="left-section">
                <!-- Payment Type section -->
                <div class="form-group" style="margin-bottom: 20px;">
                    <label for="PaymentType">Payment Type</label>
                    <select name="PaymentType" id="PaymentType" class="form-control">
                        <option value="Cash" selected>Cash</option>
                        <option value="Bank">Bank</option>
                        <option value="Card">Card</option>
                        <option value="Online">Online</option>
                    </select>
                </div>

                <!-- Add Description input -->
                <div style="margin-bottom: 20px;">
                    <div class="form-group">
                        <label for="Description">ADD DESCRIPTION</label>
                        <input type="text" name="Description" id="Description" class="form-control" placeholder="Enter description here...">
                    </div>
                </div>

                <!-- Enhanced Image upload area - EXACT CODE FROM FIRST FILE -->
                <div style="margin-bottom: 25px;">
                    <div class="upload-area-imgshow"
                         style="border: 2px solid lightgray; border-radius: 8px; padding: 20px; text-align: center; background: #f8f9fb; cursor: pointer; transition: all 0.3s ease; position: relative;"
                         onclick="document.querySelector('input[name=\'imageFile\']').click()">

                        <span class="upload-label-imgshow"
                              style="position: absolute; top: -10px; left: 20px; background: white; padding: 0 8px; color: #6c757d; font-size: 14px;">
                            Add Image
                        </span>

                        <input type="file" name="imageFile" class="floating-input" accept="image/*"
                               onchange="previewImage(this)" style="display: none;" />

                        <div class="upload-content-imgshow">
                            <i class="bi bi-cloud-upload" style="font-size: 24px; color: #007bff; margin-bottom: 8px;"></i>
                            <div style="color: #007bff; font-weight: 500;">Upload</div>
                            <div style="color: #6c757d; font-size: 12px; margin-top: 4px;">Click to browse files</div>
                        </div>

                        <div class="image-preview-imgshow" style="display: none;">
                            <img id="preview-img-imgshow" src="" alt="Preview"
                                 style="max-width: 200px; max-height: 85px; border: 1px solid #ddd; border-radius: 4px;" />
                            <div id="image-name-imgshow" style="margin-top: 8px; color: #6c757d; font-size: 12px; word-break: break-all;"></div>
                            <div style="margin-top: 8px;">
                                <button type="button" onclick="removeImage(event)" style="padding: 5px 15px; background: #007bff; color: white; border: none; border-radius: 3px; cursor: pointer;">
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right section with financial fields -->
            <div class="right-section">
                <div class="financial-field">
                    <label for="ReceivedPaid">Received</label>
                    <input type="number" name="ReceivedPaid" id="ReceivedPaid" class="form-control" step="0.01" oninput="calculateBalance()">
                </div>

                <div class="financial-field">
                    <label for="Discount">Discount</label>
                    <input type="number" name="Discount" id="Discount" class="form-control" step="0.01" oninput="calculateBalance()">
                </div>

                <div class="financial-field total-field">
                    <label for="Total">Total</label>
                    <input type="number" name="Total" id="Total" class="form-control" step="0.01" value="0" oninput="calculateBalance()">
                </div>
            </div>
        </div>

        <!-- Hidden fields for compatibility -->
        <input type="hidden" name="CategoryName" id="CategoryName" value="">
        <input type="hidden" name="Type" id="Type" value="">
        <input type="hidden" name="PrintShare" id="PrintShare" value="">
        <input type="hidden" name="Balance" id="Balance" value="0">
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="sharePayment()">Share</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>

<script>
    // COMPLETE IMAGE UPLOAD JAVASCRIPT FROM FIRST CODE
    function previewImage(input) {
        debugger;
        const file = input.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.querySelector('.upload-content-imgshow').style.display = 'none';
                document.querySelector('.image-preview-imgshow').style.display = 'block';
                document.getElementById('preview-img-imgshow').src = e.target.result;
                document.getElementById('image-name-imgshow').textContent = file.name;
                document.querySelector('.upload-area-imgshow').style.borderColor = '#28a745';
                document.getElementById('deleteLogoFlag').value = 'false';
            };
            reader.readAsDataURL(file);
        }
    }

    function setLogoFromData(imageUrl, imageName) {
        document.querySelector('.upload-content-imgshow').style.display = 'none';
        document.querySelector('.image-preview-imgshow').style.display = 'block';
        document.getElementById('preview-img-imgshow').src = imageUrl;
        document.getElementById('image-name-imgshow').textContent = imageName || 'Loaded Image';
        document.querySelector('.upload-area-imgshow').style.borderColor = '#28a745';
        document.getElementById('deleteLogoFlag').value = 'false';
    }

    function removeImage(event) {
        debugger;
        event.stopPropagation();
        document.querySelector('input[name="imageFile"]').value = '';
        document.querySelector('.upload-content-imgshow').style.display = 'block';
        document.querySelector('.image-preview-imgshow').style.display = 'none';
        document.getElementById('preview-img-imgshow').src = '';
        document.getElementById('image-name-imgshow').textContent = '';
        document.querySelector('.upload-area-imgshow').style.borderColor = 'lightgray';
        document.getElementById('deleteLogoFlag').value = 'true';
    }

    // Balance Calculation
    function calculateBalance() {
        const total = parseFloat(document.getElementById('Total').value) || 0;
        const received = parseFloat(document.getElementById('ReceivedPaid').value) || 0;
        const discount = parseFloat(document.getElementById('Discount').value) || 0;
        const balance = total - received - discount;
        document.getElementById('Balance').value = balance.toFixed(2);
    }

    function closeModal() {
        console.log('Close modal');
        // Add your modal close logic here
    }

    function sharePayment() {
        alert('Share functionality would go here');
    }

    // Initialize on page load - EXACT FROM FIRST CODE
    document.addEventListener('DOMContentLoaded', function() {
        var logoPath = '@Html.Raw(Model?.ImagePath ?? "")';

        // If logo exists, display it
        if (logoPath && logoPath !== '') {
            var logoUrl = logoPath.startsWith('/') ? logoPath : '/' + logoPath;
            var logoFileName = logoPath.split('/').pop();
            setLogoFromData(logoUrl, logoFileName);
        }

        calculateBalance();
    });
</script>