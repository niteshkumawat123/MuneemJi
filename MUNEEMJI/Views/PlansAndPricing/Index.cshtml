@{
    ViewData["Title"] = "Plans & Pricing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .pp-page { padding: 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }

    /* Header */
    .pp-hero { text-align: center; padding: 32px 16px 24px; }
    .pp-hero h1 { font-size: 28px; font-weight: 700; color: #1f2937; margin-bottom: 6px; }
    .pp-hero p { color: #6b7280; font-size: 15px; }

    /* Toggle Pills */
    .pp-toggles { display: flex; justify-content: center; gap: 10px; margin-bottom: 28px; flex-wrap: wrap; }
    .pp-pill { display: inline-flex; align-items: center; gap: 6px; padding: 8px 18px; border-radius: 20px; border: 1px solid #d1d5db; background: #fff; font-size: 13px; font-weight: 500; color: #374151; cursor: pointer; transition: all .15s; position: relative; }
    .pp-pill.active { background: #eef2ff; border-color: #6366f1; color: #4338ca; }
    .pp-pill:hover { border-color: #9ca3af; }
    .pp-pill i { font-size: 10px; }
    .pp-pill-menu { display: none; position: absolute; top: 42px; left: 0; background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; box-shadow: 0 4px 16px rgba(0,0,0,.1); min-width: 180px; z-index: 50; overflow: hidden; }
    .pp-pill-menu.open { display: block; }
    .pp-pill-opt { padding: 10px 16px; font-size: 13px; cursor: pointer; display: flex; align-items: center; justify-content: space-between; }
    .pp-pill-opt:hover { background: #f9fafb; }
    .pp-pill-opt.sel { color: #4338ca; font-weight: 600; }
    .pp-pill-opt.sel::after { content: '?'; color: #4338ca; }

    /* Plans Grid */
    .pp-plans { display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; margin-bottom: 32px; max-width: 860px; margin-left: auto; margin-right: auto; }

    /* Plan Card */
    .pp-card { flex: 1; min-width: 280px; max-width: 400px; border: 2px solid #e5e7eb; border-radius: 14px; padding: 28px 24px; position: relative; background: #fff; transition: all .2s; }
    .pp-card:hover { box-shadow: 0 6px 24px rgba(0,0,0,.08); }
    .pp-card.gold { border-color: #f59e0b; background: linear-gradient(180deg, #fffbeb 0%, #fff 60%); }
    .pp-card .popular-tag { position: absolute; top: -1px; right: 20px; background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; padding: 4px 14px; border-radius: 0 0 8px 8px; font-size: 11px; font-weight: 600; letter-spacing: .3px; }
    .pp-plan-icon { width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-size: 16px; margin-right: 8px; }
    .pp-plan-icon.silver-icon { background: #e5e7eb; color: #6b7280; }
    .pp-plan-icon.gold-icon { background: #fde68a; color: #d97706; }
    .pp-plan-name { font-size: 22px; font-weight: 700; color: #1f2937; display: flex; align-items: center; margin-bottom: 16px; }
    .pp-price-row { margin-bottom: 4px; }
    .pp-old-price { text-decoration: line-through; color: #9ca3af; font-size: 16px; margin-right: 6px; }
    .pp-price { font-size: 36px; font-weight: 800; color: #1f2937; }
    .pp-price-sub { font-size: 13px; color: #6b7280; margin-bottom: 18px; }
    .pp-cta { display: block; width: 100%; padding: 12px; border-radius: 24px; font-size: 15px; font-weight: 600; text-align: center; cursor: pointer; transition: all .2s; border: 2px solid; text-decoration: none; margin-bottom: 20px; }
    .pp-cta.silver-cta { background: #fff; color: #ef4444; border-color: #ef4444; }
    .pp-cta.silver-cta:hover { background: #fef2f2; }
    .pp-cta.gold-cta { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; border-color: transparent; }
    .pp-cta.gold-cta:hover { opacity: .9; transform: translateY(-1px); }

    /* Feature List inside card */
    .pp-features { list-style: none; padding: 0; margin: 0; }
    .pp-features li { display: flex; align-items: flex-start; gap: 8px; padding: 6px 0; font-size: 13px; color: #374151; line-height: 1.4; }
    .pp-features .fi { flex-shrink: 0; width: 18px; text-align: center; font-size: 14px; margin-top: 1px; }
    .pp-features .fi.yes { color: #16a34a; }
    .pp-features .fi.no { color: #d1d5db; }
    .pp-more-features { margin-top: 12px; font-size: 13px; color: #6366f1; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 4px; }
    .pp-more-features:hover { text-decoration: underline; }

    /* Compare All link */
    .pp-compare-link { text-align: center; margin-bottom: 32px; }
    .pp-compare-btn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 24px; background: #fff; border: 1px solid #d1d5db; border-radius: 24px; font-size: 14px; font-weight: 600; color: #4338ca; cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,.06); transition: all .15s; }
    .pp-compare-btn:hover { border-color: #6366f1; background: #eef2ff; }

    /* Feature Comparison Table */
    .pp-compare-section { max-width: 960px; margin: 0 auto 40px; display: none; }
    .pp-compare-section.show { display: block; }
    .pp-compare-table { width: 100%; border-collapse: collapse; }
    .pp-compare-table thead { position: sticky; top: 0; z-index: 5; }
    .pp-compare-table th { padding: 14px 16px; background: #f9fafb; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: .4px; border-bottom: 2px solid #e5e7eb; text-align: center; }
    .pp-compare-table th:first-child { text-align: left; width: 45%; }
    .pp-compare-table td { padding: 12px 16px; font-size: 13px; color: #374151; border-bottom: 1px solid #f3f4f6; text-align: center; }
    .pp-compare-table td:first-child { text-align: left; font-weight: 500; }
    .pp-compare-table tbody tr:nth-child(even) { background: #fafbfc; }
    .pp-compare-table tbody tr:hover { background: #f0f4ff; }
    .pp-compare-table .ct-yes { color: #16a34a; font-size: 16px; }
    .pp-compare-table .ct-no { color: #d1d5db; font-size: 16px; }
    .pp-compare-table .ct-val { color: #374151; font-size: 12px; font-style: italic; }
    .pp-compare-table .th-silver { color: #6b7280; }
    .pp-compare-table .th-gold { color: #d97706; }

    /* Back to Plans */
    .pp-back-plans { text-align: center; margin-top: 20px; }
    .pp-back-plans a { display: inline-flex; align-items: center; gap: 6px; color: #6366f1; font-weight: 600; font-size: 14px; cursor: pointer; text-decoration: none; }
    .pp-back-plans a:hover { text-decoration: underline; }

    /* FAQ */
    .pp-faq { max-width: 720px; margin: 0 auto 40px; }
    .pp-faq h3 { text-align: center; font-size: 22px; font-weight: 700; color: #1f2937; margin-bottom: 20px; }
    .pp-faq-item { border: 1px solid #e5e7eb; border-radius: 10px; margin-bottom: 10px; overflow: hidden; }
    .pp-faq-q { display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; cursor: pointer; font-size: 14px; font-weight: 500; color: #1f2937; background: #fff; transition: background .15s; }
    .pp-faq-q:hover { background: #f9fafb; }
    .pp-faq-q i { transition: transform .2s; font-size: 12px; color: #9ca3af; }
    .pp-faq-item.open .pp-faq-q i { transform: rotate(180deg); }
    .pp-faq-a { display: none; padding: 0 18px 14px; font-size: 13px; color: #6b7280; line-height: 1.6; }
    .pp-faq-item.open .pp-faq-a { display: block; }

    @@media (max-width: 640px) {
        .pp-plans { flex-direction: column; align-items: center; }
        .pp-card { max-width: 100%; }
    }
</style>

