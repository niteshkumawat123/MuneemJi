@model List<MUNEEMJI.Models.PurchaseBill>

<div class="rpt-wrapper">
    <div class="rpt-container">

        <div class="rpt-header">
            <h2>All Transactions</h2>
            <div class="rpt-header-actions">
                <button class="rpt-btn-icon" title="Excel" onclick="exportTable()"><i class="fas fa-file-excel"></i></button>
                <button class="rpt-btn-icon" title="Print" onclick="window.print()"><i class="fas fa-print"></i></button>
            </div>
        </div>

        <div class="rpt-filters">
            <div class="rpt-filter-group">
                <label>Filter By</label>
                <select id="filterBySelect">
                    <option value="">Custom</option>
                    <option value="thisMonth">This Month</option>
                    <option value="lastMonth">Last Month</option>
                    <option value="thisQuarter">This Quarter</option>
                    <option value="thisYear">This Year</option>
                </select>
            </div>
            <div class="rpt-filter-group">
                <label>Date Range</label>
                <div class="rpt-date-range">
                    <input type="date" id="startDate" value="@DateTime.Now.ToString("yyyy-MM-01")" />
                    <span>to</span>
                    <input type="date" id="endDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="rpt-filter-group">
                <label>Transaction</label>
                <select id="transactionFilter">
                    <option value="">All</option>
                    <option value="Sale">Sale</option>
                    <option value="Purchase">Purchase</option>
                    <option value="Payment">Payment</option>
                </select>
            </div>
            <div class="rpt-filter-group">
                <label>Payment</label>
                <select id="paymentFilter">
                    <option value="">All</option>
                    <option value="Cash">Cash</option>
                    <option value="Credit">Credit</option>
                    <option value="UPI">UPI</option>
                    <option value="Cheque">Cheque</option>
                </select>
            </div>
        </div>

        @{
            decimal total = Model?.Sum(x => x.Total) ?? 0;
            decimal received = Model?.Sum(x => x.paidReciveamount) ?? 0;
            decimal balance = Model?.Sum(x => x.FinalAmount) ?? 0;
        }
        <div class="rpt-summary">
            <div class="rpt-summary-card">
                <div class="rpt-summary-label">Total Amount</div>
                <p class="rpt-summary-value">&#8377; @total.ToString("N2")</p>
            </div>
            <div class="rpt-summary-card green">
                <div class="rpt-summary-label">Received</div>
                <p class="rpt-summary-value">&#8377; @received.ToString("N2")</p>
            </div>
            <div class="rpt-summary-card red">
                <div class="rpt-summary-label">Balance</div>
                <p class="rpt-summary-value">&#8377; @balance.ToString("N2")</p>
            </div>
        </div>

        <div class="rpt-table-section">
            <div class="rpt-table-header">
                <h4>Transactions (@(Model?.Count ?? 0))</h4>
                <div class="rpt-table-actions">
                    <div class="rpt-search">
                        <input type="text" id="searchInput" placeholder="Search..." />
                        <i class="fas fa-search"></i>
                    </div>
                </div>
            </div>

            <div class="rpt-table-wrap">
                <table class="rpt-table" id="transactionsTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Ref No</th>
                            <th>Party Name</th>
                            <th>Category</th>
                            <th>Type</th>
                            <th class="amt">Total</th>
                            <th class="amt">Received</th>
                            <th class="amt">Balance</th>
                            <th>Due Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        @if (Model != null && Model.Any())
                        {
                            int i = 1;
                            foreach (var item in Model)
                            {
                                <tr class="data-row" data-date="@(item.InvoiceDate?.ToString("yyyy-MM-dd") ?? "")">
                                    <td>@i</td>
                                    <td>@(item.InvoiceDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                    <td><strong>@item.InvoiceNumber</strong></td>
                                    <td>@item.PartyName</td>
                                    <td>@item.CategoryName</td>
                                    <td> Sale</td>
                                    <td class="amt">&#8377; @item.Total.ToString("N2")</td>
                                    <td class="amt">&#8377; @item.paidReciveamount.ToString("N2")</td>
                                    <td class="amt">&#8377; @item.FinalAmount.ToString("N2")</td>
                                    <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @{
                                            var sc2 = item.orderstatusid == 1 ? "rpt-badge rpt-badge-paid" : item.orderstatusid == 2 ? "rpt-badge rpt-badge-partial" : "rpt-badge rpt-badge-unpaid";
                                            var st2 = item.orderstatusid == 1 ? "Paid" : item.orderstatusid == 2 ? "Partial" : "Unpaid";
                                        }
                                        <span class="@sc2">@st2</span>
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr class="no-data-row">
                                <td colspan="11">
                                    <div class="rpt-empty">
                                        <div class="rpt-empty-icon"><i class="fas fa-exchange-alt"></i></div>
                                        <h5>No Transactions Found</h5>
                                        <p>No transactions available for the selected period. Start by adding a sale or purchase.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<script>
(function() {
    const si = document.getElementById('searchInput');
    const rows = Array.from(document.querySelectorAll('#tableBody tr.data-row'));
    if (si) si.addEventListener('keyup', function() {
        const t = this.value.toLowerCase().trim();
        rows.forEach(r => r.classList.toggle('hidden', t && !r.innerText.toLowerCase().includes(t)));
    });
    window.exportTable = function() {
        let csv = [];
        document.querySelectorAll('#transactionsTable tr:not(.hidden):not(.no-data-row)').forEach(r => {
            csv.push(Array.from(r.querySelectorAll('th,td')).map(c => '"' + c.textContent.trim().replace(/"/g, '""') + '"').join(','));
        });
        const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv.join('\n')], { type: 'text/csv' })); a.download = 'all_transactions.csv'; a.click();
    };
})();
</script>
