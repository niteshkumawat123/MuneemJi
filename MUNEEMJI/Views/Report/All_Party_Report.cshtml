@model List<MUNEEMJI.Models.PartyModel>

<div class="rpt-wrapper">
    <div class="rpt-container">

        <div class="rpt-header">
            <h2>All Parties Report</h2>
            <div class="rpt-header-actions">
                <button class="rpt-btn-icon" title="Excel" onclick="exportTable()"><i class="fas fa-file-excel"></i></button>
                <button class="rpt-btn-icon" title="Print" onclick="window.print()"><i class="fas fa-print"></i></button>
            </div>
        </div>

        <div class="rpt-filters">
            <div class="rpt-filter-group">
                <label>Search</label>
                <input type="text" id="searchInput" placeholder="Search party name, email, phone..." />
            </div>
        </div>

        <div class="rpt-summary">
            <div class="rpt-summary-card blue">
                <div class="rpt-summary-label">Total Parties</div>
                <p class="rpt-summary-value">@(Model?.Count ?? 0)</p>
            </div>
            <div class="rpt-summary-card green">
                <div class="rpt-summary-label">Total Receivable</div>
                <p class="rpt-summary-value" id="totalReceivable">&#8377; 0.00</p>
            </div>
            <div class="rpt-summary-card red">
                <div class="rpt-summary-label">Total Payable</div>
                <p class="rpt-summary-value" id="totalPayable">&#8377; 0.00</p>
            </div>
        </div>

        <div class="rpt-table-section">
            <div class="rpt-table-header">
                <h4>Parties</h4>
            </div>

            <div class="rpt-table-wrap">
                <table class="rpt-table" id="transactionsTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Party Name</th>
                            <th>Email</th>
                            <th>Phone No</th>
                            <th class="amt">Receivable</th>
                            <th class="amt">Payable</th>
                            <th class="amt">Credit Limit</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        @if (Model != null && Model.Any())
                        {
                            int i = 1;
                            foreach (var item in Model)
                            {
                                <tr class="data-row">
                                    <td>@i</td>
                                    <td><strong>@item.PartyName</strong></td>
                                    <td>@(item.Email ?? "�")</td>
                                    <td>@(item.PhoneNumber ?? "�")</td>
                                    <td class="amt" style="color:#16a34a;">&#8377; 0.00</td>
                                    <td class="amt">�</td>
                                    <td class="amt">�</td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr class="no-data-row">
                                <td colspan="7">
                                    <div class="rpt-empty">
                                        <div class="rpt-empty-icon"><i class="fas fa-users"></i></div>
                                        <h5>No Parties Found</h5>
                                        <p>No parties have been added yet. Add your first party from the Parties section.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<script>
(function() {
    const si = document.getElementById('searchInput');
    const rows = Array.from(document.querySelectorAll('#tableBody tr.data-row'));
    if (si) si.addEventListener('keyup', function() {
        const t = this.value.toLowerCase().trim();
        rows.forEach(r => r.classList.toggle('hidden', t && !r.innerText.toLowerCase().includes(t)));
    });
    window.exportTable = function() {
        let csv = [];
        document.querySelectorAll('#transactionsTable tr:not(.hidden):not(.no-data-row)').forEach(r => {
            csv.push(Array.from(r.querySelectorAll('th,td')).map(c => '"' + c.textContent.trim().replace(/"/g, '""') + '"').join(','));
        });
        const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv.join('\n')], { type: 'text/csv' })); a.download = 'all_parties.csv'; a.click();
    };
})();
</script>
