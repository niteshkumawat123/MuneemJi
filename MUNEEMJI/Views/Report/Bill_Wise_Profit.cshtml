@model List<MUNEEMJI.Models.PurchaseBill>

@{
    decimal totalSale = Model?.Sum(x => x.Total) ?? 0;
    decimal totalProfit = Model?.Sum(x => x.Total) ?? 0;
}

<div class="rpt-wrapper">
    <div class="rpt-container">

        <div class="rpt-header">
            <h2>Bill Wise Profit</h2>
            <div class="rpt-header-actions">
                <button class="rpt-btn-icon" title="Excel" onclick="exportTable()"><i class="fas fa-file-excel"></i></button>
                <button class="rpt-btn-icon" title="Print" onclick="window.print()"><i class="fas fa-print"></i></button>
            </div>
        </div>

        <div class="rpt-filters">
            <div class="rpt-filter-group">
                <label>Date Range</label>
                <div class="rpt-date-range">
                    <input type="date" id="startDate" value="@DateTime.Now.ToString("yyyy-MM-01")" />
                    <span>to</span>
                    <input type="date" id="endDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="rpt-filter-group">
                <label>Search Party / Invoice</label>
                <input type="text" id="partyFilter" placeholder="Type to filter..." />
            </div>
        </div>

        <div class="rpt-summary">
            <div class="rpt-summary-card">
                <div class="rpt-summary-label">Total Sale Amount</div>
                <p class="rpt-summary-value" id="totalSaleAmount">&#8377; @totalSale.ToString("N2")</p>
            </div>
            <div class="rpt-summary-card green">
                <div class="rpt-summary-label">Total Profit (+) / Loss (-)</div>
                <p class="rpt-summary-value" id="totalProfit">&#8377; @totalProfit.ToString("N2")</p>
            </div>
        </div>

        <div class="rpt-table-section">
            <div class="rpt-table-header">
                <h4>Sale Invoices</h4>
            </div>

            <div class="rpt-table-wrap">
                <table class="rpt-table" id="transactionsTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Invoice No</th>
                            <th>Party Name</th>
                            <th class="amt">Sale Amount</th>
                            <th class="amt">Profit / Loss</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        @if (Model != null && Model.Any())
                        {
                            int i = 1;
                            foreach (var item in Model)
                            {
                                var profit = item.Total;
                                <tr class="data-row"
                                    data-party="@item.PartyName?.ToLower()"
                                    data-invoice="@item.InvoiceNumber"
                                    data-totalsale="@item.Total"
                                    data-profit="@profit"
                                    data-date="@(item.InvoiceDate?.ToString("yyyy-MM-dd") ?? "")">
                                    <td>@i</td>
                                    <td>@(item.InvoiceDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                    <td><strong>@item.InvoiceNumber</strong></td>
                                    <td>@item.PartyName</td>
                                    <td class="amt">&#8377; @item.Total.ToString("N2")</td>
                                    <td class="amt" style="color:@(profit >= 0 ? "#16a34a" : "#dc2626"); font-weight:600;">&#8377; @profit.ToString("N2")</td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr class="no-data-row">
                                <td colspan="6">
                                    <div class="rpt-empty">
                                        <div class="rpt-empty-icon"><i class="fas fa-chart-line"></i></div>
                                        <h5>No Profit Data</h5>
                                        <p>No sale invoices found for the selected period.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<script>
(function() {
    const pf = document.getElementById('partyFilter');
    const rows = Array.from(document.querySelectorAll('#tableBody tr.data-row'));

    if (pf) pf.addEventListener('input', filter);

    function filter() {
        const t = (pf.value || '').toLowerCase().trim();
        let ts = 0, tp = 0;
        rows.forEach(r => {
            const ok = !t || (r.dataset.party || '').includes(t) || (r.dataset.invoice || '').includes(t);
            r.classList.toggle('hidden', !ok);
            if (ok) { ts += parseFloat(r.dataset.totalsale) || 0; tp += parseFloat(r.dataset.profit) || 0; }
        });
        const fmt = v => '? ' + v.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('totalSaleAmount').textContent = fmt(ts);
        document.getElementById('totalProfit').textContent = fmt(tp);
    }

    window.exportTable = function() {
        let csv = [];
        document.querySelectorAll('#transactionsTable tr:not(.hidden):not(.no-data-row)').forEach(r => {
            csv.push(Array.from(r.querySelectorAll('th,td')).map(c => '"' + c.textContent.trim().replace(/"/g, '""') + '"').join(','));
        });
        const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv.join('\n')], { type: 'text/csv' })); a.download = 'bill_wise_profit.csv'; a.click();
    };
})();
</script>
