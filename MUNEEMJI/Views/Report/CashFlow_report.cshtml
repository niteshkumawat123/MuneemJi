@model List<MUNEEMJI.Models.PurchaseBill>

<div class="rpt-wrapper">
    <div class="rpt-container">

        <div class="rpt-header">
            <h2>Cash Flow / Cash Book</h2>
            <div class="rpt-header-actions">
                <button class="rpt-btn-icon" title="Excel" onclick="exportTable()"><i class="fas fa-file-excel"></i></button>
                <button class="rpt-btn-icon" title="Print" onclick="window.print()"><i class="fas fa-print"></i></button>
            </div>
        </div>

        <div class="rpt-filters">
            <div class="rpt-filter-group">
                <label>Date Range</label>
                <div class="rpt-date-range">
                    <input type="date" id="startDate" value="@DateTime.Now.ToString("yyyy-MM-01")" />
                    <span>to</span>
                    <input type="date" id="endDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="rpt-filter-group" style="align-self:end;">
                <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
                    <input type="checkbox" id="showZeroAmount" style="width:auto;" /> Show zero amount
                </label>
            </div>
        </div>

        <div class="rpt-summary">
            <div class="rpt-summary-card green">
                <div class="rpt-summary-label">Total Cash In</div>
                <p class="rpt-summary-value">&#8377; 0.00</p>
            </div>
            <div class="rpt-summary-card red">
                <div class="rpt-summary-label">Total Cash Out</div>
                <p class="rpt-summary-value">&#8377; 0.00</p>
            </div>
            <div class="rpt-summary-card blue">
                <div class="rpt-summary-label">Closing Cash in Hand</div>
                <p class="rpt-summary-value">&#8377; 0.00</p>
            </div>
        </div>

        <div class="rpt-table-section">
            <div class="rpt-table-header">
                <h4>Transactions (@(Model?.Count ?? 0))</h4>
                <div class="rpt-table-actions">
                    <div class="rpt-search">
                        <input type="text" id="searchInput" placeholder="Search..." />
                        <i class="fas fa-search"></i>
                    </div>
                </div>
            </div>

            <div class="rpt-table-wrap">
                <table class="rpt-table" id="transactionsTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Ref No</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Type</th>
                            <th class="amt">Cash In</th>
                            <th class="amt">Cash Out</th>
                            <th class="amt">Running Balance</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        @if (Model != null && Model.Any())
                        {
                            int i = 1;
                            foreach (var item in Model)
                            {
                                <tr class="data-row">
                                    <td>@i</td>
                                    <td>@item.CreatedDate.ToString("dd MMM yyyy")</td>
                                    <td><strong>@item.InvoiceNumber</strong></td>
                                    <td>@item.PartyName</td>
                                    <td>@item.CategoryName</td>
                                    <td> Sale</td>
                                    <td class="amt" style="color:#16a34a;">&#8377; 0.00</td>
                                    <td class="amt" style="color:#dc2626;">&#8377; 0.00</td>
                                    <td class="amt">&#8377; 0.00</td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr class="no-data-row">
                                <td colspan="9">
                                    <div class="rpt-empty">
                                        <div class="rpt-empty-icon"><i class="fas fa-money-bill-wave"></i></div>
                                        <h5>No Cash Transactions</h5>
                                        <p>No cash flow entries found for the selected period. Cash transactions from sales, purchases, and payments will appear here.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<script>
(function() {
    const si = document.getElementById('searchInput');
    const rows = Array.from(document.querySelectorAll('#tableBody tr.data-row'));
    if (si) si.addEventListener('keyup', function() {
        const t = this.value.toLowerCase().trim();
        rows.forEach(r => r.classList.toggle('hidden', t && !r.innerText.toLowerCase().includes(t)));
    });
    window.exportTable = function() {
        let csv = [];
        document.querySelectorAll('#transactionsTable tr:not(.hidden):not(.no-data-row)').forEach(r => {
            csv.push(Array.from(r.querySelectorAll('th,td')).map(c => '"' + c.textContent.trim().replace(/"/g, '""') + '"').join(','));
        });
        const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv.join('\n')], { type: 'text/csv' })); a.download = 'cashflow.csv'; a.click();
    };
})();
</script>
