@model List<MUNEEMJI.Models.ReportModel.DayBookReportModel>

@{
    decimal moneyIn = Model?.Sum(x => x.MoneyIn) ?? 0;
    decimal moneyOut = Model?.Sum(x => x.MoneyOut) ?? 0;
    decimal totalAmt = Model?.Sum(x => x.Total) ?? 0;
}

<div class="rpt-wrapper">
    <div class="rpt-container">

        <div class="rpt-header">
            <h2>Daybook</h2>
            <div class="rpt-header-actions">
                <button class="rpt-btn-icon" title="Excel" onclick="exportTable()"><i class="fas fa-file-excel"></i></button>
                <button class="rpt-btn-icon" title="Print" onclick="window.print()"><i class="fas fa-print"></i></button>
            </div>
        </div>

        <div class="rpt-filters">
            <div class="rpt-filter-group">
                <label>Date</label>
                <input type="date" id="dateInput" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
        </div>

        <div class="rpt-summary">
            <div class="rpt-summary-card green">
                <div class="rpt-summary-label">Total Money In</div>
                <p class="rpt-summary-value">? @moneyIn.ToString("N2")</p>
            </div>
            <div class="rpt-summary-card red">
                <div class="rpt-summary-label">Total Money Out</div>
                <p class="rpt-summary-value">? @moneyOut.ToString("N2")</p>
            </div>
            <div class="rpt-summary-card blue">
                <div class="rpt-summary-label">Net (In - Out)</div>
                <p class="rpt-summary-value">? @((moneyIn - moneyOut).ToString("N2"))</p>
            </div>
        </div>

        <div class="rpt-table-section">
            <div class="rpt-table-header">
                <h4>Transactions (@(Model?.Count ?? 0))</h4>
                <div class="rpt-table-actions">
                    <div class="rpt-search">
                        <input type="text" id="searchInput" placeholder="Search..." />
                        <i class="fas fa-search"></i>
                    </div>
                </div>
            </div>

            <div class="rpt-table-wrap">
                <table class="rpt-table" id="transactionsTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Ref No</th>
                            <th>Type</th>
                            <th class="amt">Total</th>
                            <th class="amt">Money In</th>
                            <th class="amt">Money Out</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        @if (Model != null && Model.Any())
                        {
                            int i = 1;
                            foreach (var item in Model)
                            {
                                <tr class="data-row">
                                    <td>@i</td>
                                    <td>@item.PartyName</td>
                                    <td><strong>@item.invoicenumber</strong></td>
                                    <td>Sale</td>
                                    <td class="amt">? @item.Total.ToString("N2")</td>
                                    <td class="amt" style="color:#16a34a;">? @item.MoneyIn.ToString("N2")</td>
                                    <td class="amt" style="color:#dc2626;">? @item.MoneyOut.ToString("N2")</td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr class="no-data-row">
                                <td colspan="7">
                                    <div class="rpt-empty">
                                        <div class="rpt-empty-icon"><i class="fas fa-book"></i></div>
                                        <h5>No Daybook Entries</h5>
                                        <p>No transactions recorded for this date. All sales, purchases, and payments will appear here.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<script>
(function() {
    const si = document.getElementById('searchInput');
    const rows = Array.from(document.querySelectorAll('#tableBody tr.data-row'));
    if (si) si.addEventListener('keyup', function() {
        const t = this.value.toLowerCase().trim();
        rows.forEach(r => r.classList.toggle('hidden', t && !r.innerText.toLowerCase().includes(t)));
    });
    window.exportTable = function() {
        let csv = [];
        document.querySelectorAll('#transactionsTable tr:not(.hidden):not(.no-data-row)').forEach(r => {
            csv.push(Array.from(r.querySelectorAll('th,td')).map(c => '"' + c.textContent.trim().replace(/"/g, '""') + '"').join(','));
        });
        const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv.join('\n')], { type: 'text/csv' })); a.download = 'daybook.csv'; a.click();
    };
})();
</script>
