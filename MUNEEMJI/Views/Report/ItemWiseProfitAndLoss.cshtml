    <script>
        // Date picker initialization
        document.getElementById('fromDate').addEventListener('click', function() {
            this.type = 'date';
        });

        document.getElementById('toDate').addEventListener('click', function() {
            this.type = 'date';
        });

        document.getElementById('fromDate').addEventListener('blur', function() {
            if (!this.value) {
                this.type = 'text';
            }
        });

        document.getElementById('toDate').addEventListener('blur', function() {
            if (!this.value) {
                this.type = 'text';
            }
        });

        // Calendar icon click handlers
        document.querySelectorAll('.calendar-icon').forEach(icon => {
            icon.addEventListener('click', function() {
                const input = this.previousElementSibling;
                input.type = 'date';
                input.focus();
            });
        });

        // Date change handlers
        document.getElementById('fromDate').addEventListener('change', function() {
            console.log('From date changed:', this.value);
            fetchStockReport();
        });

        document.getElementById('toDate').addEventListener('change', function() {
            console.log('To date changed:', this.value);
            fetchStockReport();
        });

        // Items Having Sale checkbox
        document.getElementById('itemsHavingSale').addEventListener('change', function() {
            console.log('Items Having Sale filter:', this.checked);
            filterItemsWithSale(this.checked);
        });

        // Excel Export button
        document.getElementById('excelBtn').addEventListener('click', function() {
            console.log('Export to Excel clicked');
            exportToExcel();
        });

        // Print button
        document.getElementById('printBtn').addEventListener('click', function() {
            console.log('Print clicked');
            window.print();
        });

        // Helper Functions
        function fetchStockReport() {
            const fromDate = document.getElementById('fromDate').value;
            const toDate = document.getElementById('toDate').value;

            console.log('Fetching stock report from', fromDate, 'to', toDate);

            // Example API call:
            // fetch(`/api/stock-report?from=${fromDate}&to=${toDate}`)
            //     .then(response => response.json())
            //     .then(data => updateTable(data))
            //     .catch(error => console.error('Error:', error));
        }

        function filterItemsWithSale(showOnlyWithSale) {
            const rows = document.querySelectorAll('#stockTable tbody tr');

            rows.forEach(row => {
                const saleCell = row.cells[1];
                const saleValue = parseInt(saleCell.textContent);

                if (showOnlyWithSale) {
                    row.style.display = saleValue > 0 ? '' : 'none';
                } else {
                    row.style.display = '';
                }
            });

            updateTotalAmount();
        }

        function updateTotalAmount() {
            const rows = document.querySelectorAll('#stockTable tbody tr');
            let total = 0;

            rows.forEach(row => {
                if (row.style.display !== 'none') {
                    const profitCell = row.cells[11];
                    const profitText = profitCell.textContent.replace(/[₹,\s]/g, '');
                    const profitValue = parseFloat(profitText);
                    if (!isNaN(profitValue)) {
                        total += profitValue;
                    }
                }
            });

            document.querySelector('.total-amount .amount').textContent = formatCurrency(total);
        }

        function formatCurrency(amount) {
            return '₹ ' + amount.toLocaleString('en-IN', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function exportToExcel() {
            alert('Excel Export\n\nThis would generate and download an Excel file containing:\n- Stock Report Details\n- All item-wise transactions\n- Opening stock, closing stock, and profit/loss\n- For the selected date range');
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Stock Report Details page loaded');
            updateTotalAmount();
        });
    </script>
