@model List<PurchaseBill>

<div class="rpt-wrapper">
    <div class="rpt-container">

        <!-- Header -->
        <div class="rpt-header">
            <h2>Purchase Report</h2>
            <div class="rpt-header-actions">
                <button class="rpt-btn rpt-btn-outline"><i class="fas fa-upload"></i> Upload Bill</button>
                <button class="rpt-btn rpt-btn-primary" onclick="window.location.href='/Web/PurchaseBill/Create'"><i class="fas fa-plus"></i> Add Purchase</button>
            </div>
        </div>

        <!-- Filters -->
        <div class="rpt-filters">
            <div class="rpt-filter-group">
                <label>Filter By</label>
                <select id="filterBySelect">
                    <option value="">Custom</option>
                    <option value="thisMonth">This Month</option>
                    <option value="lastMonth">Last Month</option>
                    <option value="thisQuarter">This Quarter</option>
                    <option value="thisYear">This Year</option>
                </select>
            </div>
            <div class="rpt-filter-group">
                <label>Date Range</label>
                <div class="rpt-date-range">
                    <input type="date" id="startDate" value="@DateTime.Now.ToString("yyyy-MM-01")" />
                    <span>to</span>
                    <input type="date" id="endDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="rpt-filter-group">
                <label>Party</label>
                <select id="firmFilter">
                    <option value="">All Parties</option>
                    @if (ViewBag.PartyList != null) { foreach (var item in ViewBag.PartyList) { <option value="@item.id">@item.partyname</option> } }
                </select>
            </div>
            <div class="rpt-filter-group">
                <label>User</label>
                <select id="userFilter">
                    <option value="">All Users</option>
                    @if (ViewBag.UserList != null) { foreach (var item in ViewBag.UserList) { <option value="@item.Id">@item.Username</option> } }
                </select>
            </div>
            <div class="rpt-filter-group">
                <label>Godown</label>
                <select id="godownFilter">
                    <option value="">All</option>
                    @if (ViewBag.GodawonList != null) { foreach (var item in ViewBag.GodawonList) { <option value="@item.Id">@item.GodownName</option> } }
                </select>
            </div>
        </div>

        <!-- Summary -->
        @{
            decimal grandTotal = Model?.Sum(x => x.Total) ?? 0;
            decimal paidTotal = Model?.Where(x => x.orderstatusid == 1).Sum(x => x.Total) ?? 0;
            decimal unpaidTotal = grandTotal - paidTotal;
        }
        <div class="rpt-summary">
            <div class="rpt-summary-card green">
                <div class="rpt-summary-label">Paid</div>
                <p class="rpt-summary-value">? @paidTotal.ToString("N2")</p>
            </div>
            <div class="rpt-summary-card blue">
                <div class="rpt-summary-label">Unpaid</div>
                <p class="rpt-summary-value">? @unpaidTotal.ToString("N2")</p>
            </div>
            <div class="rpt-summary-card">
                <div class="rpt-summary-label">Total Purchase</div>
                <p class="rpt-summary-value">? @grandTotal.ToString("N2")</p>
                <div class="rpt-summary-footer">
                    <span>Invoices: <strong>@(Model?.Count ?? 0)</strong></span>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="rpt-table-section">
            <div class="rpt-table-header">
                <h4>Transactions</h4>
                <div class="rpt-table-actions">
                    <div class="rpt-search">
                        <input type="text" id="searchInput" placeholder="Search..." />
                        <i class="fas fa-search"></i>
                    </div>
                    <button class="rpt-btn-icon" title="Excel" onclick="exportTable()"><i class="fas fa-file-excel"></i></button>
                    <button class="rpt-btn-icon" title="Print" onclick="window.print()"><i class="fas fa-print"></i></button>
                </div>
            </div>

            <div id="searchResultsInfo" class="rpt-search-info" style="display:none;">
                <span>Found <strong id="resultsCount">0</strong> results</span>
                <button class="rpt-search-clear" onclick="clearSearch()">Clear</button>
            </div>

            <div class="rpt-table-wrap">
                <table class="rpt-table" id="transactionsTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Invoice No</th>
                            <th>Party Name</th>
                            <th>Payment Type</th>
                            <th class="amt">Amount</th>
                            <th class="amt">Balance</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        @if (Model != null && Model.Any())
                        {
                            int idx = 0;
                            foreach (var bill in Model)
                            {
                                idx++;
                                var sc = bill.orderstatusid == 1 ? "rpt-badge rpt-badge-paid" : bill.orderstatusid == 2 ? "rpt-badge rpt-badge-partial" : "rpt-badge rpt-badge-unpaid";
                                var st = bill.orderstatusid == 1 ? "Paid" : bill.orderstatusid == 2 ? "Partial" : "Unpaid";
                                <tr class="data-row" data-firm-id="@bill.PartyId" data-date="@(bill.InvoiceDate?.ToString("yyyy-MM-dd") ?? "")">
                                    <td>@idx</td>
                                    <td>@bill.CreatedDate.ToString("dd MMM yyyy")</td>
                                    <td><strong>@bill.InvoiceNumber</strong></td>
                                    <td>@bill.PartyName</td>
                                    <td>@bill.PaymentType</td>
                                    <td class="amt">? @bill.Total.ToString("N2")</td>
                                    <td class="amt">? @bill.FinalAmount.ToString("N2")</td>
                                    <td>@bill.DueDate.ToString("dd MMM yyyy")</td>
                                    <td><span class="@sc">@st</span></td>
                                    <td><button class="rpt-btn-icon" title="View" onclick="window.location.href='/Web/PurchaseBill/GetById?id=@(bill.Id)&typeid=1'"><i class="fas fa-eye"></i></button></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr class="no-data-row">
                                <td colspan="10">
                                    <div class="rpt-empty">
                                        <div class="rpt-empty-icon"><i class="fas fa-file-invoice"></i></div>
                                        <h5>No Purchase Bills</h5>
                                        <p>No purchase bills found for the selected period. Add your first purchase to get started.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<script>
(function() {
    const si = document.getElementById('searchInput'), tb = document.getElementById('tableBody');
    const sri = document.getElementById('searchResultsInfo'), rc = document.getElementById('resultsCount');
    const ff = document.getElementById('firmFilter'), sd = document.getElementById('startDate'), ed = document.getElementById('endDate');
    const fbs = document.getElementById('filterBySelect');
    const rows = Array.from(tb.querySelectorAll('tr.data-row'));

    [ff,sd,ed].forEach(e => { if(e) e.addEventListener('change', filter); });
    if(fbs) fbs.addEventListener('change', preset);
    if(si) si.addEventListener('keyup', filter);

    function preset(e) {
        const v=e.target.value, d=new Date(), y=d.getFullYear(), m=d.getMonth();
        if(v==='thisMonth'){set(new Date(y,m,1),new Date(y,m+1,0))}
        else if(v==='lastMonth'){set(new Date(y,m-1,1),new Date(y,m,0))}
        else if(v==='thisQuarter'){const q=Math.floor(m/3)*3;set(new Date(y,q,1),new Date(y,q+3,0))}
        else if(v==='thisYear'){set(new Date(y,0,1),new Date(y,11,31))}
        filter();
    }
    function set(s,e){sd.value=s.toISOString().split('T')[0];ed.value=e.toISOString().split('T')[0];}
    function filter(){
        const t=(si.value||'').toLowerCase().trim(), f=ff.value, s=new Date(sd.value), e=new Date(ed.value);
        let c=0;
        rows.forEach(r=>{
            const ok=(!f||r.dataset.firmId===f)&&(new Date(r.dataset.date)>=s&&new Date(r.dataset.date)<=e)&&(!t||r.innerText.toLowerCase().includes(t));
            r.classList.toggle('hidden',!ok); if(ok)c++;
        });
        sri.style.display=t?'flex':'none'; rc.innerText=c;
    }
    window.clearSearch=function(){si.value='';filter();si.focus();};
    window.exportTable=function(){
        let csv=[];document.querySelectorAll('#transactionsTable tr:not(.hidden):not(.no-data-row)').forEach(r=>{
            csv.push(Array.from(r.querySelectorAll('th,td')).map(c=>'"'+c.textContent.trim().replace(/"/g,'""')+'"').join(','));
        });
        const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv.join('\n')],{type:'text/csv'}));a.download='purchase_report.csv';a.click();
    };
})();
</script>
