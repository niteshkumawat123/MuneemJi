@model List<PurchaseBill>

<div class="rpt-wrapper">
    <div class="rpt-container">

        <!-- Header -->
        <div class="rpt-header">
            <h2>@(ViewBag.ReportTitle ?? "Sale Report")</h2>
            <div class="rpt-header-actions">
                <button class="rpt-btn rpt-btn-outline"><i class="fas fa-share-alt"></i> Share With CA</button>
                <button class="rpt-btn rpt-btn-primary" onclick="window.location.href='/Web/Sales/Create'"><i class="fas fa-plus"></i> Add Sales</button>
            </div>
        </div>

        <!-- Filters -->
        <div class="rpt-filters">
            <div class="rpt-filter-group">
                <label>Filter By</label>
                <select id="filterBySelect">
                    <option value="">Custom</option>
                    <option value="thisMonth">This Month</option>
                    <option value="lastMonth">Last Month</option>
                    <option value="thisQuarter">This Quarter</option>
                    <option value="thisYear">This Year</option>
                </select>
            </div>
            <div class="rpt-filter-group">
                <label>Date Range</label>
                <div class="rpt-date-range">
                    <input type="date" id="startDate" value="@DateTime.Now.ToString("yyyy-MM-01")" />
                    <span>to</span>
                    <input type="date" id="endDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="rpt-filter-group">
                <label>Party</label>
                <select id="firmFilter">
                    <option value="">All Parties</option>
                    @if (ViewBag.PartyList != null)
                    {
                        foreach (var item in ViewBag.PartyList)
                        {
                            <option value="@item.id">@item.partyname</option>
                        }
                    }
                </select>
            </div>
            <div class="rpt-filter-group">
                <label>User</label>
                <select id="userFilter">
                    <option value="">All Users</option>
                    @if (ViewBag.UserList != null)
                    {
                        foreach (var item in ViewBag.UserList)
                        {
                            <option value="@item.Id">@item.Username</option>
                        }
                    }
                </select>
            </div>
            <div class="rpt-filter-group">
                <label>Godown</label>
                <select id="godownFilter">
                    <option value="">All</option>
                    @if (ViewBag.GodawonList != null)
                    {
                        foreach (var item in ViewBag.GodawonList)
                        {
                            <option value="@item.Id">@item.GodownName</option>
                        }
                    }
                </select>
            </div>
        </div>

        <!-- Summary -->
        <div class="rpt-summary">
            <div class="rpt-summary-card">
                <div class="rpt-summary-label">Total Sales Amount</div>
                <p class="rpt-summary-value">? @(ViewBag.GrandTotal ?? "0.00")</p>
                <div class="rpt-summary-footer">
                    <span>Received: <strong>? @(ViewBag.PaidTotal ?? "0.00")</strong></span>
                    <span>Balance: <strong>? @(ViewBag.UnpaidTotal ?? "0.00")</strong></span>
                </div>
            </div>
            <div class="rpt-summary-card blue">
                <div class="rpt-summary-label">Total Invoices</div>
                <p class="rpt-summary-value">@(Model != null ? Model.Count : 0)</p>
            </div>
        </div>

        <!-- Table Section -->
        <div class="rpt-table-section">
            <div class="rpt-table-header">
                <h4>Transactions</h4>
                <div class="rpt-table-actions">
                    <div class="rpt-search">
                        <input type="text" id="searchInput" placeholder="Search transactions..." />
                        <i class="fas fa-search"></i>
                    </div>
                    <button class="rpt-btn-icon" title="Download Excel" onclick="exportTable()"><i class="fas fa-file-excel"></i></button>
                    <button class="rpt-btn-icon" title="Print" onclick="window.print()"><i class="fas fa-print"></i></button>
                </div>
            </div>

            <div id="searchResultsInfo" class="rpt-search-info" style="display:none;">
                <span>Found <strong id="resultsCount">0</strong> matching transactions</span>
                <button class="rpt-search-clear" onclick="clearSearch()">Clear</button>
            </div>

            <div class="rpt-table-wrap">
                <table class="rpt-table" id="transactionsTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Date <i class="fas fa-sort"></i></th>
                            <th>Invoice No <i class="fas fa-sort"></i></th>
                            <th>Party Name <i class="fas fa-sort"></i></th>
                            <th>Payment Type</th>
                            <th class="amt">Amount <i class="fas fa-sort"></i></th>
                            <th class="amt">Balance <i class="fas fa-sort"></i></th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        @if (Model != null && Model.Any())
                        {
                            int idx = 0;
                            foreach (var bill in Model)
                            {
                                idx++;
                                <tr class="data-row"
                                    data-firm-id="@bill.PartyId"
                                    data-date="@(bill.InvoiceDate?.ToString("yyyy-MM-dd") ?? "")">
                                    <td>@idx</td>
                                    <td>@bill.CreatedDate.ToString("dd MMM yyyy")</td>
                                    <td><strong>@bill.InvoiceNumber</strong></td>
                                    <td>@bill.PartyName</td>
                                    <td>@bill.PaymentType</td>
                                    <td class="amt">? @bill.Total</td>
                                    <td class="amt">? @bill.FinalAmount</td>
                                    <td>@bill.DueDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @{
                                            var statusClass = bill.orderstatusid switch
                                            {
                                                1 => "rpt-badge rpt-badge-paid",
                                                2 => "rpt-badge rpt-badge-partial",
                                                _ => "rpt-badge rpt-badge-unpaid"
                                            };
                                            var statusText = bill.orderstatusid switch
                                            {
                                                1 => "Paid",
                                                2 => "Partial",
                                                _ => "Unpaid"
                                            };
                                        }
                                        <span class="@statusClass">@statusText</span>
                                    </td>
                                    <td>
                                        <button class="rpt-btn-icon" title="View" onclick="window.location.href='/Web/Sales/GetById?id=@(bill.Id)&typeid=1'">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr class="no-data-row">
                                <td colspan="10">
                                    <div class="rpt-empty">
                                        <div class="rpt-empty-icon"><i class="fas fa-receipt"></i></div>
                                        <h5>No Sales Found</h5>
                                        <p>No sales invoices for the selected period. Create your first sale to get started.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<script>
(function() {
    const searchInput = document.getElementById('searchInput');
    const tableBody = document.getElementById('tableBody');
    const searchResultsInfo = document.getElementById('searchResultsInfo');
    const resultsCount = document.getElementById('resultsCount');
    const firmFilter = document.getElementById('firmFilter');
    const startDate = document.getElementById('startDate');
    const endDate = document.getElementById('endDate');
    const filterBySelect = document.getElementById('filterBySelect');
    const allRows = Array.from(tableBody.querySelectorAll('tr.data-row'));

    if (firmFilter) firmFilter.addEventListener('change', applyFilters);
    if (startDate) startDate.addEventListener('change', applyFilters);
    if (endDate) endDate.addEventListener('change', applyFilters);
    if (filterBySelect) filterBySelect.addEventListener('change', handlePresetFilter);
    if (searchInput) searchInput.addEventListener('keyup', applyFilters);

    function handlePresetFilter(e) {
        const v = e.target.value, today = new Date(), y = today.getFullYear(), m = today.getMonth();
        if (v === 'thisMonth') { setDates(new Date(y,m,1), new Date(y,m+1,0)); }
        else if (v === 'lastMonth') { setDates(new Date(y,m-1,1), new Date(y,m,0)); }
        else if (v === 'thisQuarter') { const q = Math.floor(m/3)*3; setDates(new Date(y,q,1), new Date(y,q+3,0)); }
        else if (v === 'thisYear') { setDates(new Date(y,0,1), new Date(y,11,31)); }
        applyFilters();
    }

    function setDates(s, e) {
        startDate.value = s.toISOString().split('T')[0];
        endDate.value = e.toISOString().split('T')[0];
    }

    function applyFilters() {
        const term = (searchInput.value || '').toLowerCase().trim();
        const firm = firmFilter.value;
        const s = new Date(startDate.value), e = new Date(endDate.value);
        let count = 0;

        allRows.forEach(row => {
            const fid = row.getAttribute('data-firm-id');
            const rd = new Date(row.getAttribute('data-date'));
            const txt = row.innerText.toLowerCase();
            const ok = (!firm || fid === firm) && (rd >= s && rd <= e) && (!term || txt.includes(term));
            row.classList.toggle('hidden', !ok);
            if (ok) { count++; if (term) highlightRow(row, term); else clearRow(row); }
        });

        searchResultsInfo.style.display = term ? 'flex' : 'none';
        resultsCount.innerText = count;
    }

    function highlightRow(row, term) {
        row.querySelectorAll('td').forEach(c => {
            const t = c.textContent;
            if (t.toLowerCase().includes(term)) {
                c.innerHTML = t.replace(new RegExp(`(${term})`,'gi'), '<mark>$1</mark>');
            }
        });
    }

    function clearRow(row) { row.querySelectorAll('td mark').forEach(m => m.replaceWith(m.textContent)); }

    window.clearSearch = function() { searchInput.value = ''; applyFilters(); searchInput.focus(); };

    window.exportTable = function() {
        let csv = [];
        document.querySelectorAll('#transactionsTable tr:not(.hidden):not(.no-data-row)').forEach(r => {
            const cols = Array.from(r.querySelectorAll('th,td')).map(c => '"' + c.textContent.trim().replace(/"/g,'""') + '"');
            csv.push(cols.join(','));
        });
        const blob = new Blob([csv.join('\n')], {type:'text/csv'});
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'sale_report.csv';
        a.click();
    };
})();
</script>
