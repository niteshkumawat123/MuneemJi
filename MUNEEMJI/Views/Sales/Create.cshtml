@model PurchaseBillViewModel

@{
    ViewData["Title"] = "Create Bill";
}
@{
    // Layout = "~/Views/Shared/_Layout.cshtml"; // or your layout
    Layout = null;
}
@{
    string formAction = Model.ViewTypeId == (int)ViewTypeEnum.Edit ? "UpdateEntries" : "Create";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
