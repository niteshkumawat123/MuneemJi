    <script>

         var itemOptions = @Html.Raw(Json.Serialize(Model.DropDownItem));
         let itemIndex = @Model.Bill.BillItems.Count;

         let itemDropdown = `<select name="Bill.BillItems[${itemIndex}].ItemId" class="form-control-sm">`;
        itemDropdown += `<option value="">-- Select Item --</option>`;
        itemOptions.forEach(item => {
            itemDropdown += `<option value="${item.id}">${item.itemName}</option>`;
        });
        itemDropdown += `</select>`;

         function onItemChange(selectElem, rowIndex) {
            let selectedItemId = selectElem.value;
            console.log("Row " + rowIndex + " selected item ID: " + selectedItemId);
            // 
            // Do something like auto-fill price, etc.
        }

             var itemSettings = {
            serialNoTracking: @Html.Raw(Json.Serialize(Model.Bill.itemSettings?.SerialNoTracking ?? false)),
            description: @Html.Raw(Json.Serialize(Model.Bill.itemSettings?.Description ?? false)),
            expDateEnabled: @Html.Raw(Json.Serialize(Model.Bill.itemSettings?.ExpDateEnabled ?? false)),
            mfgDateEnabled: @Html.Raw(Json.Serialize(Model.Bill.itemSettings?.MfgDateEnabled ?? false)),
            itemWiseDiscount: @Html.Raw(Json.Serialize(Model.Bill.itemSettings?.ItemWiseDiscount ?? false)),
            itemWiseTax: @Html.Raw(Json.Serialize(Model.Bill.itemSettings?.ItemWiseTax ?? false)),
            itemcode: @Html.Raw(Json.Serialize(Model.Bill.itemSettings?.ItemCode ?? false)),
            hsnsaccode: @Html.Raw(Json.Serialize(Model.Bill.itemSettings?.HsnSacCode ?? false)),
            category: @Html.Raw(Json.Serialize(Model.Bill.itemSettings?.HsnSacCode ?? false))

        };

        var transactionSettings = {
            freeItemQuantity: @Html.Raw(Json.Serialize(Model.Bill.transactionSettings?.FreeItemQuantity ?? false))
        };

                    function addNewRow() {
            const tbody = document.getElementById('itemsTableBody');
            const newRow = document.createElement('tr');
            newRow.className = 'item-row';
            newRow.setAttribute('data-index', itemIndex);

            let rowHTML = `<td class="col-sr-no">${itemIndex + 1}</td>`
            if(itemSettings.category)
            {
              rowHTML += `<td class="col-category">${itemDropdown.replace('ITEMINDEX', itemIndex).replace('ItemId', 'CategoryId')}</td>`;
            }
               rowHTML += `<td class="col-item">${itemDropdown.replace('ITEMINDEX', itemIndex)}</td>`;
            if(itemSettings.itemcode)
            {
                rowHTML += `<td class="col-item-code"><input name="Bill.BillItems[${itemIndex}].ItemCode" type="text" class="form-control-sm" placeholder="Item Code" /></td>`;
            }
            if(itemSettings.hsnsaccode)
            {
              rowHTML += `<td class="col-hsn"><input name="Bill.BillItems[${itemIndex}].HSNCode" type="text" class="form-control-sm" placeholder="HSN Code" /></td>`;
            }

            // Conditional fields
            if (itemSettings.serialNoTracking) {
                rowHTML += `<td class="col-serial"><input name="Bill.BillItems[${itemIndex}].SerialNumber" type="text" class="form-control-sm" placeholder="Serial No." /></td>`;
            }

            if (itemSettings.description) {
                rowHTML += `<td class="col-description"><input name="Bill.BillItems[${itemIndex}].Description" type="text" class="form-control-sm" placeholder="Description" /></td>`;
            }

            rowHTML += `
                <td class="col-count"><input name="Bill.BillItems[${itemIndex}].Count" type="number" class="form-control-sm" placeholder="Count" /></td>
                <td class="col-batch"><input name="Bill.BillItems[${itemIndex}].BatchNumber" type="text" class="form-control-sm" placeholder="Batch No." /></td>
                <td class="col-model"><input name="Bill.BillItems[${itemIndex}].ModelNumber" type="text" class="form-control-sm" placeholder="Model No." /></td>`;

            if (itemSettings.expDateEnabled) {
                rowHTML += `<td class="col-exp-date"><input name="Bill.BillItems[${itemIndex}].ExpiryDate" type="date" class="form-control-sm" /></td>`;
            }

            if (itemSettings.mfgDateEnabled) {
                rowHTML += `<td class="col-mfg-date"><input name="Bill.BillItems[${itemIndex}].ManufacturingDate" type="date" class="form-control-sm" /></td>`;
            }

            rowHTML += `
                <td class="col-mrp"><input name="Bill.BillItems[${itemIndex}].MRP" type="number" step="0.01" class="form-control-sm" placeholder="MRP" /></td>
                <td class="col-size"><input name="Bill.BillItems[${itemIndex}].Size" type="text" class="form-control-sm" placeholder="Size" /></td>
                <td class="col-qty"><input name="Bill.BillItems[${itemIndex}].Quantity" type="number" step="0.01" class="form-control-sm qty-input" onchange="calculateItemAmount(${itemIndex})" /></td>`;

            if (transactionSettings.freeItemQuantity) {
                rowHTML += `<td class="col-free-qty"><input name="Bill.BillItems[${itemIndex}].FreeQuantity" type="number" step="0.01" class="form-control-sm" placeholder="Free Qty" /></td>`;
            }

            // Unit dropdown
            let unitDropdown = `<select name="Bill.BillItems[${itemIndex}].Unit" class="form-control-sm">`;
            unitOptions.forEach(unit => {
                unitDropdown += `<option value="${unit}">${unit}</option>`;
            });
            unitDropdown += `</select>`;

            rowHTML += `<td class="col-unit">${unitDropdown}</td>`;
            rowHTML += `<td class="col-price"><input name="Bill.BillItems[${itemIndex}].PricePerUnit" type="number" step="0.01" class="form-control-sm price-input" onchange="calculateItemAmount(${itemIndex})" /></td>`;

            if (itemSettings.itemWiseDiscount) {
                rowHTML += `<td class="col-discount-pct"><input name="Bill.BillItems[${itemIndex}].DiscountPercentage" type="number" step="0.01" class="form-control-sm discount-input" onchange="calculateItemAmount(${itemIndex})" /></td>`;
            }

            rowHTML += `<td class="col-amount1"><input name="Bill.BillItems[${itemIndex}].DiscountAmount" type="number" step="0.01" class="form-control-sm discount-amount" readonly /></td>`;

            if (itemSettings.itemWiseTax) {
                let taxDropdown = `<select name="Bill.BillItems[${itemIndex}].Tax" class="form-control-sm tax-select" onchange="calculateItemAmount(${itemIndex})">`;
                taxOptions.forEach(tax => {
                    taxDropdown += `<option value="${tax}">${tax}</option>`;
                });
                taxDropdown += `</select>`;

                rowHTML += `<td class="col-tax">${taxDropdown}</td>`;
            }

            rowHTML += `
                <td class="col-amount2"><input name="Bill.BillItems[${itemIndex}].TaxAmount" type="number" step="0.01" class="form-control-sm tax-amount" readonly /></td>
                <td class="col-action"><button type="button" class="btn btn-sm btn-danger" onclick="removeRow(${itemIndex})">×</button></td>`;

            newRow.innerHTML = rowHTML;
            tbody.appendChild(newRow);
            itemIndex++;
        }




        function removeRow(index) {
            const row = document.querySelector(`tr[data-index="${index}"]`);
            if (row) {
                row.remove();
                updateGrandTotal();
            }
        }

        function calculateItemAmount(index) {
            const row = document.querySelector(`tr[data-index="${index}"]`);
            if (!row) return;

            const quantity = parseFloat(row.querySelector('.qty-input').value) || 0;
            const pricePerUnit = parseFloat(row.querySelector('.price-input').value) || 0;
            const discountPercentage = parseFloat(row.querySelector('.discount-input').value) || 0;
            const taxSelect = row.querySelector('.tax-select').value;

            const subtotal = quantity * pricePerUnit;
            const discountAmount = subtotal * (discountPercentage / 100);
            const afterDiscount = subtotal - discountAmount;

            let taxRate = 0;
            if (taxSelect && taxSelect !== 'Select') {
                taxRate = parseFloat(taxSelect.replace('%', '')) || 0;
            }

            const taxAmount = afterDiscount * (taxRate / 100);
            const finalAmount = afterDiscount + taxAmount;

            row.querySelector('.discount-amount').value = discountAmount.toFixed(2);
            row.querySelector('.tax-amount').value = taxAmount.toFixed(2);
            row.querySelector('.item-amount').value = finalAmount.toFixed(2);

            updateGrandTotal();
        }

        function updateGrandTotal() {
            let total = 0;
            document.querySelectorAll('.item-amount').forEach(input => {
                total += parseFloat(input.value) || 0;
            });

            document.getElementById('grandTotal').textContent = total.toFixed(2);

            const roundOff = document.querySelector('input[name="Bill.RoundOff"]').checked;
            let finalTotal = roundOff ? Math.round(total) : total;
            let roundOffAmount = finalTotal - total;

            document.getElementById('roundOffAmount').textContent = roundOffAmount.toFixed(2);
            document.getElementById('finalTotal').textContent = finalTotal.toFixed(2);
        }

        // Initialize calculations on page load
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.item-row').forEach((row, index) => {
                calculateItemAmount(index);
            });
        });

        // Handle round off checkbox change
        document.querySelector('input[name="Bill.RoundOff"]').addEventListener('change', updateGrandTotal);
    </script>
    <script>
        // Toggle between Credit and Cash
                document.getElementById('paymentToggle').addEventListener('click', function() {
                    const toggle = this;
                    const modeText = document.getElementById('paymentMode');
                    const receivedSection = document.getElementById('receivedCheckbox');
                    const balanceSection = document.getElementById('balanceSection');
                    const partyBalance = document.getElementById('partyBalance');

                    toggle.classList.toggle('cash');

                    if (toggle.classList.contains('cash')) {
                        modeText.textContent = 'Cash';
                        receivedSection.style.display = 'none';
                        balanceSection.style.display = 'none';
                        partyBalance.style.display = 'block';
                    } else {
                        modeText.textContent = 'Credit';
                        receivedSection.style.display = 'flex';
                        balanceSection.style.display = 'flex';
                        partyBalance.style.display = 'none';
                    }
                });



                        function showColumnSettings() {
            const dropdown = document.getElementById('columnSettings');
            const button = document.querySelector('th.col-action .column-toggle-btn'); // Changed this line
            dropdown.classList.toggle('show');
            if (dropdown.classList.contains('show')) {
                const buttonRect = button.getBoundingClientRect();
                dropdown.style.position = 'absolute';
                dropdown.style.top = (buttonRect.bottom + 5) + 'px';
                dropdown.style.left = (buttonRect.right - 200) + 'px';
            }
        }


               function closeView() {
                       window.location.href = '/Web/Home/Index'; // Or your desired controller/action
               }

        function toggleColumn(columnClass) {
            const columns = document.querySelectorAll('.' + columnClass);
            const checkbox = event.target;

            columns.forEach(column => {
                if (checkbox.checked) {
                    column.classList.remove('hidden-column');
                } else {
                    column.classList.add('hidden-column');
                }
            });
        }


                document.addEventListener('click', function(event) {
            const button = document.querySelector('th.col-action .column-toggle-btn');
            const dropdown = document.getElementById('columnSettings');

            if (!button.contains(event.target) && !dropdown.contains(event.target)) {
                dropdown.classList.remove('show');
            }
        });
    </script>

    <script>

        document.addEventListener('DOMContentLoaded', function() {
            initializePopover();
        });

                       function initializePopover() {
            const columnToggleBtn = document.getElementById('columnToggleBtn');
            const columnSettingsContent = document.getElementById('columnSettingsContent');

            if (columnToggleBtn && columnSettingsContent) {
                // Create popover instance
                const popover = new bootstrap.Popover(columnToggleBtn, {
                    content: function() {
                        return columnSettingsContent.innerHTML;
                    },
                    html: true,
                    placement: 'bottom',
                    trigger: 'click',
                    title: 'Column Settings',
                    sanitize: false
                });

                // Handle checkbox changes in popover content
                columnToggleBtn.addEventListener('shown.bs.popover', function() {
                    const popoverElement = document.querySelector('.popover');
                    if (popoverElement) {
                        const checkboxes = popoverElement.querySelectorAll('input[type="checkbox"]');
                        checkboxes.forEach(checkbox => {
                            checkbox.addEventListener('change', function() {
                                // Extract column class from onchange attribute
                                const onchangeAttr = this.getAttribute('onchange');
                                const match = onchangeAttr.match(/'([^']+)'/);
                                if (match) {
                                    const columnClass = match[1];
                                    toggleColumnFromPopover(columnClass, this.checked);
                                }
                            });
                        });
                    }
                });

                // Handle clicks outside to close popover
                document.addEventListener('click', function(event) {
                    if (!columnToggleBtn.contains(event.target) && !event.target.closest('.popover')) {
                        popover.hide();
                    }
                });
            }
        }

                // Define the toggleColumn function
        function toggleColumn(columnClass, isChecked) {
            const columns = document.querySelectorAll('.' + columnClass);

            columns.forEach(column => {
                if (isChecked) {
                    column.classList.remove('hidden-column');
                } else {
                    column.classList.add('hidden-column');
                }
            });
        }


    </script>
