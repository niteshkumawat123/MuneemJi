        }

        .more-settings i {
        margin-right: 4px;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <form asp-action="@formAction" method="post" enctype="multipart/form-data" id="billForm">
            <div class="form-container">
                <input type="hidden" name="Bill.Id" value=@Model.Bill.Id>

                <div class="header-top">
                    <div class="sale-toggle">
                        <span style="font-size: 21px">Sale</span>
                        <div class="toggle-switch" id="paymentToggle">
                            <div class="toggle-slider"></div>
                        </div>
                        <span id="paymentMode">Credit</span>
                    </div>
                    <div class="text-end w-100">
                        <button class="btn btn-primary" style="background-color:#89bcf3" onclick="window.open('https://www.google.com/search?q=calculator', '_blank')">
                            <i class="bi bi-calculator"></i> Calculator
                        </button>
                        <button type="button" class="btn-close" style="background-color:#89bcf3;border: 2px solid #2c7be5;border-radius: 15%;
                                        height:10px;padding-bottom: 13px;padding-top: 11px;padding-left: 6px;
                                        padding-right: 6px;" aria-label="Close" onclick="closeView()">
                        </button>
                        <button type="button" class="bi bi-gear" onclick="window.location.href='/Settings/Transaction/Index'"
                        style=" font-size: 20px; color: #6c757d; background-color:#89bcf3;border: 2px solid #89bcf3;border-radius: 15%;
                                        padding-bottom:7px;padding-top:0px;padding-left:6px;
                                        padding-right:6px;">
                        </button>
                    </div>
                </div>

                <!-- Search Section -->
