                    <div class="row">
                        <div class="col-md-2">
                            <div class="floating-label-container">
                                <select class="floating-select" id="partyDropdown" name="Bill.PartyId">
                                    <option value="">Select</option>
                                    @if (ViewBag.PartyList != null)
                                    {
                                        <!-- Header Option (disabled and styled) -->
                                        <option disabled class="dropdown-header">
                                            <span class="header-item">Party Name</span>
                                            <span class="header-item">Mobile Number</span>
                                            <span class="header-item">Balance</span>
                                        </option>

                                        @foreach (var party in ViewBag.PartyList)
                                        {
                                            @if (Model.Bill.PartyId == party.id)
                                            {
                                                <option value="@party.id"
                                                data-phone="@party.phonenumber"
                                                data-balance="@party.balance"
                                                class="party-option"
                                                selected="selected">
                                                    <span class="party-name">@party.partyname</span>
                                                    <span class="party-phone">@party.phonenumber</span>
                                                    <span class="party-balance">@party.balance</span>
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@party.id"
                                                data-phone="@party.phonenumber"
                                                data-balance="@party.balance"
                                                class="party-option">
                                                    <span class="party-name">@party.partyname</span>
                                                    <span class="party-phone">@party.phonenumber</span>
                                                    <span class="party-balance">@party.balance</span>
                                                </option>
                                            }
                                        }
                                    }
                                </select>
                                <label class="floating-label">Search by Name/Phone</label>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="floating-label-container">
                                <input asp-for="Bill.PhoneNo" class="floating-input" placeholder=" " />
                                <label class="floating-label">Billing Name</label>
                            </div>
                        </div>

                        <div class="col-md-2" style="margin-left: 120px">
                            <div class="floating-label-container">
                                <input asp-for="Bill.PhoneNo" class="floating-input" placeholder=" " />
                                <label class="floating-label">Phone No.</label>
                            </div>
                        </div>

                        @if (Model.Bill.transactionSettings != null && Model.Bill.transactionSettings.EwayBillNo == true)
