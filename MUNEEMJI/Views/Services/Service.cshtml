                <td>${item.itemName || ''}</td>
                <td style="text-align:right;">&#8377; ${(item.salePrice || 0).toFixed(2)}</td>
            </tr>
        `).join('');

        bindServiceBulkActiveCheckboxes();
    }

    function bindServiceBulkActiveCheckboxes() {
        const selectAll = document.getElementById('serviceBulkActiveSelectAll');
        const checkboxes = document.querySelectorAll('.service-bulk-active-checkbox');
        const submitBtn = document.getElementById('serviceBulkActiveSubmitBtn');

        selectAll.checked = false;

        selectAll.addEventListener('change', function () {
            const visibleRows = document.querySelectorAll('#serviceBulkActiveTableBody tr:not([style*="display: none"]) .service-bulk-active-checkbox');
            visibleRows.forEach(cb => cb.checked = this.checked);
            updateServiceBulkActiveSubmitBtn();
        });

        checkboxes.forEach(cb => {
            cb.addEventListener('change', function () {
                updateServiceBulkActiveSubmitBtn();
                const visibleCheckboxes = document.querySelectorAll('#serviceBulkActiveTableBody tr:not([style*="display: none"]) .service-bulk-active-checkbox');
                const allChecked = Array.from(visibleCheckboxes).every(c => c.checked);
                selectAll.checked = allChecked && visibleCheckboxes.length > 0;
            });
        });
    }

    function updateServiceBulkActiveSubmitBtn() {
        const checked = document.querySelectorAll('.service-bulk-active-checkbox:checked');
        const submitBtn = document.getElementById('serviceBulkActiveSubmitBtn');
        submitBtn.disabled = checked.length === 0;
    }

    function submitServiceBulkActive() {
        const checked = document.querySelectorAll('.service-bulk-active-checkbox:checked');
        const itemIds = Array.from(checked).map(cb => parseInt(cb.value));

        if (itemIds.length === 0) return;

        const submitBtn = document.getElementById('serviceBulkActiveSubmitBtn');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Processing...';

        fetch('/Web/Services/BulkMarkActive', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({ itemIds: itemIds })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                closeServiceBulkActiveModal();
                toastr.success(data.message || 'Services marked as active successfully!');
                setTimeout(function() { window.location.reload(); }, 1500);
            } else {
                toastr.error(data.message || 'Failed to mark services as active.');
                submitBtn.disabled = false;
                submitBtn.textContent = 'Mark as Active';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            toastr.error('An error occurred. Please try again.');
            submitBtn.disabled = false;
            submitBtn.textContent = 'Mark as Active';
        });
    }

    // Search within Bulk Active modal
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('serviceBulkActiveSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const term = this.value.toLowerCase();
                const rows = document.querySelectorAll('#serviceBulkActiveTableBody tr');
                rows.forEach(row => {
                    const name = row.getAttribute('data-item-name') || '';
                    row.style.display = name.includes(term) || term === '' ? '' : 'none';
                });
            });
        }
    });
</script>

