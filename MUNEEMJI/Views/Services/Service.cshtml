            </div>
        </div>
    </div>
</div>

<script>
    // Bulk Inactive functionality for Services
    function openServiceBulkInactiveModal() {
        const overlay = document.getElementById('serviceBulkInactiveOverlay');
        overlay.classList.add('show');
        loadActiveServicesForBulkInactive();
    }

    function closeServiceBulkInactiveModal() {
        const overlay = document.getElementById('serviceBulkInactiveOverlay');
        overlay.classList.remove('show');
        document.getElementById('serviceBulkInactiveSearch').value = '';
    }

    function loadActiveServicesForBulkInactive() {
        const tbody = document.getElementById('serviceBulkInactiveTableBody');
        tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:30px; color:#999;">Loading...</td></tr>';

        fetch('/Web/Services/GetActiveServices', {
            method: 'GET',
            headers: { 'Accept': 'application/json' }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success && data.items) {
                renderServiceBulkInactiveItems(data.items);
            } else {
                tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:30px; color:#dc3545;">Failed to load services</td></tr>';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:30px; color:#dc3545;">Error loading services</td></tr>';
        });
    }

    function renderServiceBulkInactiveItems(items) {
        const tbody = document.getElementById('serviceBulkInactiveTableBody');

        if (!items || items.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:30px; color:#999;">No active services found</td></tr>';
            return;
        }

        tbody.innerHTML = items.map(item => `
            <tr data-item-id="${item.id}" data-item-name="${(item.itemName || '').toLowerCase()}">
                <td><input type="checkbox" class="service-bulk-inactive-checkbox" value="${item.id}"></td>
                <td>${item.itemName || ''}</td>
                <td>&#8377; ${(item.salePrice || 0).toFixed(2)}</td>
            </tr>
        `).join('');

        bindServiceBulkInactiveCheckboxes();
    }

    function bindServiceBulkInactiveCheckboxes() {
        const selectAll = document.getElementById('serviceBulkInactiveSelectAll');
        const checkboxes = document.querySelectorAll('.service-bulk-inactive-checkbox');
        const submitBtn = document.getElementById('serviceBulkInactiveSubmitBtn');

        selectAll.checked = false;

        selectAll.addEventListener('change', function () {
            const visibleRows = document.querySelectorAll('#serviceBulkInactiveTableBody tr:not([style*="display: none"]) .service-bulk-inactive-checkbox');
            visibleRows.forEach(cb => cb.checked = this.checked);
            updateServiceBulkInactiveSubmitBtn();
        });

        checkboxes.forEach(cb => {
            cb.addEventListener('change', function () {
                updateServiceBulkInactiveSubmitBtn();
                const visibleCheckboxes = document.querySelectorAll('#serviceBulkInactiveTableBody tr:not([style*="display: none"]) .service-bulk-inactive-checkbox');
                const allChecked = Array.from(visibleCheckboxes).every(c => c.checked);
                selectAll.checked = allChecked && visibleCheckboxes.length > 0;
            });
        });
    }

    function updateServiceBulkInactiveSubmitBtn() {
        const checked = document.querySelectorAll('.service-bulk-inactive-checkbox:checked');
        const submitBtn = document.getElementById('serviceBulkInactiveSubmitBtn');
        submitBtn.disabled = checked.length === 0;
    }

    function submitServiceBulkInactive() {
        const checked = document.querySelectorAll('.service-bulk-inactive-checkbox:checked');
        const itemIds = Array.from(checked).map(cb => parseInt(cb.value));

        if (itemIds.length === 0) return;

        const submitBtn = document.getElementById('serviceBulkInactiveSubmitBtn');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Processing...';

        fetch('/Web/Services/BulkMarkInactive', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({ itemIds: itemIds })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                closeServiceBulkInactiveModal();
                toastr.success(data.message || 'Services marked as inactive successfully!');
                setTimeout(function() { window.location.reload(); }, 1500);
            } else {
                toastr.error(data.message || 'Failed to mark services as inactive.');
                submitBtn.disabled = false;
                submitBtn.textContent = 'Mark as Inactive';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            toastr.error('An error occurred. Please try again.');
            submitBtn.disabled = false;
            submitBtn.textContent = 'Mark as Inactive';
        });
    }

    // Search within Bulk Inactive modal
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('serviceBulkInactiveSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const term = this.value.toLowerCase();
                const rows = document.querySelectorAll('#serviceBulkInactiveTableBody tr');
                rows.forEach(row => {
                    const name = row.getAttribute('data-item-name') || '';
                    row.style.display = name.includes(term) || term === '' ? '' : 'none';
                });
            });
        }
    });
</script>

