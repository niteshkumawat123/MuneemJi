<script>
    // Assign Units functionality for Services
    let serviceAssignUnitsSelectedItemIds = [];

    function openServiceAssignUnitsModal() {
        const overlay = document.getElementById('serviceAssignUnitsOverlay');
        overlay.classList.add('show');
        loadServicesWithoutUnit();
    }

    function closeServiceAssignUnitsModal() {
        const overlay = document.getElementById('serviceAssignUnitsOverlay');
        overlay.classList.remove('show');
        document.getElementById('serviceAssignUnitsSearch').value = '';
    }

    function closeServiceSelectUnitModal() {
        const overlay = document.getElementById('serviceSelectUnitOverlay');
        overlay.classList.remove('show');
    }

    function loadServicesWithoutUnit() {
        const tbody = document.getElementById('serviceAssignUnitsTableBody');
        tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:30px; color:#999;">Loading...</td></tr>';

        fetch('/Web/Services/GetServicesWithoutUnit', {
            method: 'GET',
            headers: { 'Accept': 'application/json' }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success && data.items) {
                renderServiceAssignUnitsItems(data.items);
            } else {
                tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:30px; color:#dc3545;">Failed to load services</td></tr>';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:30px; color:#dc3545;">Error loading services</td></tr>';
        });
    }

    function renderServiceAssignUnitsItems(items) {
        const tbody = document.getElementById('serviceAssignUnitsTableBody');

        if (!items || items.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:30px; color:#999;">No services without unit found</td></tr>';
            return;
        }

        tbody.innerHTML = items.map(item => `
            <tr data-item-id="${item.id}" data-item-name="${(item.itemName || '').toLowerCase()}">
                <td><input type="checkbox" class="service-assign-units-checkbox" value="${item.id}"></td>
                <td>${item.itemName || ''}</td>
                <td style="text-align:right;">&#8377; ${(item.salePrice || 0).toFixed(2)}</td>
            </tr>
        `).join('');

        bindServiceAssignUnitsCheckboxes();
    }

    function bindServiceAssignUnitsCheckboxes() {
        const selectAll = document.getElementById('serviceAssignUnitsSelectAll');
        const checkboxes = document.querySelectorAll('.service-assign-units-checkbox');
        const nextBtn = document.getElementById('serviceAssignUnitsNextBtn');

        selectAll.checked = false;

        selectAll.addEventListener('change', function () {
            const visibleRows = document.querySelectorAll('#serviceAssignUnitsTableBody tr:not([style*="display: none"]) .service-assign-units-checkbox');
            visibleRows.forEach(cb => cb.checked = this.checked);
            updateServiceAssignUnitsNextBtn();
        });

        checkboxes.forEach(cb => {
            cb.addEventListener('change', function () {
                updateServiceAssignUnitsNextBtn();
                const visibleCheckboxes = document.querySelectorAll('#serviceAssignUnitsTableBody tr:not([style*="display: none"]) .service-assign-units-checkbox');
                const allChecked = Array.from(visibleCheckboxes).every(c => c.checked);
                selectAll.checked = allChecked && visibleCheckboxes.length > 0;
            });
        });
    }

    function updateServiceAssignUnitsNextBtn() {
        const checked = document.querySelectorAll('.service-assign-units-checkbox:checked');
        const nextBtn = document.getElementById('serviceAssignUnitsNextBtn');
        nextBtn.disabled = checked.length === 0;
    }

    function showServiceAssignUnitsStep2() {
        const checked = document.querySelectorAll('.service-assign-units-checkbox:checked');
        serviceAssignUnitsSelectedItemIds = Array.from(checked).map(cb => parseInt(cb.value));

        if (serviceAssignUnitsSelectedItemIds.length === 0) return;

        closeServiceAssignUnitsModal();
        document.getElementById('serviceSelectUnitOverlay').classList.add('show');

        loadServiceUnitsFromMaster();
    }

    function loadServiceUnitsFromMaster() {
        fetch('/Web/Services/GetUnitsFromMaster', {
            method: 'GET',
            headers: { 'Accept': 'application/json' }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success && data.units) {
                const baseSelect = document.getElementById('serviceBaseUnitSelect');
                const secondarySelect = document.getElementById('serviceSecondaryUnitSelect');

                baseSelect.innerHTML = '<option value="">None</option>';
                secondarySelect.innerHTML = '<option value="">None</option>';

                data.units.forEach(unit => {
                    const label = unit.fullName + (unit.shortName ? ' (' + unit.shortName + ')' : '');
                    baseSelect.innerHTML += `<option value="${unit.fullName}">${label}</option>`;
                    secondarySelect.innerHTML += `<option value="${unit.fullName}">${label}</option>`;
                });
            }
        })
        .catch(error => {
            console.error('Error loading units:', error);
        });
    }

    function submitServiceBulkAssignUnit() {
        const baseUnit = document.getElementById('serviceBaseUnitSelect').value;
        const secondaryUnit = document.getElementById('serviceSecondaryUnitSelect').value;

        if (!baseUnit) {
            toastr.error('Please select a base unit.');
            return;
        }

        const saveBtn = document.getElementById('serviceAssignUnitSaveBtn');
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';

        fetch('/Web/Services/BulkAssignUnit', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({
                itemIds: serviceAssignUnitsSelectedItemIds,
                baseUnit: baseUnit,
                secondaryUnit: secondaryUnit
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                closeServiceSelectUnitModal();
                toastr.success(data.message || 'Units assigned successfully!');
                setTimeout(function() { window.location.reload(); }, 1500);
            } else {
                toastr.error(data.message || 'Failed to assign units.');
                saveBtn.disabled = false;
                saveBtn.textContent = 'SAVE';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            toastr.error('An error occurred. Please try again.');
            saveBtn.disabled = false;
            saveBtn.textContent = 'SAVE';
        });
    }

    // Search within Assign Units modal
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('serviceAssignUnitsSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const term = this.value.toLowerCase();
                const rows = document.querySelectorAll('#serviceAssignUnitsTableBody tr');
                rows.forEach(row => {
                    const name = row.getAttribute('data-item-name') || '';
                    row.style.display = name.includes(term) || term === '' ? '' : 'none';
                });
            });
        }
    });
</script>
